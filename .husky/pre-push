# 밀면 그대로 production 이 된다 (Vercel — TRD D-12: 배포가 git push 한 번).
#
# 여기 걸린 셋은 **공유 DB(D-31)를 읽는다.** 관문(vitest)이 아니라 여기인 까닭은
# 같다 — 관문은 망 없이 돌아야 하고, 공유 DB 는 **코드보다 먼저 바뀌므로** 「미는 그
# 커밋」이 아니라 **지금 DB** 를 물어야 뜻이 있다.
#
# ⚠️ 셋 다 **main 을 밀 때만** 본다. 브랜치 푸시까지 막으면 이 결함을 고치는 브랜치를
#    미는 것도 막힌다 — 늘 우는 가드는 꺼진다(2026-08-20).
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # 브랜치 삭제는 건너뛴다

  # ── ⑴ 그림 파일 ────────────────────────────────────────────────────────
  # 공유 DB 는 즉시 최신인데 **그림 파일은 밀어야 간다.** 그래서 문항을 이관하거나
  # 그림을 회수하면, 코드를 한 줄도 안 고쳐도 production 의 그림 자리가 빈다.
  # 500 도 안 나고 로그도 안 남는다 — 2026-08-20 에 원장님이 화면에서 찾아 주실
  # 때까지 90문항이 그렇게 있었다.
  # 그래서 «미는 그 커밋» 이 DB 가 가리키는 그림을 다 갖고 있는지 본다.
  echo "▸ 미는 커밋에 그림이 다 있는지 확인 ($local_sha)"
  if ! npx tsx scripts/qa/checkDeployedFigures.ts --ref "$local_sha"; then
    echo ""
    echo "🔴 이대로 밀면 production 에서 그림 자리가 빈다."
    echo "   빠진 그림을 커밋해서 같이 밀거나, 왜 없는지 확인하라(문서 16 그림 회수 원장)."
    exit 1
  fi

  # ── ⑵ 적재본의 죽은 역슬래시 ──────────────────────────────────────────
  # 엔진을 고쳐도 **이미 적재된 행은 안 고쳐진다.** 2026-08-27 에 그 틈이 벌어졌다 —
  # 14:0x 에 중등 3,327문항을 적재하고 15:55~17:38 에 엔진을 고쳤다. 엔진 판정기는
  # 0자리인데 지면에는 `angle C=90^circ` 가 16문항 나가고 있었고, 원장님이 화면에서
  # 찾아 주실 때까지 **아무 지표도 안 울었다**(tsc·vitest·KaTeX 가 전부 초록이다).
  echo "▸ 적재본에 죽은 역슬래시가 있는지 확인"
  if ! npm run --silent check:raw-latex; then
    echo ""
    echo "🔴 적재본에 죽은 역슬래시가 있다 — 지면에 날 글자가 나간다."
    echo "   엔진 소스를 고친 **뒤 그 유형을 다시 적재**해야 한다."
    echo "   (엔진만 고치면 적재본은 그대로다 — 그게 이 검사가 태어난 까닭이다.)"
    exit 1
  fi

  # ── ⑶ 엔진에 있는데 지면에 안 나가는 유형 ─────────────────────────────
  # 유형을 엔진에 더하고 시험까지 초록으로 만들어도, **적재를 안 하면 시험지에
  # 한 줄도 안 나간다.** 에러도 경고도 없다 — 그냥 그 유형이 안 뽑힌다.
  # 2026-08-31 중3 조사가 실물로 짚었다: 등록 1,376 중 22개가 적재본에 한 조각도
  # 없고, **결합형 6개는 `registeredTypes()` 에조차 없어** 적재기가 구조적으로
  # 못 부른다 — 원장님이 승인하신 문형이 엔진에만 산다.
  #
  # ⚠️ **«늘어나면» 빨강이다.** 지금 28자리를 그대로 막으면 고치는 브랜치를 미는
  #    것까지 막혀 훅을 우회하게 된다(2026-08-20 「늘 우는 가드는 꺼진다」).
  #    원장은 **면제부가 아니라 빚이다** — 줄면 `--write` 로 조인다.
  echo "▸ 엔진에만 사는 유형이 늘었는지 확인"
  if ! npx tsx scripts/qa/checkUnloadedTypes.ts; then
    echo ""
    echo "🔴 엔진에 더했는데 **지면에 안 나가는** 유형이 늘었다."
    echo "   엔진에 유형을 더했으면 **적재까지가 완료 조건**이다."
    echo "   지금 못 적재한다면 --write 로 원장에 빚으로 적고 까닭을 커밋에 남겨라."
    exit 1
  fi

  # ── ⑷ 타입 ────────────────────────────────────────────────────────────
  # 🔴 **이건 망을 안 탄다.** 그런데도 위 둘 옆에 있는 까닭은, 실제로 production 을
  #    죽인 것이 이것이기 때문이다 — 2026-08-27 16:19(af12eb29) 부터 2026-08-28 까지
  #    **141커밋 동안 Vercel 배포가 전량 빨갰다.** 사유는 늘 같은 두 줄:
  #      scripts/import/load-classified.ts … Property 'held' does not exist
  #    `npm run build` 는 `next build` 안에서 tsc 를 돌리므로 **거기서 죽는다.**
  #
  #    왜 아무도 몰랐나: `type-check` 가 관문에도 훅에도 **없었다.** lint-staged 는
  #    ESLint 만 돌고, 그것도 «스테이징한 파일»만 본다 — 남의 파일을 되돌려 생긴
  #    이런 어긋남은 구조적으로 못 본다. 그리고 배포 실패는 **스스로 신고하지 않는다**
  #    (원장님이 화면에서 「접속이 안 된다」고 하실 때까지 아무 지표도 안 울었다).
  #
  #    ⚠️ 그러니 여기서 빼지 마라. 느리면(실측 10초 남짓) 빠르게 만들 일이지
  #    끄는 게 아니다.
  echo "▸ 타입 검사 (tsc --noEmit) — 배포가 이걸로 죽는다"
  if ! npm run --silent type-check; then
    echo ""
    echo "🔴 타입 오류가 있다 — 이대로 밀면 **Vercel 배포가 실패한다.**"
    echo "   next build 가 tsc 를 돌린다. 지금 고치지 않으면 조용히 빨간 채로 쌓인다."
    exit 1
  fi
done
