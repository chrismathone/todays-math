{
  "name": "todays-math",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/deploy/prepare-shared-figures.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:affordance": "node src/lint/check-affordance.mjs",
    "analyze": "next build --experimental-analyze && node scripts/perf/report-bundle.mjs",
    "analyze:webpack": "node scripts/perf/analyze-webpack.mjs",
    "bundle:report": "node scripts/perf/report-bundle.mjs",
    "type-check": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "prepare": "husky",
    "test": "node scripts/qa/run-tests.mjs",
    "test:raw": "vitest run",
    "test:adv": "vitest run --config vitest.adversarial.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "transfer:audit": "tsx scripts/transfer/audit-ocr-transfer.ts",
    "transfer:inventory": "tsx scripts/transfer/inventory-math-corpus.ts",
    "transfer:verify-engine": "tsx scripts/transfer/verify-engine-adapter.ts",
    "transfer:visual": "tsx scripts/transfer/run-visual-qa.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "check:figures": "tsx scripts/qa/checkDeployedFigures.ts",
    "check:raw-latex": "tsx scripts/qa/checkLoadedRawLatex.ts",
    "check:figure-choices": "tsx scripts/qa/checkFigureChoiceLinks.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium-min": "149.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ai": "^7.0.107",
    "bcryptjs": "^3.0.3",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "katex": "0.18.2",
    "mathjax-full": "^3.2.1",
    "mathlive": "^0.110.0",
    "mpg123-decoder": "1.0.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "puppeteer-core": "25.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@electric-sql/pglite": "0.5.8",
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "katex": "$katex",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "speech-rule-engine": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
