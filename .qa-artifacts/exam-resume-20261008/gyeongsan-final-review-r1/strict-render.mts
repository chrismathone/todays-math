const root=path.dirname(fileURLToPath(import.meta.url));const checkOnly=process.argv.includes('--check');assert(checkOnly||!fs.existsSync(path.join(root,'review-freeze.json')));delete process.env.STUDIO_ENGINE_URL;delete process.env.VERCEL;delete process.env.FIGURE_ENGINE_PATH;
