      "hwp": {
        "stream": "BodyText/Section0",
        "tag": 67,
        "record1based": 4444,
        "paragraph1based": 909,
        "offset": 224946,
        "text": "삼각비의 값은 0°에서 90°까지의 각도에 대한 것만 다룬다."
      },
      "pdfPhysicalPage1based": 39,
      "pdfPrintedPage": 35,
      "wholeClausePdfMatch": true
    },
    {
