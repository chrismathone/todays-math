            "actualRule": {
              "path": "C:/Users/user/orca/workspaces/todays-math/exam-extraction-resume-20261008/src/lib/middle/m3Trig.ts",
              "sha256": "818cc82cea89aee7ec4d09986c540500cf621780ac4b89aa1df4736f8348a80a",
              "startLine1based": 1526,
              "endLine1based": 1575,
              "text": "def(\n    \"삼각비\",\n    \"16\",\n    \"삼각비의 표를 이용하여 삼각비의 값 구하기\",\n    SEC.값,\n    \"기본\",\n    (rng) => {\n      const b = intBetween(rng, 30, 58);\n      const fn = intBetween(rng, 0, 2);\n      const table = [0, 1, 2].map((i) => tableValue(fn, b + i));\n      const mode = intBetween(rng, 0, 2);\n      const rows = [0, 1, 2]\n        .map((i) => `$${trigText(fn, b + i)}=${table[i]!.toFixed(4)}$`)\n        .join(\", \");\n      const head = `삼각비의 표에서 ${rows}이다.`;\n      if (mode === 0) {\n        return {\n          // 소수 넷째 자리까지 적으므로 마지막에 읽는 숫자는 만 배 한 정수의 끝 자리다.\n          content: `${head} 이때 $${FN_NAMES[fn]} x=${table[2]!.toFixed(4)}$${eulReul(Math.round(table[2]! * 10000))} 만족시키는 $x$의 크기를 구하시오.`,\n          answer: `$${b + 2}^\\\\circ$`,\n          solution: `표에서 값이 $${table[2]!.toFixed(4)}$인 각을 찾으면 $${b + 2}^\\\\circ$이다.\\n따라서 $x=${b + 2}^\\\\circ$이다.`,\n          facts: { b, fn, mode, target: b + 2, val: table[2]! },\n          figureSpec: null,\n        };\n      }\n      if (mode === 1) {\n        const sum = Number((table[0]! + table[2]!).toFixed(4));\n        return {\n          content: `${head} 이때 $${trigText(fn, b)}+${trigText(fn, b + 2)}$의 값을 구하시오.`,\n          answer: `$${sum.toFixed(4)}$`,\n          solution: `표에서 $${trigText(fn, b)}=${table[0]!.toFixed(4)}$, $${trigText(fn, b + 2)}=${table[2]!.toFixed(4)}$이다.\\n따라서 구하는 값은 $${table[0]!.toFixed(4)}+${table[2]!.toFixed(4)}=${sum.toFixed(4)}$이다.`,\n          facts: { b, fn, mode, target: b, val: sum },\n          figureSpec: null,\n        };\n      }\n      // 차 — 큰 값에서 작은 값을 뺀다($\\cos$ 는 각이 커질수록 작아진다).\n      const hi = fn === 1 ? b : b + 2;\n      const lo = fn === 1 ? b + 2 : b;\n      const diff = Number((tableValue(fn, hi) - tableValue(fn, lo)).toFixed(4));\n      return {\n        content: `${head} 이때 $${trigText(fn, hi)}-${trigText(fn, lo)}$의 값을 구하시오.`,\n        answer: `$${diff.toFixed(4)}$`,\n        solution: `표에서 $${trigText(fn, hi)}=${tableValue(fn, hi).toFixed(4)}$, $${trigText(fn, lo)}=${tableValue(fn, lo).toFixed(4)}$이다.\\n따라서 구하는 값은 $${tableValue(fn, hi).toFixed(4)}-${tableValue(fn, lo).toFixed(4)}=${diff.toFixed(4)}$이다.`,\n        facts: { b, fn, mode, target: hi, val: diff },\n        figureSpec: null,\n      };\n    },\n  ),\n\n  "
            }
          }
