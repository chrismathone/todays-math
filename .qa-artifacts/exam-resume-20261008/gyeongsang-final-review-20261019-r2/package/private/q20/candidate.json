              "startLine1based": 1229,
              "endLine1based": 1259,
              "text": "def(\n    \"삼각비\",\n    \"09\",\n    \"의 삼각비의 값을 이용하여 각의 크기 구하기\",\n    SEC.값,\n    \"기본\",\n    (rng) =>\n      attempt(300, () => {\n        const fn = intBetween(rng, 0, 2);\n        const theta = pick(rng, [30, 45, 60] as const);\n        const m = intBetween(rng, 1, 3);\n        const off = pick(rng, [-30, -20, -15, -10, 10, 15, 20, 30] as const);\n        if ((theta - off) % m !== 0) return null;\n        const x = (theta - off) / m;\n        if (x <= 0 || x >= 90) return null;\n        const v = exact(fn, theta);\n        if (!v) return null;\n        const coef = m === 1 ? \"x\" : `${m}x`;\n        const inner =\n          off > 0 ? `${coef}+${off}^\\\\circ` : `${coef}-${-off}^\\\\circ`;\n        return {\n          content: `$${inner}$가 예각이고 $${FN_NAMES[fn]}(${inner})=${surdText(v)}$일 때, $x$의 크기를 구하시오.`,\n          answer: `$${x}^\\\\circ$`,\n          solution: `$${trigText(fn, theta)}=${surdText(v)}$이고 $${inner}$가 예각이므로 $${inner}=${theta}^\\\\circ$이다.\\n따라서 $x=${x}^\\\\circ$이다.`,\n          facts: { fn, theta, m, off, x, an: v.n, ar: v.r, ad: v.d },\n          figureSpec: null,\n        };\n      }),\n  ),\n\n  "
            }
