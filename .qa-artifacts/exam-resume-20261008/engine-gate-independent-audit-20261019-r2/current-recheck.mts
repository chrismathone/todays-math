for(const answer of ['$6$개','$-1$개','$2.5$개','$02$개','$2$'])reject('bad-answer-'+answer,{...stem,answer,distractors:validDistractors});
for(const distractors of [['$0$개','$1$개','$3$개','$6$개'],['$0$개','$1$개','$3$개','$3$개'],['$0$개','$1$개','$2$개','$4$개'],['$0$개','$1$개','$3$개']])reject('bad-distractors-'+distractors.join('|'),{...stem,distractors});
const authored=checkMC('valid-authored',{...stem,distractors:validDistractors},7,5);
const unknown={...stem,content:'자연수 해의 개수를 구하시오.',distractors:['$0$개','$1$개','$3$개','$6$개']};assert.equal(declaredClassificationCount(unknown.content),null);const unknownMC=asMultipleChoice(unknown,createRng(7));assert(parseProblemContent(unknownMC.content).choices.includes('$6$개'));
