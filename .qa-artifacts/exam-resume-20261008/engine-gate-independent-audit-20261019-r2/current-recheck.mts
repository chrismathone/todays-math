const report={kind:'independent-count-domain-recheck/v2',root,codeBefore:before,codeAfter:after,codeStable:true,r1EvidenceHashes:historicalBefore,r1Unchanged:true,actual64:{passed:results.length,failed:0,results},domainN4N20:{passed:domainResults.length,failed:0,results:domainResults},negativeControls:{passed:rejects.length,failed:0,results:rejects},validAuthored:authored,unknownNonclassification:{bound:null,legacyOutOfClassificationRangeChoiceRetained:true,correctAnswerPreserved:parseProblemContent(unknownMC.content).choices['①②③④⑤'.indexOf(unknownMC.answer)]===unknown.answer},findings:[{id:'r1-F1',severity:'high',state:'resolved-for-current-hash',basis:'Actual64 generator cases and N4/N20 answer endpoints/interiors produce five distinct integer choices within0..N, preserve marked answer and solution.'},{id:'r1-F2',severity:'medium',state:'resolved-for-tested-bounded-grammar',basis:'Blank/ellipsis/exact and whitespace duplicates now return null and reject before legacy fallback even with valid authored distractors. Incomplete recognized headers reject.'}],scope:'New current-code runtime checks only; historical r1 failures remain intact. No root code/records edits; no candidate/taxonomy edits, DB/install/push. No future blind problem answers read.',limits:['Count grammar/distractor bounds do not establish semantic correctness of the supplied answer or equations.','No independent grade, copyright/rights, pedagogy or corpus coverage approval.','Candidate115 and taxonomy15/99 are unchanged context, not recalculated or promoted by this recheck.','Full/loadable remain0; existing source/custody/rights/similarity/native/family holds unaffected.'],status:'passed-within-requested-bounded-scope',fullVerified:0,loadable:0};
