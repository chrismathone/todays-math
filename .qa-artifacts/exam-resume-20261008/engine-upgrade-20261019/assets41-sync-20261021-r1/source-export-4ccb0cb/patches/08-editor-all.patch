+/** 각의 변 `vertex→point` 가 그림 조각의 from·to 선이면 그 선분을 더한 명세. */
+function assetEdgeSegment(
+  spec: DevAiFigureSpec,
+  angleName: string,
+  point: string,
+): FigureFix | undefined {
+  const angle = records(spec.angles).find(([name]) => name === angleName)?.[1];
+  const vertex = isItem(angle) ? String(angle.vertex ?? "") : "";
+  if (!vertex || !Array.isArray(spec.assets)) return undefined;
+  const ends = new Set([vertex, point]);
+  const standing = spec.assets.some(
+    (item: unknown) =>
+      isItem(item) &&
+      typeof item.from === "string" &&
+      typeof item.to === "string" &&
+      item.from !== item.to &&
+      ends.has(item.from) &&
+      ends.has(item.to),
+  );
+  if (!standing || !isItem(spec.segments)) return undefined;
+  let name = `${vertex}${point}`;
+  for (let i = 2; name in spec.segments; i++) name = `${vertex}${point}_${i}`;
+  return {
+    spec: { ...spec, segments: { ...spec.segments, [name]: [vertex, point] } },
+    note: `각 ${angleName} 의 변 ${vertex}${point} 가 그림 조각의 모서리라 그 선분을 넣었습니다.`,
