+/**
+ * 편집기 «그림» 메뉴의 에셋 파일 — 브라우저 전용(Vite `import.meta.glob`). 서버 묶음(api/ai.js)은 이 모듈을 안 부른다.
+ * 목록·이름은 `assetCatalog`(지시문과 같은 표), 파일 속은 여기서 처음 쓸 때 한 번 읽는다.
+ */
+import { FIGURE_ASSETS, type FigureAsset } from "@/lib/figure/assetCatalog";
+import anchors from "../../../../scripts/figure/assets/anchors.json";
+
+const DIR = "../../../../scripts/figure/assets/";
+const RAW = import.meta.glob<string>("../../../../scripts/figure/assets/*.svg", {
+  query: "?raw",
+  import: "default",
+});
+const URLS = import.meta.glob<string>("../../../../scripts/figure/assets/*.svg", {
+  query: "?url",
+  import: "default",
+  eager: true,
+});
+
+export interface FigureLibraryAsset extends FigureAsset {
+  /** 썸네일 주소 */
+  thumb: string;
+  /** 가운데 기준점(anchors.json, 잉크로 잰 값) — 없으면 틀 가운데 */
+  center?: number[];
+}
+
+const CENTERS = anchors as Record<string, { center?: number[] } | undefined>;
+
+/** 메뉴에 서는 에셋 — 파일이 있는 것만, 매니페스트 차례 그대로. */
+export const FIGURE_LIBRARY: readonly FigureLibraryAsset[] = FIGURE_ASSETS.flatMap((asset) => {
+  const thumb = URLS[DIR + asset.file];
+  return thumb && RAW[DIR + asset.file]
+    ? [{ ...asset, thumb, center: CENTERS[asset.slug]?.center }]
+    : [];
+});
+
+const bodies = new Map<string, Promise<string>>();
+/** 에셋 파일 원문 — 한 번 읽으면 기억한다. */
+export function loadFigureAsset(asset: Pick<FigureAsset, "file">): Promise<string> {
+  let body = bodies.get(asset.file);
+  if (!body) {
+    body = RAW[DIR + asset.file]();
+    bodies.set(asset.file, body);
+  }
+  return body;
+}
