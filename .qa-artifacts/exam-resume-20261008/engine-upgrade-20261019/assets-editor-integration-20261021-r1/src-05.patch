+    if (el.localName === "rect") {
+      const x = num(el, "x") || 0,
+        y = num(el, "y") || 0;
+      raw.push([x, y], [x + (num(el, "width") || 0), y + (num(el, "height") || 0)]);
+    } else if (el.localName === "circle" || el.localName === "ellipse") {
+      const rx = num(el, "r") || num(el, "rx") || 0,
+        ry = num(el, "r") || num(el, "ry") || 0;
+      raw.push([num(el, "cx") - rx, num(el, "cy") - ry], [num(el, "cx") + rx, num(el, "cy") + ry]);
+    } else if (el.localName === "line") raw.push([num(el, "x1"), num(el, "y1")], [num(el, "x2"), num(el, "y2")]);
+    else {
+      const values = (el.getAttribute("d") ?? el.getAttribute("points") ?? "").match(/[-+]?(?:\d*\.\d+|\d+\.?\d*)(?:e[-+]?\d+)?/gi) ?? [];
+      for (let i = 0; i + 1 < values.length; i += 2) raw.push([Number(values[i]), Number(values[i + 1])]);
+    }
+    const matrix = elementMatrix(el);
+    for (const point of raw) {
+      if (!point.every(Number.isFinite)) continue;
+      const [x, y] = applyPoint(matrix, point);
+      xs.push(x);
+      ys.push(y);
+    }
+  }
+  if (!xs.length) return undefined;
+  return [tenth(Math.min(...xs)), tenth(Math.min(...ys)), tenth(Math.max(...xs)), tenth(Math.max(...ys))] as [
+    number,
+    number,
+    number,
+    number,
