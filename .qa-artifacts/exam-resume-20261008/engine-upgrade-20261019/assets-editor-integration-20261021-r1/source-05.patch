+    tag.lastIndex = open.lastIndex;
+    let depth = 1,
+      end = -1,
+      step: RegExpExecArray | null;
+    while (depth && (step = tag.exec(svg))) {
+      if (step[0] === "</g>") depth--;
+      else if (!step[1]) depth++;
+      if (!depth) end = tag.lastIndex;
+    }
+    if (end < 0) break;
+    out += svg.slice(from, match.index) + match[0].replace(/>$/, "/>");
+    from = end;
+    open.lastIndex = end;
+  }
+  return out + svg.slice(from);
+}
