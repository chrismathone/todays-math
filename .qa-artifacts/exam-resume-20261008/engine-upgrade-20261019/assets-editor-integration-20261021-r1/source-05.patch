+<path d="M8 82 Q16 30 44 20 Q72 2 99 28 Q124 42 132 82 L96 82 L96 62 A26 30 0 0 0 44 62 L44 82 Z" fill="#ececec" stroke="#333333" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M44 82 L44 62 A26 30 0 0 1 96 62 L96 82" fill="none" stroke="#333333" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>
+</g>
