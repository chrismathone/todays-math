/**
 * **반증 ⑥ 의 규칙 한 곳** — 「발문이 준 수에 그 소단원 연산을 **순방향으로만** 적용해
 * 답이 나오면 그 문항은 «심화중·심화상»이 아니다」 (D-113 확정 잣대, 2026-08-30).
 *
 * ## 🔴 왜 규칙을 한 곳에 두나 — 그리고 **입력은 왜 두 곳인가**
 *
 * 이 규칙을 쓰는 자리가 둘이다.
 *
 * ```
 * 생성기 (g5.ts)                    후보를 만들 때 **미리** 거른다 — 지면에 나갈 수를 «예측»한다
 * 판정기 (probe-elem-tier-backsolve) 다 만든 뒤 **지면을 읽어** 다시 잰다 — 참은 지면에서 온다
 * ```
 *
 * **규칙이 두 벌이면 한쪽만 고쳐도 아무도 모른다.** 그래서 규칙은 여기 하나다.
 * 그런데 **입력은 일부러 다르다** — 생성기는 자기가 고른 수만 알고, 판정기는 발문에
 * 실제로 찍힌 수를 전부 본다. 둘이 갈리면 **판정기가 옳다.**
 * 실제로 2026-08-30 에 그렇게 갈렸다: 생성기가 「$1$보다 작은 소수」의 `$1$` 과 창의
 * 경계를 안 세어, 순방향으로 풀리는 문항 14건을 통과시켰다.
 *
 * ## 허용하는 꼴은 **지면에 실제로 있는 갈래의 모양 넷**뿐이다
 *
 * ```
 * a×b            연산·기본            「$0.9×5$」
 * a×b×c          2-4-7 응용           자리를 두 번 옮긴다
 * a×b ± c        응용                 「$4$ L 중 전체의 $0.6$만큼 쓰고 남은 것」 = c−a×b
 * a×b ± c×d      응용                 「$2.3$ m 막대 $2$개와 $1.1$ m 막대 $3$개」
 * ```
 *
 * 🔴 **넓혔다 좁혔다 두 번 틀렸고, 둘 다 실측이 잡았다.**
 *   ⑴ 첫 판은 덧뺄셈을 두 번까지 허용해 **거짓 경보 46건**을 냈다 —
 *      `1+1-1.6`·`3.5-3` 같은 **산술 우연**이 「순방향」으로 찍혔다. 학생이 밟을 길이 아니다.
 *   ⑵ 그래서 좁혔더니 이번엔 **응용 갈래를 놓쳤다**(위 셋째·넷째 꼴). 그게 참이면
 *      반증 ④ 가 「이 소단원은 이 축으로 안 갈린다」고 말해 **멀쩡한 소단원을 비우게**
 *      된다 — 놓침이 곧 잘못된 «비움»이 된다.
 *   지금 목록은 **갈래의 실제 모양에서 온 것**이지 지어낸 것이 아니다.
 *
 * ⚠️ **`1` 을 곱하는 것은 «적용»이 아니다.** 「$1$보다 작은 소수」의 `$1$` 은 낱말이지
 *    자료가 아닌데 곱셈에 쓰면 `a×1±b` 가 `a±b` 로 둔갑해 **아무 뺄셈이나** «순방향»이
 *    된다(위 ⑴ 의 절반이 이것이었다). 그래서 **곱이 피연산자와 같으면**(= 곱셈이 아무
 *    일도 안 했으면) 그 길은 안 센다.
 *
 * ⚠️ **이 자가 못 보는 것**: 「되짚기가 필요한가」는 못 잰다. 재는 것은 «순방향으로도
 *    되나» 하나뿐이다 — 닿으면 확실히 아니지만, **안 닿는다고 되짚기인 것은 아니다.**
 *    그리고 네 걸음짜리 순방향 문항도 못 본다(위 목록에 없다).
 */

/** 정확한 유리수 — 부동소수를 판정에 쓰지 않는다. */
export type Rat = { n: number; d: number };

const gcd = (a: number, b: number): number =>
  b === 0 ? Math.abs(a) : gcd(b, a % b);

export function rat(n: number, d = 1): Rat {
  const s = d < 0 ? -1 : 1;
  const g = gcd(n, d) || 1;
  return { n: (s * n) / g, d: (s * d) / g };
}

/** `[값, 소수점 아래 자릿수]` → 유리수. */
export const ratOfScaled = (value: number, places: number): Rat =>
  rat(value, 10 ** places);

const mul = (a: Rat, b: Rat) => rat(a.n * b.n, a.d * b.d);
const add = (a: Rat, b: Rat) => rat(a.n * b.d + b.n * a.d, a.d * b.d);
const sub = (a: Rat, b: Rat) => rat(a.n * b.d - b.n * a.d, a.d * b.d);
const same = (a: Rat, b: Rat) => a.n === b.n && a.d === b.d;

/** Exact stored pairs only; do not normalize or cache callers' values. */
function distinctRatPairs(values: readonly Rat[]): Rat[] {
  const result: Rat[] = [];
  for (const value of values) {
    if (!result.some((previous) => same(previous, value))) result.push(value);
  }
  return result;
}

/**
 * **답이 지면에 그대로 찍혀 있다** — 연산을 한 번도 안 쓰고 값이 맞는 자리.
 *
 * 🔴 이것은 «순방향 도달»이 **아니다** (2026-08-31 정정). 반증 ⑥ 의 문장은
 *    「발문이 준 수에 그 소단원 **연산을 순방향으로 적용해** 답이 나오면」이다 —
 *    **연산을 0번 쓰는 것은 적용이 아니다.**
 *
 *    실물로 걸린 자리: 초3 `2-1-1 심화중` 「어떤 한 자리 수를 $116$ 에 곱했더니
 *    **곱의 일의 자리 숫자가 $6$**. 올림이 한 번. 어떤 수는?」 → 답 $6$.
 *    지면의 `$6$` 은 **곱의 일의 자리**이지 피연산자가 아니다. 값만 같다.
 *    (일의 자리가 6인 수에 한 자리 수를 곱해 일의 자리가 6이 되려면 $k∈\{1,6\}$ 이라
 *     답이 자주 6 이 된다 — 우연이 아니라 **역할이 다른 것**이다.)
 *
 *    「답이 발문에 그대로 있다」는 그것대로 결함일 수 있지만 **다른 축**이다.
 *    여기서 세면 이 자가 그 부류를 통째로 오판한다.
 */
export function answerPrintedOnPage(
  nums: readonly Rat[],
  answer: Rat,
): boolean {
  return nums.some((v) => same(v, answer));
}

/*
 * 🔴 **÷ 한 걸음 축은 여기 넣지 마라 — 재고 버린 것이다.**
 *
 * 2026-08-31 반증 회차가 실측했다. `probe-elem-tier-backsolve.ts` 머리말이 정본이다:
 * 「÷ 를 × 처럼」 재면 연산 28.5 · 기본 29.2 · 응용 27.4 · 심화하 31.6 · 심화중 9.2
 * · 심화상 28.0% — **갈래를 안 가른다.** 심화상의 28% 를 거짓으로 물어 늘 우는 가드가
 * 되고, 이미 착지한 문항까지 흔든다(2026-08-20 「거짓 경보는 가드를 끈다」).
 *
 * 「나눗셈 소단원에서 `forwardReachable` 이 0 이다」는 참이지만, 그 0 을 메우는 값이
 * 이것은 아니다 — **못 셈을 잡음으로 바꾸는 것은 고침이 아니다.**
 * 초6 2-4-1 심화중 실측: 진짜 답 0/200 인데 **답+1 이 47/200(23.5%)** 이다.
 * 쓸 자리가 있다고 판단하면 **갈래마다 «답+1» 음성 대조를 같이 재고, 공용 자가 아니라
 * 그 생성기 안에서** 걸러라(± 한 걸음이 `g6.ts` 안에 사는 것과 같은 까닭).
 */
export function forwardReachable(nums: readonly Rat[], answer: Rat): boolean {
  const products: Rat[] = [];
  for (let i = 0; i < nums.length; i += 1) {
    for (let j = i + 1; j < nums.length; j += 1) {
      const two = mul(nums[i]!, nums[j]!);
      // 곱이 피연산자 그대로면 곱셈이 아무 일도 안 한 것이다.
      if (same(two, nums[i]!) || same(two, nums[j]!)) continue;
      if (same(two, answer)) return true;
      products.push(two);
      for (let k = 0; k < nums.length; k += 1) {
        if (k === i || k === j) continue;
        const three = mul(two, nums[k]!);
        if (!same(three, two) && same(three, answer)) return true;
      }
    }
  }
  // 곱한 뒤 한 번 더한다·뺀다 — 더하는 쪽은 낱값이든 또 다른 곱이든 좋다.
  // Operand indices still matter to the two/three-number checks above. Here
  // only a product's value is used; repeating the same exact pair adds no
  // reachable result, so avoid repeating its rational addition/subtraction.
  const bases = distinctRatPairs(products);
  const tails = distinctRatPairs([...nums, ...bases]);
  for (const base of bases) {
    for (const t of tails) {
      if (same(add(base, t), answer) || same(sub(base, t), answer)) return true;
      if (same(sub(t, base), answer)) return true;
    }
  }
  return false;
}

/**
 * **지면 두 수의 `+`·`−` 한 걸음으로 답에 닿는가** — 곱이 없는 소단원의 반증 ⑥.
 *
 * ## 🔴 왜 이 축이 따로 필요한가 (2026-08-31, 초3 물결 3 적대 검토)
 *
 * `forwardReachable` 의 허용 꼴은 `a×b` · `a×b×c` · `a×b±c` · `a×b±c×d` **넷뿐**이라
 * **곱이 첫 걸음이 아니면 길이 아예 없다.** 그래서 덧셈·뺄셈 소단원에서는 그 자가
 * **한 씨앗도 못 거른다** — 그 「⑥ 0건」은 «깨끗»이 아니라 **«못 셈»**이다.
 *
 * 실제로 그 눈먼 자리에서 갈래 하나가 통째로 잘못 섰다: 초3 `1-1-4 심화중`
 * 「어떤 수와 $B$ 의 차가 $D$ … 받아내림이 두 번」은 답이 **전수 20,625/20,625 로
 * $B-D$** 였다. 지면 두 수를 한 번 빼면 그대로 답이다. `forwardReachable` 은
 * 그것을 늘 `false` 로 봤다.
 *
 * ## 눈금 (양성·음성 대조군이 **둘 다** 있다)
 *
 * 이 자가 「무엇이든 닿는다」고 하면 쓸모가 없고, 「아무것도 안 닿는다」면 못 세는
 * 것이다. 초3 `1-1-4` 로 재면 **연산 닿음 · 기본 닿음 · 응용 안 닿음**이다 —
 * 음성 대조군이 있으므로 이 축은 실제로 갈린다. 시험이 그 셋을 다 잠근다.
 *
 * ⚠️ **0 을 더하거나 빼는 것은 «한 걸음»이 아니다.** 값이 안 변하면 연산을 적용한
 *    것이 아니라 지면의 수가 그대로 답인 것이고, 그건 `answerPrintedOnPage` 의 축이다.
 *    (`forwardReachable` 이 「곱이 피연산자 그대로면 곱셈이 아무 일도 안 한 것」을
 *     빼는 것과 같은 규칙이다.)
 *
 * ⚠️ **이 자는 «두 걸음 이상»을 안 본다.** 일부러 그렇다 — 반증 ⑥ 이 겨누는 것은
 *    「학생이 무심코 한 번 계산하면 답이 나오는가」다. 넓히면 정당한 응용·심화가
 *    걸려서 **늘 우는 가드**가 되고, 늘 우는 가드는 꺼진다(2026-08-20).
 */
export function pmOneStepReachable(nums: readonly Rat[], answer: Rat): boolean {
  for (let i = 0; i < nums.length; i += 1) {
    for (let j = 0; j < nums.length; j += 1) {
      if (i === j) continue;
      const a = nums[i]!;
      const b = nums[j]!;
      const s = add(a, b);
      if (!same(s, a) && !same(s, b) && same(s, answer)) return true;
      const d = sub(a, b);
      if (!same(d, a) && !same(d, b) && same(d, answer)) return true;
    }
  }
  return false;
}

/**
 * `"0.35"` → 7/20 · `"\frac{3}{4}"` → 3/4 · `"1\frac{1}{12}"` → 13/12 ·
 * `"12\,\mathrm{cm}"`·`"3000개"`·`"66^\circ"` → 꼬리를 떼고 수만. 못 읽으면 null.
 *
 * ## 🔴 왜 넓혔나 — 넓히기 전에는 **답의 38.2%를 못 읽었다** (2026-08-31 실측)
 *
 * 못 읽으면 `sweep()` 이 그 행을 **아예 안 만든다.** 그래서 초4 는 62소단원 중
 * **27개만** 훑혔다 — 나머지 35곳에서는 반증 ⑥ 이 「깨끗」이 아니라 **없다.**
 * 앞으로 채울 206소단원의 절반이 그 자리라, 넓히지 않으면 **가드 없이 채우게 된다.**
 *
 * 되찾은 부류와 실측 건수(씨앗 3):
 * ```
 * \frac{N}{N}        187   진짜 유리수인데 못 읽던 것
 * N\frac{N}{N}       107   대분수
 * N^\circ · N개 · N\,\mathrm{cm} · N명 · N원 · N칸 · N번 ≈ 296   단위·조사가 붙었을 뿐
 * ```
 *
 * ⚠️ **일부러 안 넓힌 것** — 이것들은 «수 하나»가 아니라서 이 자의 축이 아니다:
 * ```
 * N:N · N,\ N · N\,\mathrm{L}\ N\,\mathrm{mL} · N시간 N분 · 몫 N, 나머지 N
 * 가 · 나 · 다 · 둔각삼각형 · 평행        (도형 이름·고르기)
 * ```
 *    억지로 첫 수만 떼어 읽으면 「$3$시간 $20$분」이 $3$ 이 되어 **없는 판정을 지어낸다.**
 */
export function readRat(tok: string): Rat | null {
  let s = tok.trim();
  // 꼬리의 단위·조사만 뗀다 — **수가 둘 이상 남으면 안 뗀다**(혼합 표기는 이 축이 아니다).
  s = s
    .replace(/\^\\?circ$/, "")
    .replace(/\\,?\\mathrm\{[a-zA-Z]+\}$/, "")
    .replace(/\\,$/, "")
    .replace(/\s*(?:cm|mm|km|kg|mL|L|g|m)$/, "")
    .replace(/\s*[가-힣]+$/, "")
    .trim();

  // 대분수 `1\frac{1}{12}` — 정수부 + 진분수.
  const mixed = /^(\d+)\s*\\frac\{(\d+)\}\{(\d+)\}$/.exec(s);
  if (mixed) {
    const d = Number(mixed[3]);
    if (d === 0) return null;
    return rat(Number(mixed[1]) * d + Number(mixed[2]), d);
  }
  // 분수 `\frac{3}{4}`.
  const frac = /^\\frac\{(\d+)\}\{(\d+)\}$/.exec(s);
  if (frac) {
    const d = Number(frac[2]);
    return d === 0 ? null : rat(Number(frac[1]), d);
  }
  const m = /^(\d+)(?:\.(\d+))?$/.exec(s);
  if (!m) return null;
  const dec = m[2] ?? "";
  return rat(Number(m[1] + dec), 10 ** dec.length);
}

/**
 * **지면의 `$…$` 안에서 수를 전부 뽑는다** — 식이든 낱값이든 가리지 않는다.
 *
 * 🔴 생성기도 이것을 쓴다. 「지면에 무엇이 찍힐까」를 **예측하지 말고 찍힌 것을 읽으라**는
 *    뜻이다 — 예측하던 판은 성질 문구의 `$1$` 과 되풀이되는 곱하는 수를 빠뜨려
 *    순방향으로 풀리는 문항을 통과시켰다(2026-08-30, 14건 → 2건 → 0건).
 */
export function pageNumbers(text: string): Rat[] {
  const out: Rat[] = [];
  for (const m of text.matchAll(/\$([^$]*)\$/g)) {
    // 🔴 **분수를 먼저 통째로 삼킨다** (2026-08-31). 앞판은 `\frac{3}{4}` 를
    //    낱값 **[3, 4] 둘**로 읽었다 — 그건 느슨한 게 아니라 **틀린 것**이다.
    //    그래서 초5 2-2-1 연산 「$\frac34\times4$」 답 $3$ 이 «안 닿는다»로 찍혔고,
    //    분수 대단원 전체에서 이 자가 아무것도 판정하지 못했다.
    //    대분수도 한 값이다 — `2\frac13` 을 [2,1,3] 으로 읽으면 없는 수 셋이 생긴다.
    let body = m[1] ?? "";
    for (const f of body.matchAll(/(\d+)?\s*\\[dt]?frac\{(\d+)\}\{(\d+)\}/g)) {
      const d = Number(f[3]);
      if (d === 0) continue;
      out.push(rat(Number(f[1] ?? 0) * d + Number(f[2]), d));
    }
    body = body.replace(/(\d+)?\s*\\[dt]?frac\{(\d+)\}\{(\d+)\}/g, " ");
    for (const tok of body.match(/\d+(?:\.\d+)?/g) ?? []) {
      const r = readRat(tok);
      if (r) out.push(r);
    }
  }
  return out;
}
