          "actualRule": {
            "path": "C:/Users/user/orca/workspaces/todays-math/exam-extraction-resume-20261008/src/lib/middle/m3Trig.ts",
            "sha256": "818cc82cea89aee7ec4d09986c540500cf621780ac4b89aa1df4736f8348a80a",
            "startLine1based": 1867,
            "endLine1based": 1928,
            "text": "def(\n    \"삼각비의 활용\",\n    \"01\",\n    \"직각삼각형의 변의 길이 구하기\",\n    SEC.활용,\n    \"기본\",\n    (rng) =>\n      attempt<Body>(200, () => {\n        const theta = pick(rng, [30, 45, 60] as const);\n        const g = pick(rng, [4, 6, 8, 10, 12, 16, 20] as const);\n        const mode = intBetween(rng, 0, 1);\n        const sinT = exact(0, theta)!;\n        const cosT = exact(1, theta)!;\n        const adj = surdMul(surd(g, 1, 1), cosT);\n        const opp = surdMul(surd(g, 1, 1), sinT);\n        if (mode === 0) {\n          // (넓이) $=\\dfrac{1}{2}\\times\\overline{AB}\\times\\overline{BC}$\n          const area = surdMul(surdMul(adj, opp), surd(1, 1, 2));\n          if (area.d !== 1) return null;\n          return {\n            content: `직각삼각형 $ABC$에서 $\\\\angle B=90^\\\\circ$, $\\\\angle A=${theta}^\\\\circ$이고 $\\\\overline{AC}=${cm(g)}$일 때, 직각삼각형 $ABC$의 넓이를 구하시오.`,\n            answer: `$${cm2(surdText(area))}$`,\n            solution: `$\\\\overline{AB}=${g}\\\\times\\\\cos ${theta}^\\\\circ=${surdText(adj)}\\\\,(\\\\mathrm{cm})$, $\\\\overline{BC}=${g}\\\\times\\\\sin ${theta}^\\\\circ=${surdText(opp)}\\\\,(\\\\mathrm{cm})$이다.\\n따라서 (넓이)$=\\\\dfrac{1}{2}\\\\times${surdText(adj)}\\\\times${surdText(opp)}=${surdText(area)}\\\\,(\\\\mathrm{cm}^2)$이다.`,\n            facts: nums({ theta, given: g, mode, an: area.n, ar: area.r }),\n            figureSpec: figRight({\n              vert: surdValue(adj),\n              horz: surdValue(opp),\n              angA: `${theta}°`,\n              dims: { CA: dimCm(g) },\n            }),\n          };\n        }\n        // 둘레 — 유리항과 무리항을 따로 모은다($45^\\circ$ 는 둘 다 $\\sqrt{2}$ 라 합쳐진다).\n        let c0 = g;\n        let irr: Surd = { n: 0, r: 1, d: 1 };\n        for (const s of [adj, opp]) {\n          if (s.r === 1) {\n            c0 += s.n / s.d;\n            continue;\n          }\n          const t = surdAdd(irr, s);\n          if (!t) return null;\n          irr = t;\n        }\n        if (!Number.isInteger(c0)) return null;\n        if (irr.n === 0 || irr.d !== 1) return null;\n        return {\n          content: `직각삼각형 $ABC$에서 $\\\\angle B=90^\\\\circ$, $\\\\angle A=${theta}^\\\\circ$이고 $\\\\overline{AC}=${cm(g)}$일 때, 직각삼각형 $ABC$의 둘레의 길이를 구하시오.`,\n          answer: `$${lenText(c0, irr.n, irr.r, \"cm\")}$`,\n          solution: `$\\\\overline{AB}=${g}\\\\times\\\\cos ${theta}^\\\\circ=${surdText(adj)}\\\\,(\\\\mathrm{cm})$, $\\\\overline{BC}=${g}\\\\times\\\\sin ${theta}^\\\\circ=${surdText(opp)}\\\\,(\\\\mathrm{cm})$이다.\\n따라서 (둘레)$=${g}+${surdText(adj)}+${surdText(opp)}=${binomText(c0, irr.n, irr.r)}\\\\,(\\\\mathrm{cm})$이다.`,\n          facts: nums({ theta, given: g, mode, c0, c1: irr.n, root: irr.r }),\n          figureSpec: figRight({\n            vert: surdValue(adj),\n            horz: surdValue(opp),\n            angA: `${theta}°`,\n            dims: { CA: dimCm(g) },\n          }),\n        };\n      }),\n  ),\n\n  "
          }
        }
