{
    "entries":  [
                    {
                        "id":  "m1-02-02-xc15",
                        "section":  "중1::2. 정수와 유리수::수의 대소관계",
                        "term":  "가장 큰 수와 가장 작은 수",
                        "kind":  "방법",
                        "level":  "중",
                        "definition":  "양수와 음수가 섞여 있으면 가장 큰 수는 양수 가운데 절댓값이 가장 {큰} 수, 가장 작은 수는 음수 가운데 절댓값이 가장 {큰} 수이다.",
                        "example":  {
                                        "prompt":  "$-4$, $3$, $-\\frac{9}{2}$, $0$ 가운데 가장 작은 수는?",
                                        "answer":  "$-\\frac{9}{2}$"
                                    }
                    },
                    {
                        "id":  "m2-05-04-c9",
                        "section":  "중2::5. 도형의 성질::삼각형의 내심",
                        "term":  "삼각형의 내심의 성질 — 거리",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "내심에서 삼각형의 {세 변}까지의 거리는 모두 같고, 그 거리가 내접원의 {반지름}이다."
                    },
                    {
                        "id":  "m3-05-02-c2",
                        "section":  "중3::5. 삼각비::삼각비의 값",
                        "term":  "삼각비의 표",
                        "kind":  "정의",
                        "level":  "하",
                        "definition":  "$0^\\circ$부터 $90^\\circ$까지 {$1^\\circ$} 간격으로 삼각비의 어림값을 늘어놓은 표가 삼각비의 표이고, 각의 {가로줄}과 $\\sin$ · $\\cos$ · $\\tan$의 세로줄이 만나는 칸을 읽는다."
                    },
                    {
                        "id":  "m1-02-04-xc24",
                        "section":  "중1::2. 정수와 유리수::유리수의 곱셈",
                        "term":  "곱과 합으로 두 정수 찾기",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "곱이 $0$이 아니면 곱의 {부호}로 두 수의 부호가 같은지 다른지를 먼저 정하고, {절댓값의 곱}이 맞는 짝 가운데 합이 맞는 것을 고른다.",
                        "example":  {
                                        "prompt":  "곱이 $-6$, 합이 $1$인 두 정수를 찾을 때 곱의 부호로 알 수 있는 것은?",
                                        "answer":  "두 수의 부호가 다르다"
                                    }
                    },
                    {
                        "id":  "m3-05-02-c9",
                        "section":  "중3::5. 삼각비::삼각비의 값",
                        "term":  "각의 크기에 따른 삼각비의 값의 변화",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "각이 $0^\\circ$에서 $90^\\circ$까지 커지면 사인은 $0$에서 $1$로 {커지고} 코사인은 $1$에서 $0$으로 {작아진다} — 탄젠트는 $0$에서 시작해 각이 $90^\\circ$에 가까워질수록 끝없이 {커진다}."
                    },
                    {
                        "id":  "m2-01-01-xc22",
                        "section":  "중2::1. 수와 식::유리수와 소수",
                        "term":  "유리수와 유한소수의 포함 관계",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "유한소수는 모두 {유리수}이지만, 유리수가 모두 {유한소수}인 것은 아니다.",
                        "example":  {
                                        "prompt":  "유리수이지만 유한소수가 아닌 수의 예",
                                        "answer":  "$\\frac{1}{3}$"
                                    }
                    },
                    {
                        "id":  "m1-03-02-xc9",
                        "section":  "중1::3. 방정식::일차식의 뜻Ⅰ",
                        "term":  "한 문자에 대한 차수",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "\u0027$x$에 대한 차수\u0027를 물으면 {$x$}가 곱해진 횟수만 센다.",
                        "example":  {
                                        "prompt":  "$3x^2y$에서 $x$에 대한 차수는?",
                                        "answer":  "$2$"
                                    }
                    },
                    {
                        "id":  "m2-01-02-xc14",
                        "section":  "중2::1. 수와 식::순환소수",
                        "term":  "순환마디의 되풀이 간격",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "소수점 바로 아래부터 순환하고 순환마디가 $k$자리이면, 같은 숫자는 {$k$자리마다} 다시 나온다.",
                        "example":  {
                                        "prompt":  "$0.\\dot{1}2\\dot{3}$의 소수점 아래 $4$번째 숫자",
                                        "answer":  "$1$"
                                    }
                    },
                    {
                        "id":  "m1-03-04-xc19",
                        "section":  "중1::3. 방정식::방정식과 그 해",
                        "term":  "해가 상황에 맞는지 보기",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "개수 · 사람 수처럼 미지수가 자연수여야 하면, 해가 분수나 음수로 나올 때 그 상황에 {맞지 않는다}.",
                        "example":  {
                                        "prompt":  "사람 수 $x$에 대한 방정식의 해가 $x=\\frac{7}{2}$이면?",
                                        "answer":  "알맞은 답이 없다"
                                    }
                    },
                    {
                        "id":  "m3-02-03-xc23",
                        "section":  "중3::2. 다항식의 곱셈과 인수분해::인수분해의 응용",
                        "term":  "근호 안이 제곱의 차일 때",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "근호 안이 {제곱의 차}이면 합과 차의 곱으로 바꾼 뒤, 두 인수가 각각 {제곱인 수}가 되는지 본다.",
                        "example":  {
                                        "prompt":  "$\\sqrt{26^2-10^2}$의 근호 안을 인수분해하면 좋은 점은?",
                                        "answer":  "$36\\times16$, 둘 다 제곱인 수라서"
                                    }
                    },
                    {
                        "id":  "m1-03-05-xc24",
                        "section":  "중1::3. 방정식::등식의 성질",
                        "term":  "틀린 줄 찾기",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "풀이에서 한쪽 변에만 계산했거나 양변에 한 계산이 {다르면}, 그 줄은 등식의 성질로 {설명할 수 없는} 줄이다.",
                        "example":  {
                                        "prompt":  "$\\frac{x}{3}=4$를 $x=\\frac{4}{3}$로 푼 잘못은?",
                                        "answer":  "양변에 $3$을 곱해야 한다"
                                    }
                    },
                    {
                        "id":  "m2-01-06-xc10",
                        "section":  "중2::1. 수와 식::단항식의 곱셈과 나눗셈",
                        "term":  "분수 계수인 단항식으로 나누기",
                        "kind":  "방법",
                        "level":  "중",
                        "definition":  "계수가 분수인 단항식으로 나눌 때는 나누는 식을 문자까지 넣어 {하나의 분수}로 쓴 다음 그 {역수}를 곱한다.",
                        "example":  {
                                        "prompt":  "$\\frac{2}{3}x$를 $\\frac{2x}{3}$로 쓸 수 있는 까닭은?",
                                        "answer":  "$x$가 분자에 곱해져서"
                                    }
                    },
                    {
                        "id":  "m2-03-06-xc20",
                        "section":  "중2::3. 방정식::연립방정식의 활용(수, 평균, 나이)",
                        "term":  "나이 문제의 해 검토",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "구한 나이가 음수나 분수이면 먼저 식을 {다시} 살핀다. 식이 맞아도 조건을 모두 만족하는 나이가 {없을} 수 있다."
                    },
                    {
                        "id":  "m1-05-03-xc22",
                        "section":  "중1::5. 기본 도형::두 직선의 위치 관계",
                        "term":  "정육각기둥의 평행한 모서리",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "정육각기둥에서 밑면의 한 모서리와 평행한 모서리는 같은 밑면의 {마주 보는} 모서리와 다른 밑면의 {두} 모서리이다.",
                        "example":  {
                                        "prompt":  "정육각기둥에서 밑면의 한 모서리와 평행한 모서리는 몇 개?",
                                        "answer":  "$3$개"
                                    }
                    },
                    {
                        "id":  "m1-07-02-xc22",
                        "section":  "중1::7. 입체도형::정다면체",
                        "term":  "개수 사이의 관계",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "정다면체에서 면의 수와 한 면의 변의 수의 곱은 모서리 수의 {$2$배}이고, 꼭짓점 수와 한 꼭짓점에 모인 면의 수의 {곱}과도 같다.",
                        "example":  {
                                        "prompt":  "정육면체에서 면의 수와 한 면의 변의 수의 곱은 얼마인가?",
                                        "answer":  "$24$"
                                    }
                    },
                    {
                        "id":  "m2-04-01-xc15",
                        "section":  "중2::4. 함수::함수와 함숫값",
                        "term":  "약수와 약수의 개수 가르기",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "자연수 $x$의 약수 $y$는 함수가 {아니지만}, 약수의 {개수} $y$는 함수이다."
                    },
                    {
                        "id":  "m1-08-03-xc17",
                        "section":  "중1::8. 통계::도수분포표",
                        "term":  "계급 안의 기준으로 나누기",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "판단 기준이 계급의 {안쪽}에 있으면, 그 기준 이상인 자료 수를 {표만으로}는 확정하지 못할 수 있다."
                    },
                    {
                        "id":  "m3-05-01-xc16",
                        "section":  "중3::5. 삼각비::삼각비의 뜻",
                        "term":  "직선의 기울기와 탄젠트",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "기울기가 {양수}인 직선이 $x$축의 양의 방향과 이루는 예각을 $a$라 하면 $\\tan a$는 그 직선의 {기울기}와 같다."
                    },
                    {
                        "id":  "m2-04-06-xc6",
                        "section":  "중2::4. 함수::일차함수의 활용(온도, 길이)",
                        "term":  "짧아지는 양초",
                        "kind":  "성질",
                        "level":  "하",
                        "definition":  "양초가 일정하게 타면 길이는 시간에 대해 {줄어드는} 일차함수이고 기울기는 {음수}이다."
                    },
                    {
                        "id":  "m1-08-05-xc9",
                        "section":  "중1::8. 통계::도수분포다각형",
                        "term":  "이웃 점 사이의 가로 간격",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "계급 폭이 일정하면 이웃한 두 계급을 나타내는 점 사이의 가로 간격은 {계급의 크기}와 같다."
                    },
                    {
                        "id":  "m2-04-08-xc9",
                        "section":  "중2::4. 함수::일차함수와 일차방정식",
                        "term":  "방정식에서 기울기와 절편 읽기",
                        "kind":  "방법",
                        "level":  "중",
                        "definition":  "$ax+by+c=0$($b\\ne0$)을 $y$에 대해 풀어 {기울기}와 {$y$절편}을 읽는다.",
                        "example":  {
                                        "prompt":  "$4x+2y-6=0$의 기울기",
                                        "answer":  "$-2$"
                                    }
                    },
                    {
                        "id":  "m1-08-06-xc20",
                        "section":  "중1::8. 통계::상대도수",
                        "term":  "반올림한 비율의 합",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "각 상대도수를 따로 반올림해 쓰면 표시된 값들의 합은 {$1$}과 조금 {다를 수 있다}."
                    },
                    {
                        "id":  "m1-08-06-xc22",
                        "section":  "중1::8. 통계::상대도수",
                        "term":  "비율 비교에 앞선 계급 확인",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "집단 사이의 비율을 비교하려면 먼저 비교하는 계급의 {범위}가 같은지 살핀다."
                    },
                    {
                        "id":  "m2-05-01-xc6",
                        "section":  "중2::5. 도형의 성질::이등변삼각형의 성질",
                        "term":  "꼭지각의 이등분선과 밑변의 중점",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "이등변삼각형에서 꼭지각의 이등분선은 밑변의 {중점}을 지난다. 이등분선 가운데 꼭짓점에서 밑변까지의 부분은 꼭짓점과 밑변의 중점을 이은 {선분}이다."
                    },
                    {
                        "id":  "m2-05-02-xc16",
                        "section":  "중2::5. 도형의 성질::직각삼각형의 합동",
                        "term":  "빗변이 같아야 쓰는 조건",
                        "kind":  "성질",
                        "level":  "상",
                        "definition":  "직각삼각형의 합동 조건인 $\\mathrm{RHA}$와 $\\mathrm{RHS}$는 모두 {빗변}의 길이가 같아야 쓸 수 있다. 이 길이가 다르면 두 조건을 쓸 수 없다."
                    },
                    {
                        "id":  "m2-05-08-xc10",
                        "section":  "중2::5. 도형의 성질::등변사다리꼴, 여러 가지 사각형",
                        "term":  "등변사다리꼴 속 합동인 두 삼각형",
                        "kind":  "성질",
                        "level":  "중",
                        "definition":  "$\\overline{AD}\\parallel\\overline{BC}$인 등변사다리꼴 $ABCD$에서 $\\triangle ABC$와 $\\triangle DCB$는 {$\\mathrm{SAS}$} 합동이다."
                    },
                    {
                        "id":  "m2-09-04-xc22",
                        "section":  "중2::9. 확률::확률의 계산",
                        "term":  "두 색이 같은 사건의 분할",
                        "kind":  "방법",
                        "level":  "상",
                        "definition":  "빨강과 파랑만 있는 주머니에서 두 색이 같다는 사건을 {모두 빨강}과 {모두 파랑}으로 나누어 계산한다."
                    }
                ]
}