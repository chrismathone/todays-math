--- /dev/null
+++ b/scripts/qa/concept-blank/student-clear/example-corrections.ts
@@ -0,0 +1,110 @@
+/** Separate source grammar corrections; never part of B/C proposal normalization. */
+import type {
+  ConceptBlankBank,
+  ConceptEntry,
+} from "@/contracts/conceptBlank.contract";
+import { josaFaults } from "@/lib/elementary/rules";
+
+export type ExamplePromptChange = {
+  part: string;
+  id: string;
+  before: string;
+  after: string;
+  reason: string;
+};
+
+const opposite: Record<string, string> = {
+  을: "를",
+  를: "을",
+  이: "가",
+  가: "이",
+  과: "와",
+  와: "과",
+  은: "는",
+  는: "은",
+  로: "으로",
+  으로: "로",
+};
+
+/** Exactly one measured math-following particle may change; every other character stays. */
+export function validateExampleParticleChange(
+  before: string,
+  after: string,
+): void {
+  const faults = josaFaults(before);
+  if (faults.length !== 1 || josaFaults(after).length !== 0)
+    throw new Error("예문 교정은 조사 결함 하나만 없애야 합니다.");
+  const fault = faults[0]!;
+  const match = fault.match(/^(\$[^$]*\$ ?)(으로|로|을|를|이|가|과|와|은|는)$/);
+  if (!match) throw new Error("예문 조사 결함의 위치를 확인할 수 없습니다.");
+  const position = before.indexOf(fault);
+  const expected =
+    before.slice(0, position) +
+    match[1] +
+    opposite[match[2]!] +
+    before.slice(position + fault.length);
+  if (position < 0 || after !== expected)
+    throw new Error("예문 교정에 조사 이외의 문구나 수식 변경이 있습니다.");
+}
+
+/** Accept a strict array, bound to immutable original ID/part/prompt, in bank order. */
+export function validateExamplePromptChanges(
+  baseline: Readonly<Record<string, ConceptBlankBank>>,
+  input: unknown = [],
+): ExamplePromptChange[] {
+  if (!Array.isArray(input)) throw new Error("예문 교정 배열이 없습니다.");
+  const originals = Object.entries(baseline).flatMap(([part, bank]) =>
+    bank.concepts.map((entry) => ({ part, entry })),
+  );
+  const byId = new Map(originals.map((row) => [row.entry.id, row]));
+  if (byId.size !== originals.length)
+    throw new Error("원천 예문 ID가 중복됩니다.");
+  const seen = new Set<string>();
+  const fields = ["part", "id", "before", "after", "reason"];
+  const changes = input.map((value: unknown): ExamplePromptChange => {
+    if (!value || typeof value !== "object" || Array.isArray(value))
+      throw new Error("예문 교정 행의 형식 오류");
+    const row = value as Record<string, unknown>;
+    if (
+      Object.keys(row).length !== fields.length ||
+      Object.keys(row).some((key) => !fields.includes(key)) ||
+      fields.some(
+        (key) => typeof row[key] !== "string" || !(row[key] as string).trim(),
+      )
+    )
+      throw new Error("예문 교정은 part·id·before·after·reason만 필요합니다.");
+    const change = row as ExamplePromptChange;
+    if (seen.has(change.id)) throw new Error(`중복 예문 교정 ID: ${change.id}`);
+    seen.add(change.id);
+    const original = byId.get(change.id);
+    if (
+      !original ||
+      original.part !== change.part ||
+      original.entry.example?.prompt !== change.before
+    )
+      throw new Error(
+        `예문 교정의 원천 ID·part·before가 다릅니다: ${change.id}`,
+      );
+    validateExampleParticleChange(change.before, change.after);
+    return {
+      part: change.part,
+      id: change.id,
+      before: change.before,
+      after: change.after,
+      reason: change.reason,
+    };
+  });
+  const order = new Map(originals.map((row, index) => [row.entry.id, index]));
+  return changes.sort((a, b) => order.get(a.id)! - order.get(b.id)!);
+}
+
+/** Retain the answer and all non-prompt fields exactly. */
+export function withExamplePromptChange(
+  entry: ConceptEntry,
+  change?: ExamplePromptChange,
+): ConceptEntry {
+  if (!change) return entry;
+  if (entry.id !== change.id || entry.example?.prompt !== change.before)
+    throw new Error(`후보 예문이 교정 기준과 다릅니다: ${change.id}`);
+  return { ...entry, example: { ...entry.example, prompt: change.after } };
+}
diff --git a/scripts/qa/concept-blank/student-clear/example-source.ts b/scripts/qa/concept-blank/student-clear/example-source.ts
new file mode 100644
--- /dev/null
+++ b/scripts/qa/concept-blank/student-clear/example-source.ts
@@ -0,0 +1,161 @@
+/** Bind example prompts to existing definition locations, never search/replace by text. */
+import ts from "typescript";
+import { definitionLiterals } from "./definition-source";
+import { validateExampleParticleChange } from "./example-corrections";
+
+type PromptLiteral = {
+  id: string;
+  start: number;
+  end: number;
+  value: string;
+  answer: string;
+};
+type SourceExampleChange = {
+  id: string;
+  before: string;
+  after: string;
+  answer: string;
+};
+
+function property(
+  node: ts.ObjectLiteralExpression,
+  name: string,
+): ts.Expression | undefined {
+  const item = node.properties.find(
+    (item) =>
+      ts.isPropertyAssignment(item) &&
+      item.name.getText().replace(/["']/g, "") === name,
+  );
+  return item && ts.isPropertyAssignment(item) ? item.initializer : undefined;
+}
+
+function literal(
+  expression: ts.Expression | undefined,
+  source: ts.SourceFile,
+): string | undefined {
+  if (!expression) return undefined;
+  if (ts.isStringLiteralLike(expression)) return expression.text;
+  if (
+    ts.isTaggedTemplateExpression(expression) &&
+    ["r", "String.raw"].includes(expression.tag.getText(source)) &&
+    ts.isNoSubstitutionTemplateLiteral(expression.template)
+  )
+    return expression.template
+      .getText(source)
+      .slice(1, -1)
+      .replace(/\r\n?/g, "\n");
+  return undefined;
+}
+
+/** Definition element 3 binds the ID; example element 4 is [prompt, answer]. */
+export function examplePromptLiterals(
+  text: string,
+  grade: string,
+  ids: string[],
+): Map<string, PromptLiteral> {
+  if (new Set(ids).size !== ids.length) throw new Error("중복 예문 원천 ID");
+  const definitions = definitionLiterals(text, grade);
+  const selected = new Map(
+    ids.map((id) => {
+      const definition = definitions.get(id);
+      if (!definition) throw new Error(`예문 원천 ID 없음: ${id}`);
+      return [definition.start, { id, end: definition.end }] as const;
+    }),
+  );
+  const source = ts.createSourceFile(
+    `${grade}.ts`,
+    text,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const found = new Map<string, PromptLiteral>();
+  const visit = (node: ts.Node) => {
+    const binding = selected.get(node.getStart(source));
+    if (binding && node.getEnd() === binding.end && ts.isExpression(node)) {
+      const { id } = binding;
+      const parent = node.parent;
+      let example: ts.Expression | undefined;
+      if (ts.isArrayLiteralExpression(parent) && parent.elements[3] === node)
+        example = parent.elements[4];
+      else if (
+        ts.isPropertyAssignment(parent) &&
+        ts.isObjectLiteralExpression(parent.parent)
+      )
+        example = property(parent.parent, "example");
+      const prompt =
+        example && ts.isArrayLiteralExpression(example)
+          ? example.elements[0]
+          : example && ts.isObjectLiteralExpression(example)
+            ? property(example, "prompt")
+            : undefined;
+      const answerExpression =
+        example && ts.isArrayLiteralExpression(example)
+          ? example.elements[1]
+          : example && ts.isObjectLiteralExpression(example)
+            ? property(example, "answer")
+            : undefined;
+      const value = literal(prompt, source);
+      const answer = literal(answerExpression, source);
+      if (!prompt || value === undefined || answer === undefined)
+        throw new Error(
+          `${id}: 예문의 prompt·answer 리터럴을 찾을 수 없습니다.`,
+        );
+      if (found.has(id)) throw new Error(`중복 예문 원천 위치: ${id}`);
+      found.set(id, {
+        id,
+        start: prompt.getStart(source),
+        end: prompt.getEnd(),
+        value,
+        answer,
+      });
+    }
+    ts.forEachChild(node, visit);
+  };
+  visit(source);
+  if (found.size !== ids.length)
+    throw new Error("예문 ID와 코드 위치가 다릅니다.");
+  return found;
+}
+
+/** Writes nothing; only approved prompt literals are replaced, with unchanged answers. */
+export function replaceExamplePrompts(
+  text: string,
+  grade: string,
+  changes: SourceExampleChange[],
+): string {
+  if (!changes.length) return text;
+  const locations = examplePromptLiterals(
+    text,
+    grade,
+    changes.map((change) => change.id),
+  );
+  const edits = changes
+    .map((change) => {
+      validateExampleParticleChange(change.before, change.after);
+      const location = locations.get(change.id)!;
+      if (location.value !== change.before || location.answer !== change.answer)
+        throw new Error(`예문 원천 prompt·answer가 바뀌었습니다: ${change.id}`);
+      const original = text.slice(location.start, location.end);
+      const raw = /^(r|String\.raw)`/.exec(original);
+      const replacement =
+        raw && !change.after.includes("`") && !change.after.includes("${")
+          ? raw[1] + "`" + change.after + "`"
+          : JSON.stringify(change.after);
+      return { ...location, replacement };
+    })
+    .sort((a, b) => b.start - a.start);
+  let next = text;
+  for (const edit of edits)
+    next = next.slice(0, edit.start) + edit.replacement + next.slice(edit.end);
+  const updated = examplePromptLiterals(
+    next,
+    grade,
+    changes.map((change) => change.id),
+  );
+  for (const change of changes) {
+    const location = updated.get(change.id)!;
+    if (location.value !== change.after || location.answer !== change.answer)
+      throw new Error(`예문 교정 범위를 벗어난 변경: ${change.id}`);
+  }
+  return next;
+}
