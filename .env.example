# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Supabase 전환 시: 커넥션 풀러(pgbouncer, 6543 포트)를 우회하는 직결 URL — 마이그레이션 전용.
# 로컬 Docker 개발 환경에서는 DATABASE_URL과 동일한 값을 사용.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app

# Auth.js — AUTH_SECRET 없으면 로그인 시 Server error (MissingSecret)
# 로그인 수단은 이메일/비밀번호뿐이다(소셜 로그인 제거 2026-08-14).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# DeepSeek API — 문제 생성/변형(모델: deepseek-v4-pro). 서버 환경변수로만 둔다.
DEEPSEEK_API_KEY=your-api-key-here

# 공유 Supabase에 classified 문항을 공용 풀로 넣을 때만 1. 평소에는 두지 말 것.
# ALLOW_SHARED_IMPORT=1

# 자료 제작 AI — /dev/unified 에서 구독 CLI / 서버 모델 API 선택.
# /studio 는 로그인한 사용자의 모델 API만 제공한다. production CLI는 비활성화.
# 실제 값은 .env.development.local 또는 배포 서버 환경에만 설정한다.
# DEV_AI_MODE=subscription-cli
# DEV_AI_PROVIDER=claude
# DEV_AI_CODEX_HOME=C:/absolute/path/to/already-authenticated/profile
# API 자동 배정: Gemini OCR·도형 검수 / DeepSeek 해설 / Anthropic 도형 생성.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY 는 위 항목 사용. 모든 키는 서버 전용이며 NEXT_PUBLIC_ 금지.
# 선택 사항: docs/dev-subscription-ai.md 및 src/lib/studio-ai/routing.ts의 허용 모델.
# STUDIO_AI_GEMINI_MODEL=gemini-3.8-flash
# STUDIO_AI_DEEPSEEK_MODEL=deepseek-v4-pro
# STUDIO_AI_ANTHROPIC_MODEL=claude-opus-5
# STUDIO_AI_OPENAI_MODEL=gpt-5.5
# 오늘의 영어 «사진에서 글 읽기»(D-158) — 사진을 보는 키 가운데 Gemini → OpenAI → Claude 차례로 고른다.
# 제공자와 모델을 따로 정하려면(작업실의 모델은 그대로 두고 읽기만 바꾼다). 모델은 readPhoto.ts 의 READ_MODELS 안에서.
# 모델만 적으면 그 모델의 제공자로 간다.
# ENGLISH_READ_VENDOR=gemini
# ENGLISH_READ_MODEL=gemini-3.8-flash
# 읽은 글을 같은 사진과 한 번 더 대조(VERIFY) · 따로 한 번 더 읽어 빈칸 자리를 맞추기(TWICE) — on | off.
# 없으면 Gemini 일 때만 둘 다 켠다(한 장에 모델 호출 셋 — 25 §13.10). 다른 제공자는 한 번만 읽는다.
# ENGLISH_READ_VERIFY=on
# ENGLISH_READ_TWICE=on
# 선택: 도형 수정의 Jev 빠른 길 — TypeSafe 직접 API(jev-latest), 서버 전용.
# TYPESAFE_API_KEY=
# STUDIO_AI_JEV=off 로 끈다. Gateway 키/OIDC만으로는 켜지지 않는다.
# STUDIO_AI_JEV=off
# 직접 API의 보존 정책/ZDR 조건: docs/dev-subscription-ai.md의 Jev 절 참고.
# 로컬 PDF/도형 비교는 설치된 Chrome/Edge를 자동 탐색한다. 필요할 때만 지정.
# PDF_CHROMIUM_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Python 도형/HWPX 엔진: Vercel은 같은 배포의 /api/mathgen-engine 자동 사용.
# 다른 호스트의 엔진을 지정할 때만 신뢰할 서버 주소를 설정한다(브라우저 입력 불가).
# STUDIO_ENGINE_URL=https://your-engine.example
# STUDIO_ENGINE_SECRET=optional-dedicated-secret
# 생략 시 AUTH_SECRET을 내부 서명에 사용. 별도 서버라면 양쪽 값이 같아야 한다.
# Vercel 배포 보호를 켰다면 서버 환경의 VERCEL_AUTOMATION_BYPASS_SECRET도 필요.

# eywa 연계의 소유자 계정 — 이 이메일의 세션만 「지금 가져오기」(POST /api/eywa-sync)를 부를 수 있고
# 메인의 「오늘의 확인테스트」(eywa) 섹션을 본다. 비어 있으면 아무도 소유자가 아니다(2026-09-07).
EYWA_SYNC_OWNER_EMAIL=

# eywa 자동 로그인(SSO, D-139 ⑹ 2판) — eywa 와 같은 값. 32바이트 이상 무작위. 비었거나 16자 미만이면 기능 꺼짐.
# 2판은 **sub 연결 방식**이다: 표의 eywa 사용자 id(sub)가 이미 연결된 계정만 들어온다(이메일로 찾지 않는다).
# 연결은 계정 주인이 비밀번호로 로그인한 뒤 /account/eywa-link 에서 [연결]을 눌러야만 생긴다. 연결 대기 쿠키는
# AUTH_SECRET 에서 따로 유도한 열쇠로 서명한다(이 값과 무관).
# 🔴 넣는 것은 리드가 배포를 확인한 뒤 — 순서는 DB 먼저(scripts/qa/apply-eywa-link-migration.ts) · 코드 나중.
EYWA_SSO_SECRET=
# 선택 — 쉼표로 가른 eywa 지점(tenant) id. 넣으면 그 지점의 표만 받는다. 비었으면 모든 지점.
EYWA_SSO_TENANT_IDS=

# Managed v2 sync: identical server-only JSON on Eywa and todays-math.
# Recommended: one installation trust config, automatic branch creation on source ON.
# Entries: sourceBaseUrl,targetBaseUrl,keyId,controlSecret,webhookSecret,ssoSecret.
EYWA_SYNC_AUTO_JSON=[]
# Optional explicit existing branch mappings; they take priority over automatic identities.
# Production origins and branch mappings must be verified before activation.
# See docs/eywa-managed-sync-receiver.md; never use production bindings in Preview.
EYWA_SYNC_BINDINGS_JSON=[]

# Enable only after the recovery reader release has been deployed and verified.
TEXTBOOK_RECOVERY_WRITER_ENABLED=false

# SRS minute relearning: unset/on enables, off or an unknown value disables.
# Reader floor main11fdbf48d must be deployed first; verified in7c9e9a4b8.
# Never run earlier branches against a database containing fading.relearn.
# MATH_FADING_RELEARN=off

# 개념 백지 사진 채점 (cb-scan-ship): 서버 전용. DB 먼저, 코드 나중에 배포.
# ANTHROPIC_API_KEY는 기존 studio-ai 서버 키를 사용한다. 시험에서는 실제 전송 금지.
# unset/on = 켜짐; off/그 밖의 값 = 꺼짐.
CONCEPT_BLANK_SCAN_ENABLED=on
CONCEPT_BLANK_SCAN_MODEL=claude-opus-5-5
# 비우면 읽기 모델과 같음. 등록된 2026-11-03 단가: opus/sonnet/haiku 5.5.
CONCEPT_BLANK_SCAN_GRADE_MODEL=
CONCEPT_BLANK_SCAN_EFFORT=high
# 읽기+채점 서비스 전체 월 합계(USD, UTC 시작 월). 0이면 유료 호출 안 함.
# 실제 전송 픽셀·UTF-8 글 바이트+최대 출력으로 선예약. 사용량 불명은 예약 전액으로 확정 정산.
# DB 저장소·비공개 버킷 준비 전에는 off로 둔다. 운영 키나 비밀을 이 파일에 넣지 않는다.
CONCEPT_BLANK_SCAN_MONTHLY_USD_CAP=100
# 서비스 전체 동시 유료 호출 수. 넘으면 DB FIFO 대기. 양의 정수.
CONCEPT_BLANK_SCAN_MAX_CONCURRENT=4
# Server-only private photo storage (DB migration first; create a PRIVATE bucket separately).
# Reuse this app's Supabase project and server secret; never put a service credential in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT may be supplied as SUPABASE_SERVICE_ROLE_KEY instead.
CONCEPT_BLANK_SCAN_STORAGE_BUCKET=concept-blank-scan-private
# Existing cron bearer secret: scan queue cron (each minute) and photo purge cron.
CRON_SECRET=
