# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Supabase 전환 시: 커넥션 풀러(pgbouncer, 6543 포트)를 우회하는 직결 URL — 마이그레이션 전용.
# 로컬 Docker 개발 환경에서는 DATABASE_URL과 동일한 값을 사용.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app

# Auth.js — AUTH_SECRET 없으면 로그인 시 Server error (MissingSecret)
# 로그인 수단은 이메일/비밀번호뿐이다(소셜 로그인 제거 2026-08-14).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# DeepSeek API — 문제 생성/변형(모델: deepseek-v4-pro). 서버 환경변수로만 둔다.
DEEPSEEK_API_KEY=your-api-key-here

# 공유 Supabase에 classified 문항을 공용 풀로 넣을 때만 1. 평소에는 두지 말 것.
# ALLOW_SHARED_IMPORT=1

# 자료 제작 AI — /dev/unified 에서 구독 CLI / 서버 모델 API 선택.
# /studio 는 로그인한 사용자의 모델 API만 제공한다. production CLI는 비활성화.
# 실제 값은 .env.development.local 또는 배포 서버 환경에만 설정한다.
# DEV_AI_MODE=subscription-cli
# DEV_AI_PROVIDER=claude
# DEV_AI_CODEX_HOME=C:/absolute/path/to/already-authenticated/profile
# API 자동 배정: Gemini OCR·도형 검수 / DeepSeek 해설 / Anthropic 도형 생성.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY 는 위 항목 사용. 모든 키는 서버 전용이며 NEXT_PUBLIC_ 금지.
# 선택 사항: docs/dev-subscription-ai.md 및 src/lib/studio-ai/routing.ts의 허용 모델.
# STUDIO_AI_GEMINI_MODEL=gemini-3.8-flash
# STUDIO_AI_DEEPSEEK_MODEL=deepseek-v4-pro
# STUDIO_AI_ANTHROPIC_MODEL=claude-opus-5
# STUDIO_AI_OPENAI_MODEL=gpt-5.5
# 로컬 PDF/도형 비교는 설치된 Chrome/Edge를 자동 탐색한다. 필요할 때만 지정.
# PDF_CHROMIUM_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Python 도형/HWPX 엔진: Vercel은 같은 배포의 /api/mathgen-engine 자동 사용.
# 다른 호스트의 엔진을 지정할 때만 신뢰할 서버 주소를 설정한다(브라우저 입력 불가).
# STUDIO_ENGINE_URL=https://your-engine.example
# STUDIO_ENGINE_SECRET=optional-dedicated-secret
# 생략 시 AUTH_SECRET을 내부 서명에 사용. 별도 서버라면 양쪽 값이 같아야 한다.
# Vercel 배포 보호를 켰다면 서버 환경의 VERCEL_AUTOMATION_BYPASS_SECRET도 필요.

# eywa 연계의 소유자 계정 — 이 이메일의 세션만 「지금 가져오기」(POST /api/eywa-sync)를 부를 수 있고
# 메인의 「오늘의 확인테스트」(eywa) 섹션을 본다. 비어 있으면 아무도 소유자가 아니다(2026-09-07).
EYWA_SYNC_OWNER_EMAIL=

# eywa 자동 로그인(SSO, D-139) — eywa 와 같은 값. 32바이트 이상 무작위. 비었거나 16자 미만이면 기능 꺼짐.
# eywa 가 서명한 60초 표로 **같은 이메일의 기존 계정만** 로그인한다(가입 없음). GET /api/sso/eywa?token=...
EYWA_SSO_SECRET=
# 선택 — 쉼표로 가른 eywa 지점(tenant) id. 넣으면 그 지점의 표만 받는다. 비었으면 모든 지점.
EYWA_SSO_TENANT_IDS=
