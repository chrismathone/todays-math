// Prisma schema — 오늘의수학 (testautocreator)
// 참조: docs/planning/04-database-design.md (ERD, 9개 엔티티)
//       docs/planning/02-trd.md §2.2 (Prisma + Zod + Auth.js)
//       docs/planning/07-coding-convention.md §2.2 (네이밍: 모델 PascalCase / 컬럼 camelCase → DB snake_case)
//
// 네이밍 규칙: 모델/필드는 Prisma Client 관례(PascalCase/camelCase)를 따르고,
// @map/@@map으로 실제 DB 컬럼·테이블명을 snake_case로 매핑한다.
// 예외: Account 모델의 OAuth 토큰 필드(refresh_token 등)는 @auth/prisma-adapter 표준 스키마가
// 정확한 필드명을 요구하므로 그대로 snake_case 식별자를 사용한다 (아래 주석 참조).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase 전환 시 커넥션 풀러(pgbouncer) 우회용 직결 URL.
  // 로컬 개발에서는 DATABASE_URL과 동일 값을 사용해도 무방.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────

/// 문제 출처 — D-04
enum ProblemSource {
  manual // 자작
  past_exam // 기출
  transformed // 변형
  ai_generated // AI 생성
  /// 교과서 — 출판사가 교과서에 딸려 낸 평가 · 수업 자료에서 옮긴 것 (D-161, 2026-10-07).
  /// 이름이 `textbook` 이 아닌 까닭: 이 저장소에서 그 낱말은 이미 «교재»(자체 교재 제작 `Textbook*` ·
  /// RPM 문제집 스크립트)를 가리킨다. 책 · 자료는 `SourceMaterial` 이 말한다.
  /// 🔴 enum 값은 한번 넣으면 못 뺀다 — 그리고 이 값을 모르는 옛 Prisma 클라이언트는 이 행을 읽다 죽는다.
  school_textbook // 교과서

  @@map("problem_source")
}

/// 난이도 — **하나뿐인 축** (D-106, 원장님 확정 2026-08-25). 사다리 순서대로 적는다.
///
/// 이름이 곧 값이다 — 지면·반 프리셋·상담에서 같은 말을 쓰므로 매핑이 없다(D-71 과 같은 뜻).
/// 예전 `easy/mid/hard` 는 `20260825120000_difficulty_four_tier` 가 **이름만** 바꿨다
/// (기본/응용/심화). 행은 한 줄도 UPDATE 되지 않았고 `연산` 은 새 밑단이라 옛 행이 없다.
enum Difficulty {
  연산
  기본
  응용
  심화하
  심화중
  심화상

  @@map("difficulty")
}

/// 문제 검수 상태 — D-22 (pending → approved 승격 후 출제)
enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

/// 시험지 유형 — 일일 / 확인
enum TestType {
  daily
  review

  @@map("test_type")
}

/// 시험지 상태 흐름 — draft → confirmed → printed
enum TestStatus {
  draft
  confirmed
  printed

  @@map("test_status")
}

/// 채점 방식 — 한 채점 기록이 **어떻게 들어왔는가**. D-134 트랙 1(19 §5′ A안).
///
/// 🔴 두 방식이 담는 것이 다르다. 가르지 않으면 서로를 오염시킨다 —
///    `marks` 는 `ProblemAnswer.selectedChoice`·`essayScore` 가 **전부 NULL** 인데,
///    기존 채점 규칙은 그 둘이 NULL 이면 **미답 → 오답 0점**으로 읽는다.
enum GradingMode {
  /// 원장님이 **틀린 번호만** 표시했다(`POST /api/tests/{id}/grade`). 정오만 참이고 응답은 없다.
  marks
  /// 응답을 **전량 전사**해 자동 채점했다(기존 `POST /api/tests/{id}/submit`). 기본값.
  answers

  @@map("grading_mode")
}

/// 문제 풀 — D-31. 기본 shared. private는 소유자만 조회.
enum ProblemPool {
  shared
  private

  @@map("problem_pool")
}

/// 신고 사유. **기계 키**다 — 한글 문구를 키로 쓰면 문구를 다듬는 순간 지난 기록이 갈라진다.
enum ReportReason {
  figure // 그림이 이상하다
  content // 문제가 이상하다
  answer // 답이 틀렸다
  solution // 해설이 없다·틀렸다
  unit // 단원이 틀렸다
  other // 기타 — 설명이 있어야 받는다

  @@map("report_reason")
}

enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

/// 해설이 어디서 왔나. `original` 과 `ai` 를 **반드시** 갈라 둔다 —
/// 안 갈라 두면 틀린 AI 해설이 「원래 그랬던 것」이 된다.
enum SolutionSource {
  none // 해설이 없다
  original // 원본에 있던 것(교재·기출·자작)
  ai // 우리가 AI 로 만들었다

  @@map("solution_source")
}

enum UserRole {
  director // 원장 — 지금까지의 모든 계정
  reviewer // 검수 전용 — 문제은행을 보고 신고만 한다

  @@map("user_role")
}

enum AccountApproval {
  pending
  approved
  rejected

  @@map("account_approval")
}

enum BranchRole {
  owner
  manager
  teacher

  @@map("branch_role")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  disabledMenus String[] @default([]) @map("disabled_menus")
  menuRevision Int @default(1) @map("menu_revision")
  users     User[]
  sharedDocuments WorkspaceDocument[]

  examPublications ExamPublication[]

  examReports ExamReportDraft[]
  @@map("branch")
}

// ─────────────────────────────────────────────
// FEAT-0: 사용자 (강사) — 04 §2.1
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  /// 이메일 가입 시만 값 존재 (bcrypt 해시). 구글 로그인은 NULL
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(50)
  /// Auth.js(@auth/prisma-adapter) 표준 필드 — OAuth 이메일 인증 시각
  emailVerified     DateTime? @map("email_verified")
  /// Auth.js 표준 필드 — OAuth 프로필 이미지 (최소 수집 원칙과 무관, 로그인 부가 정보)
  image             String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// Soft delete — 탈퇴 후 30일 뒤 배치로 Hard delete (04 §4)
  deletedAt         DateTime? @map("deleted_at")
  suspendedAt       DateTime? @map("suspended_at")
  manualSuspendedAt DateTime? @map("manual_suspended_at")
  authSource        String    @default("local") @map("auth_source") @db.VarChar(20)
  sessionVersion    Int       @default(0) @map("session_version")
  /// eywa 자동 로그인(D-139 ⑹) — eywa `users.id`(표의 `sub`). 계정 주인이 비밀번호로 로그인한 뒤
  /// 확인 화면에서 [연결]을 눌러야만 채워진다. 🔴 이메일로 채우지 않는다(eywa 이메일은 본인 확인 값이 아니다)
  eywaUserId        String?   @unique @map("eywa_user_id") @db.Uuid
  eywaLinkedAt      DateTime? @map("eywa_linked_at")

  classes             Class[]
  classMemberships    ClassMembership[]
  eywaManagedAccounts EywaManagedAccount[]
  problems            Problem[]
  tests               Test[]
  /// '오늘의 시험' 예측 실행 기록 (트랙 E)
  predictionRuns      PredictionRun[]
  accounts            Account[]
  sessions            Session[]
  /// 담기 바구니 (문제은행에서 고른 문항)
  basketItems         BasketItem[]

  /// 계정 역할. 기본값은 director — 기본값이 reviewer 면 기존 계정이 조용히 권한을 잃는다.
  role                   UserRole              @default(director)
  isAdmin                Boolean               @default(false) @map("is_admin")
  /// 전체 계정·서비스 관리는 최고관리자만. isAdmin 은 지점 운영 권한이다.
  isSuperAdmin           Boolean               @default(false) @map("is_super_admin")
  branchId               String?               @map("branch_id") @db.Uuid
  branchRole             BranchRole?           @map("branch_role")
  branch                 Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Existing accounts retain access; the signup API explicitly creates pending accounts.
  approvalStatus         AccountApproval       @default(pending) @map("approval_status")
  disabledMenus          String[]              @default([]) @map("disabled_menus")
  workspaceDocuments     WorkspaceDocument[]
  workspaceAssets        WorkspaceAsset[]
  auditEvents            AccountAuditLog[]     @relation("auditSubject")
  auditActions           AccountAuditLog[]     @relation("auditActor")
  reportsFiled           ProblemReport[]       @relation("reporter")
  reportsResolved        ProblemReport[]       @relation("resolver")
  reviewLogs             ProblemReviewLog[]    @relation("reviewer")
  /// 오늘의 개념 강의를 만든 사람 (D-123 ⑥′) — 강의는 공용 목록이라 «소유»가 아니라 기록이다
  conceptLecturesCreated ConceptLecture[]      @relation("conceptLectureCreator")
  /// 이 원장이 발급한 학생 로그인 계정 (D-124 ⑷) — 계정을 지우면 발급자 칸만 비워진다
  studentAccountsIssued  StudentAccount[]      @relation("studentAccountIssuer")
  /// 이 계정의 요청이 거절·실패한 기록 (오류 기록 표) — 계정을 지우면 기록은 남고 이 칸만 빈다
  errorLogs              ErrorLog[]
  /// 오늘의 영어 — 학교별 내신 시험(D-148). 학원 운영 데이터 — 계정을 지우면 시험과 딸린 자료·세트가 같이 지워진다
  englishExams           EnglishExam[]
  /// 교재 제작 — 이 계정의 책. 🔴 RESTRICT — 책이 있는 계정은 지워지지 않는다(인쇄된 QR 이 그 행에 달려 있다)
  textbooks              Textbook[]
  englishPassages        EnglishPassage[]
  englishPassageReceipts EnglishPassageReceipt[]
  listeningSets          EnglishListeningSet[]

  /// 월말평가 M1 — 반에 낸 시험지의 고정본(2026-10-17)
  examPublications ExamPublication[]

  examReports         ExamReportDraft[]
  examReportConfirmed ExamReportArtifact[] @relation("ExamReportConfirmer")
  @@map("user")
}

/// Private worksheets and extraction sessions; all reads and writes include userId.
model WorkspaceDocument {
  userId    String   @map("user_id") @db.Uuid
  id        String   @db.VarChar(100)
  kind      String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  payload   Json     @db.JsonB
  problemCount Int  @default(0) @map("problem_count")
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility String @default("private") @db.VarChar(20)
  sharedBranchId String? @map("shared_branch_id") @db.Uuid
  sharedBranch Branch? @relation(fields: [sharedBranchId], references: [id], onDelete: Restrict)
  assets WorkspaceDocumentAsset[]

  @@id([userId, id])
  @@index([userId, kind, updatedAt])
  @@index([sharedBranchId, visibility, updatedAt])
  @@map("workspace_document")
}

/// Files require the owner session or an explicitly shared document's current scope.
model WorkspaceAsset {
  userId    String   @map("user_id") @db.Uuid
  id        String   @db.VarChar(100)
  name      String   @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  bytes     Bytes
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents WorkspaceDocumentAsset[]

  @@id([userId, id])
  @@map("workspace_asset")
}

/// Only explicitly referenced assets inherit a document's current read scope.
model WorkspaceDocumentAsset {
  userId String @map("user_id") @db.Uuid
  documentId String @map("document_id") @db.VarChar(100)
  assetId String @map("asset_id") @db.VarChar(100)
  document WorkspaceDocument @relation(fields: [userId, documentId], references: [userId, id], onDelete: Cascade)
  asset WorkspaceAsset @relation(fields: [userId, assetId], references: [userId, id], onDelete: Cascade)

  @@id([userId, documentId, assetId])
  @@index([userId, assetId])
  @@map("workspace_document_asset")
}

model AccountAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  outcome   String   @db.VarChar(20)
  details   Json     @default("{}") @db.JsonB
  eventId   String?  @unique @map("event_id") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  user User? @relation("auditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@map("account_audit_log")
}

// ─────────────────────────────────────────────
// FEAT-4: 반 — 04 §2.6
// ─────────────────────────────────────────────

model Class {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  name               String              @db.VarChar(100)
  grade              String              @db.VarChar(10)
  branchId           String?             @map("branch_id") @db.Uuid
  eywaBindingId      String?             @map("eywa_binding_id") @db.Uuid
  permissionRevision BigInt              @default(0) @map("permission_revision")
  active             Boolean             @default(true)
  closedAt           DateTime?           @map("closed_at")
  memberships        ClassMembership[]
  enrollments        StudentEnrollment[]

  /// eywa `classes.id` — 진도 연계의 매칭 키. NULL 이면 연계 밖의 반(수동·demo).
  /// unique 는 (userId 무관) 전역 — 같은 eywa 반이 두 원장 계정에 복제되는 일은
  /// 이 제품 범위에 없다(원장 1명).
  eywaClassId         String?  @unique @map("eywa_class_id") @db.Uuid
  /// 기본 문항 수 (기본값 8)
  defaultProblemCount Int      @default(8) @map("default_problem_count")
  /// 난이도 배분 — 예: {"easy":3,"mid":4,"hard":1}
  /// 기본값은 DB가 아닌 앱(계약) 레벨에서 적용 (04 §2.6)
  difficultyRatio     Json     @map("difficulty_ratio") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                 User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  students             Student[]
  listeningAssignments EnglishListeningAssignment[]
  progresses           Progress[]
  tests                Test[]
  /// 진도 계획 — 반 계획 한 줄 + 개별 진도 학생의 학생 계획들(D-129 ⑴)
  progressPlans ProgressPlan[]
  /// 교재 배정 — 이 반에 건 판본(반을 지우면 같이 지워진다)
  textbookAssignments TextbookAssignment[]

  @@index([userId])
  @@map("class")
}

// ─────────────────────────────────────────────
// FEAT-4: 학생 — 04 §2.6 (최소 수집: 이름만)
// ─────────────────────────────────────────────

/// eywa 동기화 실행 기록 — 화면의 「마지막 동기화 · 미분류 N줄」 스트립이 읽는다.
/// 원장 파일(scripts/sync/ledgers)은 되돌리기용이고, 이건 **보여 주기용**이다 —
/// 파일은 production 웹서버가 못 읽는다(같은 저장소·다른 기계).
model EywaSyncRun {
  id              String   @id @default(uuid()) @db.Uuid
  ranAt           DateTime @default(now()) @map("ran_at")
  transport       String   @db.VarChar(8)
  students        Int
  classes         Int
  progressRows    Int      @map("progress_rows")
  unresolvedLines Int      @map("unresolved_lines")
  ambiguous       Int
  examOnly        Int      @map("exam_only")

  @@index([ranAt])
  @@map("eywa_sync_run")
}

/// eywa 동기화 **되돌리기 원장** — 적용 전에 before 전량을 남긴다(JSON).
/// CLI 는 파일(scripts/sync/ledgers)에도 남기지만, 서버(「지금 가져오기」)는
/// 파일시스템이 없어(서버리스 read-only) 이 표가 유일한 원장이다.
/// 회차별 행이라 덮어쓰기가 구조적으로 없다(2026-08-20 교훈). 오래된 것은
/// 동기화가 최근 14회만 남기고 지운다.
model EywaSyncLedger {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  payload   Json

  @@index([createdAt])
  @@map("eywa_sync_ledger")
}

model Student {
  id                    String              @id @default(uuid()) @db.Uuid
  classId               String              @map("class_id") @db.Uuid
  branchId              String?             @map("branch_id") @db.Uuid
  eywaBindingId         String?             @map("eywa_binding_id") @db.Uuid
  sourceStatus          String?             @map("source_status") @db.VarChar(40)
  isTest                Boolean             @default(false) @map("is_test")
  enrollments           StudentEnrollment[]
  name                  String              @db.VarChar(50)
  /// Registered contact's final four digits; used only when a manager explicitly issues an account.
  /// A full phone number is never copied from Eywa.
  phoneLast4            String?             @map("phone_last4") @db.Char(4)
  useIndividualProgress Boolean             @default(false) @map("use_individual_progress")

  /// eywa `students.id` — 진도 연계의 유일한 매칭 키. **이름 매칭 금지**
  /// (eywa 스스로 「이름-only 매칭 금지, 동명이인 fan-out」이라 못 박아 뒀다).
  /// NULL 이면 이 연계 밖의 학생(수동 등록·demo). unique 라 같은 eywa 학생이
  /// 두 번 만들어지지 않는다.
  eywaStudentId String? @unique @map("eywa_student_id") @db.Uuid

  /// 대사(reconciliation) 표시 — 동기화가 «받은 수 == total» 검증에 성공했는데
  /// roster 에 이 학생이 없으면 여기에 시각을 적는다(퇴원·수학반 이탈).
  /// 지우지 않는 이유: 시험 이력이 딸려 있다. 되돌아오면 NULL 로 푼다.
  eywaWithdrawnAt DateTime? @map("eywa_withdrawn_at")

  /// 마지막 eywa 수업보고서의 날짜·원문 (D-64). 시험기간(내신대비·모의고사)만
  /// 적힌 날은 진도 행이 안 생기므로, «오늘 수업했는데 자동 출제에서 빠진 학생»을
  /// 화면이 보여 주려면 진도와 별도로 이 둘이 필요하다. 동기화가 덮어쓴다.
  eywaLastReportDate DateTime? @map("eywa_last_report_date") @db.Date
  eywaLastReportText String?   @map("eywa_last_report_text")

  /// 재학 학교 — '오늘의 시험' 예측 대상을 정한다(트랙 E).
  /// 표기는 eywa `school-name.ts` 규칙으로 정규화해 넣는다("경명여자중학교" → "경명여중").
  schoolName  String? @map("school_name") @db.VarChar(50)
  /// "초" | "중" | "고". 내신 예측 대상 여부는 별도의 시험 정책에서 판정한다.
  schoolLevel String? @map("school_level") @db.VarChar(2)
  schoolGrade Int?    @map("school_grade")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class               Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  listeningTargets    EnglishListeningTarget[]
  listeningAttempts   EnglishListeningAttempt[]
  progresses          Progress[]
  tests               Test[]
  testResults         TestResult[]
  /// '오늘의 시험' 실측 내신 점수 — 보정 루프의 입력(트랙 E)
  actualExamScores    ActualExamScore[]
  /// 오늘의 개념 시청 기록 (D-123 ⑥′) — 한 강의에 한 행
  conceptLectureViews ConceptLectureView[]
  /// 오늘의 개념 학생 로그인 계정 (D-124 ⑶) — 없으면 아직 발급 전. 학생을 지우면 같이 지워진다
  studentAccount      StudentAccount?
  /// 진도 계획 — 개별 진도 학생일 때만 반 계획을 덮는다(D-129 ⑴). 없으면 반 계획을 쓴다
  progressPlans       ProgressPlan[]
  /// Generated daily practice is independent of scored exams and private teacher worksheets.
  srsState            StudentSrsState?
  /// «오늘의 기억» 하루 분량 — 행이 없으면 서비스 기본(2026-10-17)
  fadingPolicy        FadingStudentPolicy?
  /// «오늘의 기억» 추가 확인이 하루 상한에 닿은 날 — «분량 점검 필요» 신호의 근거
  fadingCapDays       FadingRelearnCapDay[]
  /// 교재 배정 — 이 학생 하나에게 건 판본
  textbookAssignments     TextbookAssignment[]
  /// 교재 개념의 백지 활동 — 학생을 지우면 그 글도 같이 지워진다
  textbookConceptAttempts TextbookConceptAttempt[]

  examReports ExamReportDraft[]
  @@index([classId])
  @@map("student")
}

/// One atomic practice state per real student. Revision compare-and-swap prevents lost answers.
/// Installed by the isolated, rollback-verified SRS migration tool on 2026-09-23.
model StudentSrsState {
  studentId String   @id @map("student_id") @db.Uuid
  revision  Int      @default(1)
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_srs_state")
}

/// «오늘의 기억» 학생별 하루 분량 (원장님 결정 2026-10-17 · `src/lib/fading/quota.ts`).
/// 학생 기록 JSON 밖에 둔다 — 학생이 풀 때마다 바뀌는 revision 과 부딪히지 않고, 엄격한 학생 기록 계약의 되돌림 하한을 옮기지 않는다.
/// 바꾼 값은 다음 한국 날짜(`effective_on`)부터 먹는다 — 그 전날까지는 `previous_quota`. 둘 다 NULL 이면 서비스 기본.
model FadingStudentPolicy {
  studentId     String   @id @map("student_id") @db.Uuid
  quota         Int?     @db.SmallInt
  previousQuota Int?     @map("previous_quota") @db.SmallInt
  effectiveOn   DateTime @map("effective_on") @db.Date
  /// 교사 화면의 덮어쓰기 막기 — 저장할 때 견준다.
  revision      Int      @default(1)
  /// 바꾼 계정(감사 기록에도 남는다). 계정이 지워져도 행은 남도록 외래 키를 걸지 않는다.
  updatedById   String?  @map("updated_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("fading_student_policy")
}

/// «오늘의 기억» 추가 확인이 하루 상한(30회)에 닿은 한국 날짜 — 학생 하나에 하루 한 행. 학생 라우트가 닿은 그때 적는다.
/// 학생 기록 JSON 의 하루치 집계로는 지난 날을 되살릴 수 없어 따로 둔다(합의 §3).
model FadingRelearnCapDay {
  studentId String   @map("student_id") @db.Uuid
  on        DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, on])
  @@map("fading_relearn_cap_day")
}

// ─────────────────────────────────────────────
// FEAT-1: 교육과정 단원 (기준 데이터) — 04 §2.2
// ─────────────────────────────────────────────

model Unit {
  id                String @id @default(uuid()) @db.Uuid
  grade             String @db.VarChar(10)
  chapter           String @db.VarChar(100)
  section           String @db.VarChar(100)
  /// 교육과정 순서 — 진도 "다음으로" 이동, 확인테스트 범위 계산의 기준
  orderIndex        Int    @map("order_index")
  /// 이 단원에서 만들어지는 문항 코드의 «뜻» 부분 (D-53). 예: `J30501` · `HC10201`.
  /// 규칙은 `src/lib/problemCode.ts` 한 곳에만 있고, 이 컬럼은 그 산출물이다 —
  /// DB 트리거는 `prefix || '-' || 무작위4` 만 한다(SQL 에 규칙을 두지 않으려고).
  /// ⚠️ 이 값이 바뀌어도 **이미 부여된 문항 코드는 안 바뀐다**(스냅샷). 새로 들어오는
  ///    문항만 새 앞부분을 받는다.
  problemCodePrefix String @unique @map("problem_code_prefix") @db.VarChar(8)
  /// 이 차시를 배우는 학기 — 1 | 2 (D-161). 고등 선택 과목처럼 학교마다 다른 것은 NULL.
  /// 문항의 «학기»는 따로 적지 않는다 — 문항의 차시가 말한다(기출 · 엔진 · 교과서가 같은 값을 본다).
  /// 원천은 `prisma/seed-data/units.ts` 의 `semesterOfUnit` 한 곳이다.
  semester          Int?   @db.SmallInt

  progresses     Progress[]
  problems       Problem[]
  examQuestions  ExamQuestion[]
  testRangeStart Test[]          @relation("TestRangeStartUnit")
  testRangeEnd   Test[]          @relation("TestRangeEndUnit")
  /// 진도 계획의 시작 차시 (D-129 ⑴)
  progressPlanStarts ProgressPlan[] @relation("ProgressPlanStartUnit")
  problemFamily  ProblemFamily[]
  /// 오늘의 개념 강의 (D-123 ⑥′) — 강의가 붙는 자리는 차시다(수맥은 개념)
  conceptLectures ConceptLecture[]

  @@index([grade, orderIndex])
  @@map("unit")
}

// ─────────────────────────────────────────────
// 오늘의 개념 — 차시별 자체 제작 개념 강의 (D-123 ⑥′, 2026-09-15)
// ⚠️ 미적용 초안 — 마이그레이션 20260915150000_concept_lecture 는 원장님 확인 전 적용 금지.
//    계약 SSOT: src/contracts/conceptLecture.contract.ts · 계획: docs/planning/21-todays-concept.md
// ─────────────────────────────────────────────

/// 강의 상태. 초안은 학생에게 안 보인다. **게시는 사람 버튼**(게시 관문 `src/lib/concept/publishGate.ts`).
enum ConceptLectureStatus {
  draft
  published
  archived

  @@map("concept_lecture_status")
}

/// 차시(`Unit`)에 붙는 개념 강의 영상 한 편. **서비스 공용 목록**(D-31 공용 풀과 같은 결) —
/// 소유(`userId`) 칸이 없고 쓰기는 `isAdmin` 만. 종류는 영상 하나(D-123 ⑵).
///
/// SQL 에만 있는 것(Prisma 가 표현 못 함 — 마이그레이션 참조):
///   게시면 주소 있음 · 공백 고지·공백 잡 ID 금지 · 길이 0 이상 · 순서 0~999
model ConceptLecture {
  id          String               @id @default(uuid()) @db.Uuid
  unitId      String               @map("unit_id") @db.Uuid
  title       String               @db.VarChar(200)
  /// 정규 watch 주소만(`normalizeYouTubeUrl`). **초안은 비어도 된다** — 호스팅 미정(21번 §5-3)
  videoUrl    String?              @map("video_url") @db.VarChar(200)
  /// 영상 길이(초). 0 = 아직 모름 — 게시 관문이 막는다
  seconds     Int                  @default(0)
  /// AI 고지 — 도구가 만든 강의(`sourceJobId` 있음)는 게시 전에 채워야 한다.
  /// **원장님 화면에만** 보인다(D-124 ⑹) — 학생에게 가는 모양(`conceptLectureForStudentSchema`)에 없다
  disclosure  String?              @db.VarChar(300)
  /// 제작 도구 잡 ID(meta.json `jobId`) — 등록 멱등 열쇠. unique 지만 NULL 은 여럿 된다(Postgres 기본)
  sourceJobId String?              @unique @map("source_job_id") @db.VarChar(120)
  sortOrder   Int                  @default(0) @map("sort_order")
  status      ConceptLectureStatus @default(draft)
  /// 원장님 끝까지 시청 확인 — **권장**이라 게시를 막지 않는다(D-124 ⑻, 게시 관문의 warnings)
  reviewedAt  DateTime?            @map("reviewed_at")
  publishedAt DateTime?            @map("published_at")
  createdById String?              @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  unit      Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy User?                @relation("conceptLectureCreator", fields: [createdById], references: [id], onDelete: SetNull)
  views     ConceptLectureView[]

  @@index([unitId, status, sortOrder])
  @@map("concept_lecture")
}

/// 학생 × 강의 시청 기록 — **한 학생 × 한 강의 = 한 행**(수맥 `learner_material_progress_uq`).
/// 쓰는 규칙은 `mergeWatchRecord` 한 곳(뒤로 안 간다 · 한 번 완료면 완료).
model ConceptLectureView {
  studentId   String    @map("student_id") @db.Uuid
  lectureId   String    @map("lecture_id") @db.Uuid
  /// 본 최대 지점(초)
  maxSeconds  Int       @default(0) @map("max_seconds")
  /// 0–100
  percent     Int       @default(0)
  /// 처음 완료한 시각 — 한 번 찍히면 그대로
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecture ConceptLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@id([studentId, lectureId])
  @@index([lectureId])
  @@map("concept_lecture_view")
}

// ─────────────────────────────────────────────
// 오늘의 개념 — 학생 로그인 계정 (D-124 ⑶⑷ · D-125 ⑵⑶, 2026-09-15)
// ⚠️ 미적용 초안 — 마이그레이션 20260915180000_student_account 는 원장님 확인 전 적용 금지.
//    적용기: scripts/qa/apply-student-account-migration.ts (이 마이그레이션 하나만 · 드라이런 먼저)
//    계약 SSOT: src/contracts/studentAccount.contract.ts · 로그인 규칙: src/lib/learn/studentLogin.ts
// ─────────────────────────────────────────────

/// 학생 로그인 계정 — **학생 한 명에 하나**, 원장님이 한 명씩 발급한다(D-124 ⑷). 영상 시청 하나만
/// 연다(D-123 ⑵). 끄기는 `disabledAt` 만 찍고 **지우지 않는다**(수맥 규칙).
///
/// SQL 에만 있는 것(Prisma 가 표현 못 함 — 마이그레이션 참조): 아이디는 정규화된 모양 · 실패 수 0 이상
model StudentAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  studentId          String    @unique @map("student_id") @db.Uuid
  /// 정규화 뒤 저장(소문자 · 앞뒤 공백 없음 — `normalizeLoginId`). 형식 규칙은 계약 `STUDENT_LOGIN_ID_RULE`
  loginId            String    @unique @map("login_id") @db.VarChar(50)
  /// bcrypt 해시만. 🔴 **초기 비밀번호는 저장하지 않는다**(D-124 ⑷ — 발급 응답에 한 번만)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  /// 참이면 학생 관문이 비밀번호 바꾸기만 연다(첫 로그인 · 원장님이 다시 발급한 뒤)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// 발급한 원장 — 계정이 지워지면 비워진다(누가 발급했나는 감사 기록에 남는다)
  issuedById         String?   @map("issued_by_id") @db.Uuid
  issuedAt           DateTime  @default(now()) @map("issued_at")
  /// 학생이 **스스로** 번호를 바꾼 마지막 시각 — 원장님의 «다시 발급»은 여기 안 찍는다
  passwordChangedAt  DateTime? @map("password_changed_at")
  lastLoginAt        DateTime? @map("last_login_at")
  /// 끔 — 찍히면 다음 요청에서 세션이 끊긴다(`src/lib/auth.ts` 가 요청마다 이 행을 다시 읽는다)
  disabledAt         DateTime? @map("disabled_at")
  /// 연속 실패 수 — 성공하면 0 (D-125 ⑶, `STUDENT_LOGIN_LOCK`)
  failedCount        Int       @default(0) @map("failed_count")
  /// 이 시각까지 잠김 — 잠긴 동안은 맞는 번호도 거부한다
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User?   @relation("studentAccountIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("student_account")
}

/// **없는 아이디**로 들어온 로그인 실패 수 — 잠금 문구가 아이디 존재를 흘리지 않게(D-125 ⑶ · 브리프 §6
/// «잠금 문구도 없는 아이디에 똑같이»). 있는 계정은 `StudentAccount.failedCount` 에 센다.
/// 열쇠는 정규화한 아이디의 HMAC-SHA256(AUTH_SECRET) — 🔴 **입력한 글자를 그대로 적지 않는다**
/// (학생이 번호를 아이디 칸에 적는 실수가 평문으로 남지 않게). 소유 칸이 없다 — 누구의 것도 아니다.
model StudentLoginMiss {
  keyHash     String    @id @map("key_hash") @db.Char(64)
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("student_login_miss")
}

/// **단원 안의 문항류 대장** (D-105, 2026-08-25). 문항 코드의 `A01` 자리가 여기서 나오고
/// 아류 번호(`-001`)도 여기서 센다.
///
/// ⚠️ `nextSeq` 를 이 표에 두는 이유: 문항 표를 세어 번호를 매기면 **동시에 두 건이
///    들어올 때 같은 번호**를 받는다. `UPDATE … RETURNING` 은 행 잠금이라 안 겹친다.
///    부여는 전부 `problem_family_take()` 한 곳을 지난다.
model ProblemFamily {
  unitId     String   @map("unit_id") @db.Uuid
  /// 엔진이 적는 유형 정체. `Problem.familyKey` 와 같은 값이다.
  familyKey  String   @map("family_key")
  /// `A01`~`Z99`. 글자는 «비슷한 문항류를 한 무리로 묶는» 자리다(원장님 의도).
  familyCode String   @map("family_code") @db.Char(3)
  /// 다음에 줄 아류 번호. 1부터.
  nextSeq    Int      @default(1) @map("next_seq")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@id([unitId, familyKey])
  @@unique([unitId, familyCode])
  @@map("problem_family")
}

// ─────────────────────────────────────────────
// FEAT-4: 진도 기록 — 04 §2.6
// ─────────────────────────────────────────────

model Progress {
  retiredAt DateTime? @map("retired_at")
  id         String   @id @default(uuid()) @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  /// NULL이면 반 전체 진도, 값이 있으면 해당 학생 개별 진도
  studentId  String?  @map("student_id") @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  /// 기록일 (날짜만 — 시각 불필요)
  recordedAt DateTime @map("recorded_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  /// eywa `lesson_reports.id` — 이 행이 어느 수업보고서에서 왔나.
  /// 동기화는 **전량 재동기화**라(85.6% 가 수업일 이틀 뒤 이후 작성 — 증분 기준이
  /// 없다) 이 키가 없으면 돌릴 때마다 같은 행이 또 생긴다.
  /// 한 보고서가 여러 단원을 가리킬 수 있어 (report, unit) 짝으로 unique.
  /// NULL 이면 연계 밖의 진도(화면에서 직접 기록).
  eywaReportId String? @map("eywa_report_id") @db.Uuid

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([eywaReportId, unitId])
  @@index([classId, recordedAt(sort: Desc)])
  @@index([studentId, recordedAt(sort: Desc)])
  @@map("progress")
}

/// 진도 **계획** — 규칙 한 줄이다 (D-129 ⑴, `docs/planning/22-daily-auto-test.md` §3).
///
/// 🔴 **날짜별 행을 쌓지 않는다.** 요일이 바뀌면 지난 행을 전부 고쳐 써야 하고, 그러면
///    「무엇이 계획이고 무엇이 기록인가」가 섞인다. 규칙을 날짜로 펴는 곳은 순수 함수
///    `src/lib/daily/progressPlan.ts` **한 곳**이다.
///
/// `student_id` 가 NULL 이면 **반 계획**, 값이 있으면 **그 학생 계획**이다 — `Progress` 의
/// 반/개별 이중 구조와 같은 모양이고, 덮어쓰는 조건도 같다(`Student.use_individual_progress`
/// 가 참일 때만 학생 계획이 반 계획을 이긴다 — `pickProgressPlan`).
///
/// ⚠️ 「반에 계획 하나 · 학생에 계획 하나」는 **부분 unique 인덱스**가 지킨다. Prisma 는 부분
///    인덱스를 표현하지 못해 마이그레이션의 «손으로 더한 것» 절에 있다.
model ProgressPlan {
  id        String  @id @default(uuid()) @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  /// NULL이면 반 계획, 값이 있으면 해당 학생 계획.
  /// 복수 수강 학생의 계획은 [classId, studentId]별 하나다.
  /// 반 계획(studentId NULL)은 기존 마이그레이션의 부분 unique 인덱스가 지킨다.
  studentId String? @map("student_id") @db.Uuid

  /// 수업 요일 — 0=일 … 6=토 (`Date.getUTCDay()` 와 같은 번호. 한국식 「월=1」이 아니다).
  /// 비어 있으면 수업일이 하나도 없다 — CHECK 가 막는다.
  weekdays       Int[]    @db.SmallInt
  /// 한 수업당 차시 수 (기본 1)
  unitsPerLesson Int      @default(1) @map("units_per_lesson")
  /// 시작 차시 — 교육과정 차례(order_index, D-27)의 출발점
  startUnitId    String   @map("start_unit_id") @db.Uuid
  /// 시작일 — 이 날 **이후 첫 수업일**에 시작 차시를 나간다
  startDate      DateTime @map("start_date") @db.Date
  /// 꺼 두면 자동 대상이 아니다 — 계획을 지우지 않고 멈추는 길
  active         Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// 차시는 지우지 못하게 막는다 — 계획이 가리키는 출발점이 사라지면 계획이 말을 잃는다
  startUnit Unit     @relation("ProgressPlanStartUnit", fields: [startUnitId], references: [id], onDelete: Restrict)

  @@index([classId])
  @@unique([classId, studentId])
  @@map("progress_plan")
}

/// 아침 8시 **자동 초안 회차 기록** (D-129 ⑶) — 한 회차가 무엇을 했나.
///
/// 표를 새로 두는 까닭: `eywa_sync_run` 은 **eywa 동기화의 칸**(받은 학생·반·미해결 줄)이고
/// 이번 트랙은 eywa 를 쓰지 않는다(D-129 ⑸ 보류). 남의 회차 표에 뜻이 다른 수를 끼워 넣으면
/// 화면의 「마지막 동기화」 스트립이 **안 돈 동기화를 돈 것으로** 읽는다.
model AutoDraftRun {
  id      String   @id @default(uuid()) @db.Uuid
  ranAt   DateTime @default(now()) @map("ran_at")
  /// 기준일(KST) — 「오늘」의 정의
  day     DateTime @db.Date
  /// 그날 대상이 된 학생 수
  targets Int
  /// 만든 초안 수
  created Int
  /// 건너뛴 수 — `skips` 의 길이와 같다
  skipped Int
  /// 학생별 건너뛴 까닭 — `[{ studentId, reason }]`. **조용히 빠지는 학생이 없게** 남긴다.
  /// 까닭의 SSOT 는 `src/contracts/dailyAutoTest.contract.ts` 의 `autoDraftSkipReasonSchema`.
  skips   Json     @db.JsonB

  /// 이 회차가 세운 시험지(D-133 ⑴) — `Test.autoDraftRunId` 의 역관계.
  ///
  /// 🔴 행은 **초안을 세우기 전에** 합계 0 으로 먼저 서고, 끝에서 합계를 고쳐 쓴다(`runAutoDraft`).
  ///    끝난 회차는 `created + skipped = targets` 다. 중간에 끊겼으면 — 이은 시험지가 없으면 행을 지우고,
  ///    있으면 거기까지의 합계를 적어 `created + skipped < targets` 로 남는다(보고서 plan-screen-followup ⑤-B).
  tests   Test[]

  @@index([ranAt])
  @@map("auto_draft_run")
}

// ─────────────────────────────────────────────
// FEAT-1, 5: 문제은행 — 04 §2.3
// ─────────────────────────────────────────────

model Problem {
  id String @id @default(uuid()) @db.Uuid

  /// **문항에는 소유자가 없다** (D-101, 원장님 확정 2026-08-24: 「소유자 필요없고 전체 공유」).
  ///
  /// 남겨 둔 이유는 «누가 넣었나»를 나중에 다시 쓸 수 있게 하기 위해서다 — 지금은 전부 NULL 이고
  /// 어떤 조회·권한도 이 값을 보지 않는다. 되살리려면 컬럼을 다시 채우면 되고 마이그레이션이
  /// 필요 없다.
  ///
  /// ⚠️ **`onDelete: SetNull` 이 핵심이다.** 예전에는 `Cascade` 라 **계정 하나를 지우면
  ///    Postgres 가 그 계정의 문항을 전부 같이 지웠다** — 47,006개가 한 계정에 매달려 있었다.
  ///    앱을 안 거치고 DB 가 직접 하는 일이라 코드로는 못 막는다. 다시 Cascade 로 돌리지 말 것.
  userId String? @map("user_id") @db.Uuid
  unitId String  @map("unit_id") @db.Uuid

  source          ProblemSource
  /// 변형 문제의 원본 참조 (원본 삭제 시 참조만 해제 — 변형본은 독립 자산으로 유지)
  originProblemId String?       @map("origin_problem_id") @db.Uuid

  difficulty        Difficulty
  /// 계산 / 개념 / 활용 / 서술형 — 확장 가능성 고려해 자유 문자열로 유지 (열거형 아님)
  problemType       String     @map("problem_type") @db.VarChar(20)
  /// 출제 형식 — 객관식 | 단답형 | 서술형.
  /// ⚠️ `problemType`(계산/개념/활용/서술형)과 **다른 축**이다. 섞지 말 것.
  /// mapProblemType 이 객관식→"개념" 으로 뭉개 원본 구분이 소실돼 있었다(11 §2.4).
  /// 청사진의 유형 배분(학교 고유성 51.1%)을 채우려면 이 컬럼이 필요하다.
  questionType      String?    @map("question_type") @db.VarChar(10)
  /// 문제 본문 — LaTeX 수식 포함 마크다운
  content           String     @db.Text
  answer            String     @db.Text
  solution          String?    @db.Text
  /// 문항에 딸린 도형 SVG (testchanger figure engine 산출물, inline 렌더).
  /// 원본 시험지의 그림을 대체한다 — 이미지 파일이 아니라 SVG 문자열로 보관해
  /// 인쇄·화면이 같은 벡터를 쓰고 해상도 손실이 없다. 참조: docs/planning/09-figure-engine-guide.md
  figureSvg         String?    @map("figure_svg") @db.Text
  /// 도형 출처: engine(엔진 작도) / image(외부 이미지 보정본) / source(원본 시험지 오려옴)
  figureSource      String?    @map("figure_source") @db.VarChar(20)
  /// 원본 시험지에서 오려 온 그림 파일 경로들 (`/figures/<examId>/qNN.jpg`).
  /// 완료본 PDF 에 그림이 **이미지로 심겨 있어** 다시 그릴 필요가 없다 —
  /// 원본을 그대로 오려 `public/figures/` 에 두고 여기에 경로만 적는다.
  /// 배열인 이유: 선택지마다 그림인 문항이 있다(실측 한 문항 최대 6장).
  /// 순서는 지면에 나온 순서다. 참조: docs/planning/09-figure-engine-guide.md
  figureUrls        String[]   @default([]) @map("figure_urls")
  /// `figureUrls` 와 **같은 순서**로 짝지은 원본 치수 `[w1,h1,w2,h2,…]` 평탄 배열.
  /// 인쇄 넘침 판정이 그림 높이를 계산하는 유일한 근거다 — 판정은 브라우저에서
  /// 돌아 이미지 파일을 읽을 수 없다(`src/lib/printOverflow.ts`).
  /// 길이가 `figureUrls.length × 2` 가 아니면 판정이 «모른다»로 받는다.
  /// 적재: `scripts/qa/backfill-figure-dimensions.ts`
  figureDims        Int[]      @default([]) @map("figure_dims")
  /// `figureUrls` 와 **같은 순서·같은 길이**로 짝지은 **원본 지면 물리 폭(mm)**.
  /// 「얼마로 그린다」의 유일한 근거다 — `figureDims` 는 **비율**만 알려 주고
  /// 크기는 안 알려 준다(같은 삼각형이 문항마다 다른 크기로 인쇄됐다).
  ///
  /// ⚠️ 값은 **원본 크기**이지 인쇄 폭이 아니다. 70mm 상한은 인쇄 시점 정책이라
  /// `figurePrintWidthMm` 이 건다 — 측정값과 정책을 같은 칸에 담으면 정책이 바뀔 때
  /// 이미 잘린 값만 남아 되돌릴 수 없다.
  /// ⚠️ **빈 배열 = «모른다»** 이고 그게 기본값이다. 모르면 지면은 오늘 그대로
  /// 픽셀로 그린다(회귀 0). 길이가 `figureUrls.length` 와 다르면 **통째로** 모른다.
  /// 규칙 한 곳: `src/lib/figurePrintSize.ts` · 적재: `scripts/qa/backfill-figure-source-mm.ts`
  figureSourceMm    Float[]    @default([]) @map("figure_source_mm")
  /// `figureUrls` 와 **같은 순서·같은 길이**로 짝지은 «이 그림은 몇 번 보기인가».
  ///   `0`      = 보기 그림이 아니다 (발문·자료 그림)
  ///   `1`~`10` = 그 번호의 보기 그림 (오늘 데이터는 1~5 뿐)
  ///
  /// ⚠️ **빈 배열 = «짝을 모른다»** 이고, 그게 기본값이다. 모르면 지면은
  /// **오늘 그대로** 그린다 — 그림을 한 덩어리로 놓고 보기 번호를 붙이지 않는다.
  /// 아무 그림이나 ①에 붙이면 안 된다: 지금은 «못 푸는 문항»이 눈에 보이지만,
  /// 틀린 짝은 **그럴듯해 보이면서 틀린다.** 그게 지금보다 나쁘다.
  ///
  /// 길이가 `figureUrls.length` 와 다르거나, 값이 범위를 벗어나거나, 0 이 아닌
  /// 번호가 **겹치면** 판정이 통째로 «모른다»로 받는다 — 반쪽은 안 받는다
  /// (`parseChoiceFigureIndex`, `figureDims` 와 같은 규약).
  /// 적재: `scripts/qa/apply-choice-figure-index.ts` · 근거: docs/planning/tracks/reports/choice-figures.md
  choiceFigureIndex Int[]      @default([]) @map("choice_figure_index")

  // ── 원본 역추적 메타데이터 (docs/planning/08-import-ledger.md) ──────────────
  // 추출기는 이 값들을 이미 갖고 있었는데 적재 단계가 버려서, 훼손·그림 문항을
  // 원본 시험지로 되짚을 수 없었다(2026-08-14). externalId는 재이관 멱등 키다.
  /// 원본 고유 키 (기출: `{exam_id}-{문항번호}`, RPM: 원본 행 id)
  externalId       String?      @unique @map("external_id") @db.VarChar(120)
  /// N드라이브 원본 파일 경로 (scripts/qa/nfile-inventory.txt.gz 기준 상대경로)
  sourceFile       String?      @map("source_file") @db.VarChar(500)
  school           String?      @db.VarChar(50)
  subject          String?      @db.VarChar(50)
  /// 시험 식별자 — 예: `2023-donmun-2-1`
  examId           String?      @map("exam_id") @db.VarChar(120)
  /// 원본 시험지에서의 문항 번호
  questionNumber   Int?         @map("question_number")
  /// 배점 (3, 3.5 등)
  score            Float?
  /// AI 생성물은 pending으로 시작, 검수 후 approved (D-22)
  reviewStatus     ReviewStatus @default(pending) @map("review_status")
  /// false면 출제 풀에서 제외하고 변형 원본으로만 쓴다.
  /// ⚠️ 원안 D-26(RPM 원본 잠금)은 **2026-08-14 폐지** — 원장님 지시로 전량 true.
  /// 새로 잠그려면 원장님 확인이 필요하다. 이관 변환기는 true 를 내보낸다.
  directUseAllowed Boolean      @default(true) @map("direct_use_allowed")
  /// 공용 풀이 기본 (D-31). private는 소유자만 조회.
  pool             ProblemPool  @default(shared)
  /// **이 문항이 어느 «문항류»인가** — 엔진이 적는 자기 유형 정체 (D-105, 2026-08-25).
  ///   중등 `mid:3-1|근호를 포함한 식의 계산|06`
  ///   초등 `elem:초6|2-5-1 원주와 원주율 알아보기|연산`
  /// 같은 키 = 같은 문항류 = 문항 코드의 같은 `A01` 자리. 그래서 **숫자만 바꾼 아류**가
  /// 자동으로 한 무리에 모이고 `-001`, `-002` 로 번호가 이어진다.
  ///
  /// ⚠️ 비면 **자기 혼자 한 무리**를 차지한다(`solo:<uuid>`, 트리거가 채운다).
  ///    번호 형식이 한 가지로 유지되게 하려는 것이다 — 나중에 「이건 저 무리」로 옮길 수 있다.
  familyKey        String?      @map("family_key")
  /// Proven same-task representations only; NULL preserves independent legacy rows.
  questionGroupKey String?      @map("question_group_key")
  /// 문항 코드 — 원장님이 문항을 **지목**하는 값 (D-53 · D-105). 예: `J30103-A01-001`.
  /// 옛 형식(`J31402-K7M2`, 무작위 4자)을 단 행이 45,374건 남아 있다 — 격리 대상이고
  /// freeze 트리거가 UPDATE 를 막으므로 영영 그대로다. CHECK 는 둘 다 받는다.
  ///
  /// ⚠️ **파생이 아니라 저장이다.** 뜻 부분은 부여 당시의 스냅샷이고 진실은 `unitId` 다.
  ///    단원이 재배정되면(관측 149건) 코드는 **그대로 두고** 화면이 현재 단원을 같이 보인다.
  ///    다시 계산하는 코드를 만들지 말 것 — DB 트리거(`problem_code_freeze`)가 UPDATE 를 막는다.
  ///
  /// 부여: `problem_code_assign` BEFORE INSERT 트리거. 앱·스크립트·psql 어느 경로든
  /// 자동으로 받는다(마이그레이션 `20260818210000_problem_code` 참조).
  problemCode      String       @unique @default(dbgenerated()) @map("problem_code") @db.VarChar(16)
  /// 이 문항이 실려 있던 **출처 자료** — 교과서 · 문제집의 자료 한 편 (D-161). 기출 · 엔진 · 자작은 NULL.
  /// 출판사 · 저자 · 자료 종류 · 교과서 단원 표기는 전부 이 줄을 타고 간다(문항에 글자로 베껴 두지 않는다).
  sourceMaterialId String?      @map("source_material_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  /// ⚠️ **SetNull 이다 — Cascade 로 되돌리지 말 것** (D-101). 위 `userId` 주석 참조.
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit                Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  originProblem       Problem?           @relation("ProblemOrigin", fields: [originProblemId], references: [id], onDelete: SetNull)
  transformedProblems Problem[]          @relation("ProblemOrigin")
  /// ⚠️ Restrict — 자료를 지우려면 그 자료의 문항부터 정리한다(출처를 모르는 문항이 조용히 생기지 않게).
  sourceMaterial      SourceMaterial?    @relation(fields: [sourceMaterialId], references: [id], onDelete: Restrict)
  testProblems        TestProblem[]
  problemAnswers      ProblemAnswer[]
  /// 해설 출처. AI 가 만든 해설은 사람이 「이 해설 쓴다」를 누르기 전까지
  /// `solution` 에 넣지 않는다(D-22 와 같은 결).
  solutionSource      SolutionSource     @default(none) @map("solution_source")
  reports             ProblemReport[]
  reviewLogs          ProblemReviewLog[]
  basketItems         BasketItem[]

  // 자동 출제 조회 핵심 인덱스
  @@index([unitId, difficulty, reviewStatus, directUseAllowed])
  @@index([userId, unitId])
  @@index([originProblemId])
  @@index([pool, unitId, reviewStatus, directUseAllowed])
  // 문제은행 목록 정렬 인덱스 — GET /api/problems 는 `createdAt desc, id desc` 로 정렬하고
  // 같은 where 로 count 까지 한 번 더 돈다. `created_at` 을 선두로 갖는 인덱스가 **하나도
  // 없어서**(마이그레이션 전수 대조 2026-08-17) 무필터 기본 진입이 47,152행 Seq Scan +
  // 정렬을 2회 유발했다. 정렬 키 순서(desc, desc)를 그대로 인덱스에 심어야 Sort 가 빠진다.
  //
  // ⚠️ `id desc` 를 빼면 안 된다 — 이관 배치는 createdAt 이 같은 행이 수천 건이라
  //    보조 키 없이는 페이지가 겹친다(route.ts 주석 참조). 인덱스도 그 순서를 따라간다.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // 단원 필터가 걸린 목록(문제은행 화면의 기본 사용법)이 같은 정렬을 그대로 탄다.
  @@index([unitId, createdAt(sort: Desc), id(sort: Desc)])
  // 검수 대기 목록 — reviewStatus 로 좁힌 뒤 최신순.
  @@index([reviewStatus, createdAt(sort: Desc)])
  // 「이 문항과 같은 류가 몇 개인가」 — 아류 묶어 보기(D-105).
  @@index([unitId, familyKey])
  @@index([questionGroupKey])
  @@index([unitId, questionGroupKey])
  // 「이 자료의 문항」 — 출판사 · 자료 종류로 거르는 조회가 자료 → 문항으로 내려온다(D-161).
  @@index([sourceMaterialId])
  @@map("problem")
}

// ─────────────────────────────────────────────
// 출처 책 · 출처 자료 — 교과서 · 문제집에서 옮긴 문항의 메타데이터 (D-161, 2026-10-07)
//
// 원장님 2026-10-07: 「출판사 학년 학기 단원 유형 등 모든 곳에 메타데이터가 있어야 문제은행을 이용하기 용이함」
// · 「근본 해결로 진행할것. 간단한 해결말고 미래를 본 해결 방법」.
//
//   SourceBook      책 한 권 — 「천재교육 · 중학 수학1 · 김동재 · 2022 개정」
//     └ SourceMaterial  그 책에 딸린 자료 한 편(파일 하나) — 「형성평가 1-1-1 1회」
//         └ Problem.sourceMaterialId  그 자료에 실려 있던 문항
//
// ⚠️ 기출의 `Exam`(시험지 1편)과 같은 자리다 — 그쪽은 예측기가 쓰는 통계 원본이고 이쪽은 **문제은행을
//    거르고 되짚는** 데 쓴다. 문항에 출판사 이름을 글자로 베껴 두지 않는 까닭: 책 54권 · 자료 수천 편이
//    문항 만 줄에 되풀이되면, 출판사 표기 하나를 고칠 때 만 줄을 고쳐야 한다.
// ⚠️ 자체 교재 제작의 `Textbook*` 표들과 **다른 것**이다 — 그쪽은 우리가 만드는 교재, 이쪽은 남이 낸 책.
// 계약 SSOT: src/contracts/sourceMaterial.contract.ts
// ─────────────────────────────────────────────

model SourceBook {
  id String @id @default(uuid()) @db.Uuid

  /// 다시 적재해도 같은 줄이 되게 하는 열쇠 — `2022/천재교육/중1/김동재`.
  externalKey String @unique @map("external_key") @db.VarChar(120)
  /// `school_textbook`(교과서) | `workbook`(문제집). DB CHECK 가 지킨다.
  kind        String @db.VarChar(20)
  /// 출판사 — 「천재교육」. 폴더 이름의 오타(「YMB」)는 적재기가 정본 표기로 고친다.
  publisher   String @db.VarChar(30)
  /// 대표 저자 — 「김동재」. 한 출판사가 같은 과목을 두 권 낸다(천재교육 중1 김동재 · 김화경).
  author      String? @db.VarChar(30)
  /// 책 제목 — 「중학 수학1」 · 「공통수학1」
  title       String @db.VarChar(80)
  /// 우리 교육과정 트리의 학년 키 — `Unit.grade` 와 같은 값(「중1」 · 「공통수학1」)
  grade       String @db.VarChar(10)
  /// 교육과정 — `2022`(22개정) | `2015`
  curriculum  String @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materials SourceMaterial[]

  @@index([kind, grade, publisher])
  @@map("source_book")
}

model SourceMaterial {
  id String @id @default(uuid()) @db.Uuid

  /// 다시 적재해도 같은 줄이 되게 하는 열쇠 — 원본 파일 경로의 sha1 앞 16자(`tb-…`).
  /// 변환본 파일 이름 · 그림 폴더 이름과 같은 값이다.
  externalKey String @unique @map("external_key") @db.VarChar(120)
  bookId      String @map("book_id") @db.Uuid

  /// 자료 종류 — 우리가 맞춘 이름(「소단원 평가」 · 「형성평가」 · 「시험 대비」 …).
  /// 값의 목록은 계약에 있다(`SOURCE_MATERIAL_KINDS`) — DB 에는 CHECK 를 두지 않는다(새 종류가 생긴다).
  kind     String @db.VarChar(20)
  /// 출판사가 부른 이름 그대로 — 「기초력 UP 문제」. 우리 이름으로 맞춰도 이 값은 **보존한다**.
  kindRaw  String @map("kind_raw") @db.VarChar(60)
  /// 자료 제목 — 파일 이름(확장자 없이)
  title    String @db.VarChar(200)

  /// 교과서의 단원 번호 — 대 · 중 · 소. 파일 이름에 없으면 NULL.
  /// ⚠️ **교과서의** 번호다 — 우리 차시 번호와 다르다(책마다 단원을 나누는 자리가 다르다).
  chapterNo Int? @map("chapter_no") @db.SmallInt
  middleNo  Int? @map("middle_no") @db.SmallInt
  sectionNo Int? @map("section_no") @db.SmallInt
  /// 교과서의 단원 이름 원문 — 「다항식의 덧셈과 뺄셈」. 우리 차시로 붙여도 보존한다.
  unitRaw   String? @map("unit_raw") @db.VarChar(120)

  /// 학기 — 「1학기 중간대비」처럼 자료가 스스로 말할 때만. 문항의 학기는 차시가 말한다.
  semester Int?    @db.SmallInt
  /// 「중간」 | 「기말」 — 시험 대비 자료만
  round    String? @db.VarChar(4)
  /// 출판사가 적은 수준 — 「기본」 · 「발전」 · 「상」
  levelRaw String? @map("level_raw") @db.VarChar(20)
  /// 회차 — 「2회」의 2
  sequence Int?    @db.SmallInt

  /// 원본 파일 경로(G드라이브 기준)
  sourceFile String? @map("source_file") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ⚠️ Restrict — 책을 지우려면 자료부터.
  book     SourceBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  problems Problem[]

  @@index([bookId, kind])
  @@map("source_material")
}

// ─────────────────────────────────────────────
// EXAM — 기출 시험지 1편 (트랙 E · 11-score-predictor.md §3 L0)
//
// ⚠️ Problem 과 목적이 다르다. Problem 은 **출제용**이라 문항 단위로 정규화·필터링돼
//    시험지 통계가 이미 깨져 있다(적재에서 탈락한 문항이 있다). 예측기는 시험지 통계를
//    그대로 써야 하므로 **추출 JSON 원본**에서 이쪽을 만든다.
// ─────────────────────────────────────────────

model Exam {
  id String @id @default(uuid()) @db.Uuid

  /// 외부 인덱스 키(exam_index.db 의 exams.id). 재적재 멱등 키다.
  externalExamId String @unique @map("external_exam_id") @db.VarChar(120)

  school     String  @db.VarChar(50)
  /// "중" | "고"
  level      String  @db.VarChar(2)
  grade      Int
  /// 우리 교육과정 트리 라벨("중3", "공통수학1")
  subject    String  @db.VarChar(50)
  /// 시험지 원본 표기("수학", "수상"). 원문을 버리지 않는다.
  subjectRaw String? @map("subject_raw") @db.VarChar(50)

  year     Int
  semester Int
  /// "중간" | "기말"
  round    String @db.VarChar(4)

  totalScore    Float @map("total_score")
  questionCount Int   @map("question_count")

  sourceFile String?  @map("source_file") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  questions ExamQuestion[]

  /// 시리즈를 시간순으로 세우는 조회 — 예측의 기본 질의다.
  @@index([school, level, grade, subject, year, semester, round])
  @@index([level, grade, subject, year, semester, round])
  @@map("exam")
}

model ExamQuestion {
  id     String @id @default(uuid()) @db.Uuid
  examId String @map("exam_id") @db.Uuid

  number Int
  /// 배점. 3.2·3.4 처럼 소수 배점이 흔하다 — 반올림하지 말 것.
  score  Float
  /// 객관식 | 단답형 | 서술형
  qtype  String @db.VarChar(10)

  /// 시험지 원본의 사람 난이도 라벨: 하 | 중 | 상.
  /// ⚠️ Difficulty(easy/mid/hard)와 **다른 축**이다. 섞지 말 것.
  /// ⚠️ 배점으로 추정해 채우지 말 것 — 난이도로 점수를 예측하면 순환 논리가 된다(11 §2.4).
  difficultyLabel String? @map("difficulty_label") @db.VarChar(4)

  /// ⚠️ 시험지 원문 소단원 표기. 우리 트리로 매핑해도 이 값은 **보존한다**.
  /// 학교마다 단원을 부르는 이름이 다르고, 그 표기 자체가 출제 패턴 신호다.
  topicRaw String? @map("topic_raw") @db.VarChar(100)
  /// 매핑 실패 시 null. 버리지 않는다.
  unitId   String? @map("unit_id") @db.Uuid

  answer    String? @db.Text
  hasFigure Boolean @default(false) @map("has_figure")
  /// 문제은행과 연결됐으면 그 id (없을 수 있다)
  problemId String? @map("problem_id") @db.Uuid

  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([examId, number])
  @@index([unitId])
  @@map("exam_question")
}

// ─────────────────────────────────────────────
// FEAT-1: 시험지 — 04 §2.4
// ─────────────────────────────────────────────

model Test {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  /// NULL이면 반 전체 대상
  studentId String? @map("student_id") @db.Uuid

  testType TestType @map("test_type")

  /// 확인테스트 범위 시작 (일일테스트는 NULL)
  rangeStartUnitId String? @map("range_start_unit_id") @db.Uuid
  /// 범위 끝 (일일테스트는 현재 진도 소단원)
  rangeEndUnitId   String  @map("range_end_unit_id") @db.Uuid

  status    TestStatus @default(draft)
  /// 검수 중 문제 교체 발생 여부 — 무수정 사용률 측정 (입력 지표 ②)
  modified  Boolean    @default(false)
  /// 테스트 예정일
  testDate  DateTime   @map("test_date") @db.Date
  /// 인쇄 시각 — 노스스타(주 5일 사용) 측정
  printedAt DateTime?  @map("printed_at")

  /// '오늘의 시험' 예측 문제지면 그 회차(PredictionRun)의 id. 일반 시험지는 NULL.
  ///
  /// 이 한 컬럼이 세 가지를 정직하게 만든다(15 §B):
  ///   1. 예측 문제지 구분 — 배점 유무라는 간접 신호를 대체한다
  ///   2. 계기판 파이프라인의 문제지·채점 단계 — "데이터 원천이 없어 항상 미완"이던
  ///      자리에 실데이터 판정이 생긴다
  ///   3. 반쪽 시험지 차단 — 확정 시 회차 청사진의 문항 수와 대조할 수 있다
  predictionRunId String?  @map("prediction_run_id") @db.Uuid

  /// 아침 8시 자동 초안 회차(`AutoDraftRun`)가 세운 시험지면 그 회차 id. 손으로 낸 시험지는 NULL (D-133 ⑴).
  ///
  /// 메인 «오늘의 확인테스트» 검수 줄의 **«자동 출제» 표지**가 이 칸 하나만 본다(daily-review `todayTests[].autoDraft`).
  /// 🔴 **서버 안에서만 채운다** — `generateDraftTest` 의 세 번째 인자로 `runAutoDraft` 만 넘긴다.
  ///    요청 계약(`TestGenerateRequest`)에는 칸이 없다(strict — 넣으면 400). 밖에서 채울 수 있으면 표지가 거짓말이 된다.
  ///    시각으로 짐작하지도 않는다 — 8시 무렵 «모두 출제»로 낸 시험지가 섞인다.
  autoDraftRunId  String?  @map("auto_draft_run_id") @db.Uuid
  /// 월말평가 M1(2026-10-17) — «내 시험지»에서 반에 낸 시험이면 그 발행본. 🔴 있으면 «일반 시험» 조회(확인테스트 범위 · 자동 초안 ·
  /// 메인 · 지표 · 최근 출제)에서 뺀다 — `docs/planning/monthly-exam-plan-20261017.md` §9.
  publicationId   String?  @map("publication_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  rangeStartUnit Unit?          @relation("TestRangeStartUnit", fields: [rangeStartUnitId], references: [id], onDelete: Restrict)
  /// 회차가 지워져도 시험지는 남긴다 — 인쇄물이 이미 나갔을 수 있다.
  predictionRun  PredictionRun? @relation(fields: [predictionRunId], references: [id], onDelete: SetNull)
  /// 회차 기록이 지워져도 시험지는 남긴다 — 칸만 빈다(표지가 사라질 뿐 시험지·문항은 그대로).
  autoDraftRun   AutoDraftRun?  @relation(fields: [autoDraftRunId], references: [id], onDelete: SetNull)
  publication    ExamPublication? @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  rangeEndUnit   Unit           @relation("TestRangeEndUnit", fields: [rangeEndUnitId], references: [id], onDelete: Restrict)
  testProblems   TestProblem[]
  testResults    TestResult[]

  examReports ExamReportDraft[]
  @@index([userId, testDate(sort: Desc)])
  @@index([classId, testDate(sort: Desc)])
  @@index([studentId])
  @@index([predictionRunId])
  @@index([autoDraftRunId])
  @@map("test")
}

/// 월말평가 M1 — 반에 낸 시험지의 **고정본**(2026-10-17 · 계획서 §9). 문항의 글 · 정답 · 해설 · 그림 참조 · 배점 · 차례 · 출력 설정을
/// 낸 그대로 묶는다 — 원본 «내 시험지»를 고치거나 지워도, 은행 문항이 바뀌어도 낸 시험은 그대로다. 반마다 `test` 한 행이 이것을 가리킨다.
/// 종류는 enum 을 늘리지 않고 글자 칸(CHECK)이다. 같은 요청 번호의 재전송은 같은 발행본이다(`user_id`, `request_id`).
model ExamPublication {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  documentId     String   @map("document_id") @db.VarChar(100)
  sourceRevision Int      @map("source_revision")
  title          String   @db.VarChar(200)
  examType       String   @default("monthly") @map("exam_type") @db.VarChar(20)
  testDate       DateTime @map("test_date") @db.Date
  payload        Json     @db.JsonB
  contentHash    String   @map("content_hash") @db.Char(64)
  requestId      String   @map("request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tests  Test[]
  examReports ExamReportDraft[]

  @@unique([userId, requestId])
  @@index([userId, documentId, createdAt(sort: Desc)])
  @@map("exam_publication")
}

/// 월말평가 성적표 — 낸 시험 한 회 × 학생 한 명의 편집 자리(원장님 문장 · 지면 설정 · 상태). 마이그레이션 `20261018150000_exam_report_confirmation`.
/// 문장 · 지면 설정 · 원시험을 고치면 DB 트리거가 판을 올리고 확정을 푼다. 재채점은 읽을 때 지문으로 가린다.
model ExamReportDraft {
  id                  String   @id @default(uuid()) @db.Uuid
  publicationId       String   @map("publication_id") @db.Uuid
  testId              String   @map("test_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  branchId            String?  @map("branch_id") @db.Uuid
  teacherNote         String   @default("") @map("teacher_note")
  options             Json     @default("{}") @db.JsonB
  revision            Int      @default(1)
  state               String   @default("draft") @db.VarChar(12)
  confirmedArtifactId String?  @map("confirmed_artifact_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  publication       ExamPublication      @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  test              Test                 @relation(fields: [testId], references: [id], onDelete: Restrict)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  artifacts         ExamReportArtifact[] @relation("ExamReportArtifacts")
  confirmedArtifact ExamReportArtifact?  @relation("ExamReportConfirmed", fields: [confirmedArtifactId, id], references: [id, reportId], onDelete: Restrict, map: "exam_report_draft_confirmed_artifact_fkey")

  @@unique([publicationId, studentId])
  @@index([testId])
  @@map("exam_report_draft")
}

/// 확정한 순간의 고정본 — 고치거나 지울 수 없다(DB 트리거). PDF 바이트는 비공개 버킷 `exam-report-private` 의 `pdfPath` 에 있다.
model ExamReportArtifact {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  revision       Int
  sourceResultId String   @map("source_result_id") @db.Uuid
  confirmedBy    String   @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime @default(now()) @map("confirmed_at")
  layoutVersion  String   @map("layout_version") @db.VarChar(100)
  sourceDigest   String   @map("source_digest") @db.Char(64)
  snapshot       Json     @db.JsonB
  pdfPath        String   @unique @map("pdf_path") @db.VarChar(300)
  pdfSha256      String   @map("pdf_sha256") @db.Char(64)
  pdfSize        Int      @map("pdf_size")

  report       ExamReportDraft   @relation("ExamReportArtifacts", fields: [reportId], references: [id], onDelete: Restrict)
  sourceResult TestResult        @relation(fields: [sourceResultId], references: [id], onDelete: Restrict)
  confirmer    User              @relation("ExamReportConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  confirmedOf  ExamReportDraft[] @relation("ExamReportConfirmed")

  @@unique([reportId, revision])
  @@unique([id, reportId])
  @@map("exam_report_artifact")
}

// ─────────────────────────────────────────────
// FEAT-1: 시험지-문제 연결 — 04 §2.5
// ─────────────────────────────────────────────

model TestProblem {
  id         String  @id @default(uuid()) @db.Uuid
  testId     String  @map("test_id") @db.Uuid
  problemId  String  @map("problem_id") @db.Uuid
  /// 문항 번호
  orderIndex Int     @map("order_index")
  /// 검수 중 교체된 문항 여부
  replaced   Boolean @default(false)

  /// 예측 문제지 전용 — 배점 보정기가 매긴 조정 배점. 시험지 합계가 정확히 100 이 된다(D-42).
  /// ⚠️ `Problem.score`(원본 기출 배점)를 **덮어쓰지 않으려고** 시험지 쪽에 싣는다(11 §10.2).
  ///    덮어쓰면 학습 코퍼스가 오염된다.
  /// 일일테스트는 배점을 표기하지 않으므로(D-28·D-40) NULL 이다.
  score Float?

  /// 교재의 문항으로 다시 출제한 시험지만 값이 있다 — 있으면 본문 · 정답 · 해설 · 그림을
  /// **확정본에서** 읽는다(`src/lib/tests/testProblemContent.ts` 의 `contentOf`). 없으면 지금처럼 살아 있는 문항이다.
  /// **SQL 에만 있는 것**: 부분 색인(값이 있는 행만) · 트리거 `test_problem_textbook_snapshot_identity`
  /// (확정본의 불변 정체 `source_ref.problemId` 가 이 행의 `problem_id` 와 같아야 한다 — 문항을 바꾸면 이 칸을 비운다).
  /// 🔴 DB 먼저 · 코드 나중 — 마이그레이션 `20261003120100_textbook_test_problem_snapshot`
  snapshotId String? @map("snapshot_id") @db.Uuid

  test     Test                     @relation(fields: [testId], references: [id], onDelete: Cascade)
  problem  Problem                  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  snapshot TextbookProblemSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([testId, orderIndex])
  @@index([problemId])
  @@index([snapshotId])
  @@map("test_problem")
}

// ─────────────────────────────────────────────
// 담기 바구니 — 문제은행에서 고른 문항 (2026-09-04, 원장님 확정)
// 계약: src/contracts/basket.contract.ts
// ─────────────────────────────────────────────

/// 원장이 문제은행에서 담아 둔 문항. **계정당 하나**의 바구니다.
///
/// 🔴 브라우저가 아니라 **서버**에 둔다 — 원장님이 「집에서 고르고 학원에서 이어서」를
///    요구하셨다. 브라우저에 두면 그 약속이 절반만 참이 된다.
model BasketItem {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  /// 담은 차례. **시험지의 문항 번호가 이 순서를 따른다.**
  ///
  /// ⚠️ 행을 빼도 **다시 매기지 않는다** — 다시 매기면 남은 행의 번호가 통째로
  ///    흔들려 「셋째로 담은 것」이 다른 문항을 가리킨다. 빈 자리는 그대로 두고
  ///    시험지로 옮길 때 차례대로 다시 세어 1..N 을 붙인다.
  orderIndex Int      @map("order_index")
  addedAt    DateTime @default(now()) @map("added_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 🔴 **Restrict 가 아니라 Cascade 다.** 바구니는 «고르는 중»인 임시 목록이라
  ///    문항이 사라지면 같이 사라져야 한다. Restrict 로 두면 문항 하나 때문에
  ///    적재 되돌리기가 통째로 막힌다(2026-09-04 에 `98X` 24행을 지울 때 겪은 자리).
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// 같은 문항을 두 번 담을 수 없다 — 담기는 **멱등**이다.
  @@unique([userId, problemId])
  @@index([userId, orderIndex])
  @@map("basket_item")
}

// ─────────────────────────────────────────────
// v2 "오늘의 시험"(기출 예상 점수 판독기) T7.1 — 학생 응시 결과
// 참조: docs/planning/11-score-predictor.md §1 (산출물 A/B/C)
//
// ⚠️ 이 3개 모델은 06-database-design.md(v1 ERD)에는 없다 — v2 신규 기능이라
//    이 스키마 파일 안에서 SSOT를 새로 정의한다(T7.1 지시서 기준).
// 참조: docs/planning/07-coding-convention.md §2.2 (네이밍 규칙)
// ─────────────────────────────────────────────

/// 시험 응시 결과 — 한 학생이 한 시험지(Test)를 푼 1회 채점 기록.
/// 같은 (testId, studentId) 재응시/재채점을 막지 않는다(재시험·정정 입력 허용) — 최신값은
/// takenAt 내림차순 조회로 가른다.
///
/// 🔴 **「아직 안 봄」은 이 표에 행이 없는 것이다** (D-134 트랙 1).
///    시험지 대상 학생인데 `TestResult` 행이 없으면 **미채점**이다 — 0점도, 만점도, 결시도 아니다.
///    그래서 집계는 «대상 학생 수»가 아니라 «행 수»를 분모로 삼아야 하고, 없는 행을
///    0 으로 채우면 안 된다(23 §4 ② · 20번 «칸이 없다»를 0점으로 채우면).
model TestResult {
  id             String      @id @default(uuid()) @db.Uuid
  testId         String      @map("test_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  /// 응시(채점 입력) 일시 — 별도 입력이 없으면 서버 처리 시각
  takenAt        DateTime    @default(now()) @map("taken_at")
  /// 이 기록이 어떻게 들어왔나 — 기본 `answers`(기존 `/submit` 의 뜻을 안 바꾼다).
  gradingMode    GradingMode @default(answers) @map("grading_mode")
  /// 🔴 **결시** — 시험을 안 봤다. 칸을 전부 ✕ 로 찍은 것(전 문항 오답)과 **다른 뜻**이다.
  ///    결시면 `score`·`predictedScore` 가 NULL 이고 `AnalysisReport` 를 만들지 않으며
  ///    `ProblemAnswer` 도 만들지 않는다 — 전 문항 오답으로 남기면 난이도 분포가 거짓이 된다.
  absent         Boolean     @default(false)
  /// 자동 채점 총점.
  /// 🔴 **NULL 을 허용한다** — 결시를 `0` 으로 적으면 그 0이 평균·추이·리포트에 **진짜 0점처럼**
  ///    실린다(23 §4 ③). 읽는 쪽은 `score ?? 0` 을 쓰면 안 된다 — 없는 값은 집계에서 빠진다
  ///    (`src/lib/testResults/scoreRollup.ts`).
  score          Float?
  /// 판독기 계산값 — src/lib/predictor/predictStudentScore.ts (v0, 잠정) 산출물.
  /// ⚠️ 진짜 능력 추정 엔진(11-score-predictor.md §1-B)이 아직 없어 잠정 추정치다.
  /// 🔴 `score` 와 같은 까닭으로 NULL 을 허용한다 — 결시에는 예상 점수가 없다.
  predictedScore Float?      @map("predicted_score")
  createdAt      DateTime    @default(now()) @map("created_at")

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        ProblemAnswer[]
  /// 1:1 — 실제 FK는 AnalysisReport.testResultId(unique)가 소유한다(순환 FK 회피).
  analysisReport AnalysisReport?

  examReportArtifacts ExamReportArtifact[]
  @@index([testId, studentId, takenAt])
  @@map("test_result")
}

/// 문항별 학생 응답 + 자동 채점 결과.
model ProblemAnswer {
  id           String @id @default(uuid()) @db.Uuid
  testResultId String @map("test_result_id") @db.Uuid
  problemId    String @map("problem_id") @db.Uuid

  /// 객관식 선택 번호(1~5) — 서술형이거나 미답이면 NULL
  selectedChoice Int?    @map("selected_choice")
  /// 서술형 채점 점수(0~100, 배점 대비 비율) — 객관식이거나 미답이면 NULL
  essayScore     Float?  @map("essay_score")
  /// 자동 채점 결과 — 객관식은 정답 일치, 서술형은 essayScore 기준선 판정(잠정 60점)
  isCorrect      Boolean @map("is_correct")
  /// 시험지 내 문항 순서(TestProblem.orderIndex 대응)
  sequence       Int

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([testResultId, sequence])
  @@map("problem_answer")
}

/// 응시 1건에 대한 분석 리포트 — 단원별 성적·난이도 분포·복습 추천 단원.
model AnalysisReport {
  id           String @id @default(uuid()) @db.Uuid
  /// 1:1 FK(unique) — 이 모델이 관계를 소유한다.
  testResultId String @unique @map("test_result_id") @db.Uuid

  totalScore             Float    @map("total_score")
  predictedScore         Float    @map("predicted_score")
  /// {unitId: 정답률(0~100)} — 04-database-design.md 스타일과 달리 v2 신규라 jsonb로 유지
  unitScores             Json     @map("unit_scores") @db.JsonB
  /// {difficulty(easy|mid|hard): {correct, total}}
  difficultyDistribution Json     @map("difficulty_distribution") @db.JsonB
  /// 복습 추천 단원 id 배열 — 정답률 낮은 순 최대 3개(잠정 기준선 60%)
  recommendedUnits       String[] @map("recommended_units")

  createdAt DateTime @default(now()) @map("created_at")

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@map("analysis_report")
}

// ─────────────────────────────────────────────
// Auth.js (NextAuth v5) — @auth/prisma-adapter 표준 스키마
// 참조: https://authjs.dev/getting-started/adapters/prisma
// 주의: Account의 OAuth 토큰 필드는 어댑터가 Prisma Client 필드명을
// 그대로(snake_case) 읽으므로 @map으로 camelCase 매핑하지 않는다.
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ─────────────────────────────────────────────
// v2 '오늘의 시험' 보정 루프 — 트랙 E (T7.7 · T7.10 · T7.11)
// 참조: docs/planning/11-score-predictor.md §3 L5, §5
//
// ⚠️ 이 기록이 없으면 보정 자체가 불가능하다. 예측을 남기지 않으면
//    나중에 실제 점수가 들어와도 무엇과 비교할지 알 수 없다.
// ─────────────────────────────────────────────

/// 예측 실행 스냅샷. 계약: `predictionRunSchema`(src/contracts/predictor.contract.ts).
///
/// 같은 시험을 여러 번 예측할 수 있다(엔진 버전이 오르면 과거 회차를 재실행해 비교한다)
/// — 그래서 (학교, 시점)에 유일 제약을 걸지 않는다. 섞이지 않게 engine_version 으로 가른다.
model PredictionRun {
  id            String   @id @default(uuid()) @db.Uuid
  /// 이 예측을 만든 원장. 소유권 경계가 여기 있어야 목록 조회를 DB where 로 거를 수 있다.
  /// (처음엔 컬럼이 없어 `params.ownerUserId` JSON 에 임시로 실었다 — 메모리 필터라
  ///  페이지네이션을 붙일 수 없었다. 그 임시방편을 걷어내려고 넣는다.)
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  /// 엔진 버전. 이게 다르면 지표를 섞어서 비교하지 않는다.
  engineVersion String   @map("engine_version") @db.VarChar(40)

  /// 예측 대상 시리즈 — Exam 과 같은 축으로 둔다(조인이 아니라 값으로 맞춘다).
  school  String @db.VarChar(50)
  level   String @db.VarChar(2)
  grade   Int
  subject String @db.VarChar(50)

  targetYear     Int    @map("target_year")
  targetSemester Int    @map("target_semester")
  targetRound    String @map("target_round") @db.VarChar(4)

  /// 입력 컷오프 — **이 시점 이후 자료는 어떤 경로로도 쓰지 않았다**는 선언.
  /// 누출 금지를 코드로 강제하는 근거값이라 반드시 남긴다.
  cutoffYear     Int    @map("cutoff_year")
  cutoffSemester Int    @map("cutoff_semester")
  cutoffRound    String @map("cutoff_round") @db.VarChar(4)

  /// 근거로 쓴 시험지의 externalExamId 목록. 재현·감사에 필요하다.
  inputExamIds       String[] @map("input_exam_ids")
  /// 엔진 파라미터 스냅샷. 형태는 엔진 버전마다 다르다.
  params             Json
  /// 근거가 없어 예측하지 않았으면 NULL — 0문항 0점짜리 청사진을 지어내지 않는다.
  predictedBlueprint Json?    @map("predicted_blueprint")
  /// ScorePrediction[] — 학생별 예상 점수와 구간.
  predictedScores    Json     @map("predicted_scores")

  /// 실행 단위 위험 표시. "근거가 없어 청사진을 못 만들었다"는 **run 단위 사실**이라
  /// ScorePrediction 안에 담을 수 없다(predictedScores 가 비어 있으면 담을 데가 없다).
  riskFlags String[] @map("risk_flags")

  /// 이 시험의 실제 시행일. 화면이 D-day 를 세는 기준이고, 엔진 입력이 아니다.
  /// 모르면 NULL — 지어내지 않는다.
  examDate DateTime? @map("exam_date") @db.Date

  /// 학교가 평균을 공개하면 채운다. 안 하면 학생 표본으로 역추정한다(NULL 유지).
  actualSchoolMean  Float?    @map("actual_school_mean")
  actualSchoolStdev Float?    @map("actual_school_stdev")
  actualRecordedAt  DateTime? @map("actual_recorded_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actualScores ActualExamScore[]
  /// 이 회차로 만든 예측 문제지들.
  tests        Test[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([school, level, grade, subject, targetYear, targetSemester, targetRound])
  @@index([engineVersion, createdAt])
  @@map("prediction_run")
}

/// 실제 내신 점수 — 보정 루프의 입력.
///
/// 같은 run 에 같은 학생을 두 번 붙이면 **갱신**한다(중복 행이 아니다) — 원장이
/// 점수를 잘못 입력했을 때 고칠 수 있어야 한다.
model ActualExamScore {
  id        String @id @default(uuid()) @db.Uuid
  runId     String @map("run_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  actualScore    Float   @map("actual_score")
  /// 예측 당시 값의 **스냅샷**. run 의 Json 을 다시 파싱하지 않고 잔차를 집계할 수 있고,
  /// Json 모양이 나중에 바뀌어도 과거 보정 근거가 흔들리지 않는다.
  /// 예측이 없으면 NULL 이다 — 개인 예상 점수를 아직 못 내는 회차가 있다(§3 L3 미착수).
  /// **없는 예측을 0 이나 평균으로 지어내지 않는다.** 실제 결과는 그것대로 근거다.
  predictedScore Float?  @map("predicted_score")
  /// actual − predicted. 보정 계수(T7.11)의 직접 입력이다.
  /// 예측이 없으면 NULL — 보정 표본에서는 빠지되 실제 점수는 그대로 남는다.
  residual       Float?
  /// 예측 **구간**이 실제를 담았는가. 점 예측 MAE 와 별개로 봐야 하는 지표다
  /// — ±5점 목표는 구간 적중률로 판정한다.
  intervalHit    Boolean @map("interval_hit")

  /// 예측 구간도 스냅샷으로 남긴다. 이게 없으면 원장이 점수를 정정할 때
  /// `intervalHit` 만 run 의 **현재** Json 으로 다시 판정돼, 점수는 스냅샷을 지키는데
  /// 적중 판정만 따라 움직이는 어긋남이 생긴다. 보정 정직성 판정(구간 적중률 vs
  /// 선언 신뢰수준)에 쓸 coverage 도 저장 행에서 읽을 수 있어야 한다.
  /// 예측 시점에 구간을 못 냈으면 NULL — 지어내지 않는다.
  predictedLower    Float? @map("predicted_lower")
  predictedUpper    Float? @map("predicted_upper")
  predictedCoverage Float? @map("predicted_coverage")

  recordedAt DateTime @default(now()) @map("recorded_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  run     PredictionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([runId, studentId])
  @@index([studentId, recordedAt(sort: Desc)])
  @@map("actual_exam_score")
}

/// 시험범위. 원장이 확정하면 예측 신뢰도가 올라가고, 없으면 riskFlag 가 붙는다.
model ExamScope {
  id       String @id @default(uuid()) @db.Uuid
  school   String @db.VarChar(50)
  level    String @db.VarChar(2)
  grade    Int
  subject  String @db.VarChar(50)
  year     Int
  semester Int
  round    String @db.VarChar(4)

  /// 범위에 든 소단원 id 목록. 비어 있으면 미확정이다.
  unitIds     String[]  @map("unit_ids") @db.Uuid
  /// 원장이 확정한 시각. NULL 이면 추정값이라 신뢰도를 깎는다("시험범위_미확정").
  confirmedAt DateTime? @map("confirmed_at")
  note        String?   @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([school, level, grade, subject, year, semester, round])
  @@map("exam_scope")
}

/// 문항 신고 — 쓰다가 이상하면 누른 기록.
///
/// 문항 47,049건은 전량 검수가 불가능하므로(한 문항 10초로도 131시간) 이것이
/// **마지막 안전망**이자 다음 검수의 대기열이다.
///
/// ⚠️ 신고는 문항을 **바꾸지 않는다.** `directUseAllowed` 를 신고가 직접 건드리면
///    오신고 한 건이 멀쩡한 문항을 지면에서 지운다. 빼는 것은 사람이 따로 결정한다.
/// 검수 판정 — pass=통과 / unsure=판단 못 하겠다 / defect=신고.
/// unsure 를 정식 결과로 둔다: 해설 없음이 70% 라 「통과/신고」 둘뿐이면
/// 확인 못 한 것에 통과를 누르게 되고 기록 전체가 잡음이 된다.
enum ReviewVerdict {
  pass
  unsure
  defect

  @@map("review_verdict")
}

model ProblemReport {
  id             String       @id @default(uuid()) @db.Uuid
  problemId      String       @map("problem_id") @db.Uuid
  /// 신고자가 탈퇴해도 **기록은 남는다** — 지우면 「몇 건이 있었나」가 거짓이 된다.
  reporterId     String?      @map("reporter_id") @db.Uuid
  reason         ReportReason
  note           String?
  status         ReportStatus @default(open)
  /// 「왜 그대로 두는가」가 여기 남아야 같은 신고가 또 안 온다.
  resolutionNote String?      @map("resolution_note")
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  resolvedById   String?      @map("resolved_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?   @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([problemId])
  @@map("problem_report")
}

/// 검수 기록 — 사람이 문항을 보고 내린 판정.
///
/// 🔴 `Problem.reviewStatus` 와 **다른 것**을 적는다. 그쪽은 「출제 자격」이고
///    이쪽은 「사람이 봤음」이다. 이관 적재가 문항을 전부 approved 로 넣으므로
///    그 컬럼으로는 «봤나»를 물을 수 없다(src/lib/import/toLoadRows.ts).
/// 🔴 **덧붙이기만 한다.** 다시 봐도 앞 기록을 안 지운다 — 「전에는 통과라 했는데
///    지금은 아니다」가 남아야 판정 규칙을 나중에 검산할 수 있다.
model ProblemReviewLog {
  id         String        @id @default(uuid()) @db.Uuid
  problemId  String        @map("problem_id") @db.Uuid
  /// 검수자가 탈퇴해도 **기록은 남는다.**
  reviewerId String?       @map("reviewer_id") @db.Uuid
  verdict    ReviewVerdict
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  problem  Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([reviewerId, problemId], map: "problem_review_log_reviewer_problem_idx")
  @@index([createdAt(sort: Desc)])
  @@index([problemId])
  @@map("problem_review_log")
}

/// 오류 기록 — 사용자의 요청이 거절(4xx)·실패(5xx·예외)했을 때, 그리고 브라우저 쪽 오류를 한 줄씩 남긴다.
///
/// 🔴 감사 기록(`AccountAuditLog`)과 **섞지 않는다**(원장님 2026-09-22). 그쪽은 «누가 무엇을 했나»,
///    이쪽은 «무엇이 왜 안 됐나» — 업그레이드 패치의 재료다(요청 요약 · zod 칸 · 엔진 거절 원문 · AI 시도 기록).
/// 🔴 **90일 보관** — `/api/logs/purge/cron` 이 매일 지운다. 쓰기는 best effort(`src/lib/errorLog/record.ts`) —
///    표가 없거나 DB 가 느려도 요청을 깨지 않는다.
/// 지점 칸은 두지 않는다(D-136 트랙과 겹치지 않게) — `userId` 로 계정의 지점에 이어 붙인다.
model ErrorLog {
  id         String   @id @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// `server` | `client` — 계약: src/contracts/errorLog.contract.ts
  source     String   @db.VarChar(10)
  /// `api-rejected`(4xx) · `api-error`(5xx·예외) · `ai-rejected` · `client-exception` · `client-request-failed`
  kind       String   @db.VarChar(40)
  /// 서버는 라우트 틀(`/api/tests/[id]`), 브라우저는 그 화면의 경로
  route      String?  @db.VarChar(300)
  method     String?  @db.VarChar(10)
  status     Int?
  /// 작업 이름 — 작업실 AI 의 `figure-redraw` 같은 것
  action     String?  @db.VarChar(60)
  /// 화면에 나간 문구 그대로
  message    String?
  /// 개발자용 원문 — zod 이슈 경로·엔진 거절 사유·스택
  detail     String?
  /// 요청 요약 · AI 시도 기록 — 비밀 값은 걸러 싣는다(`sanitize.ts`)
  context    Json     @default("{}") @db.JsonB
  userId     String?  @map("user_id") @db.Uuid
  /// 배포 커밋(`VERCEL_GIT_COMMIT_SHA`)
  release    String?  @db.VarChar(64)
  /// 플랫폼 요청 번호(`x-vercel-id`) — Vercel 실행 기록과 맞춰 볼 때
  requestId  String?  @map("request_id") @db.VarChar(200)
  durationMs Int?     @map("duration_ms")

  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// AI 도형 재작도 · «요청대로 고치기» 실패 때의 크롭 이미지 — 목록 조회가 무거워지지 않게 따로 둔다
  image ErrorLogImage?

  @@index([createdAt(sort: Desc)])
  @@index([route, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("error_log")
}

/// 오류 기록에 딸린 원본 이미지(상한 2MB) — 기록을 지우면 같이 지워진다.
model ErrorLogImage {
  errorLogId String   @id @map("error_log_id") @db.Uuid
  mimeType   String   @map("mime_type") @db.VarChar(40)
  byteSize   Int      @map("byte_size")
  data       Bytes

  errorLog ErrorLog @relation(fields: [errorLogId], references: [id], onDelete: Cascade)

  @@map("error_log_image")
}

// ─────────────────────────────────────────────────────────────────────────────
// 오늘의 영어 — 외부지문 내신 스튜디오 (D-148, docs/planning/25-english-studio.md §2)
//
// 부류: **학원 운영 데이터**(D-130) — `EnglishExam.userId` 로 소유하고 `ownedRowsWhere` 로 범위를 가른다
// (지점 관리자는 지점 전체 · 강사는 자기 것). 자료·세트는 부모 시험의 범위로 판정한다.
// 🔴 문제은행 `Problem` 에 넣지 않는다 · `WorkspaceDocument/Asset` 에 얹지 않는다(25 §2).
// 계약: src/contracts/english.contract.ts · 마이그레이션: prisma/migrations/20260930120000_english_studio
// (적용은 scripts/qa/apply-english-studio-migration.ts — `prisma migrate dev/deploy/db push` 금지).
// ─────────────────────────────────────────────────────────────────────────────

/// 학교별 내신 시험 하나 — 자료(EnglishMaterial)와 대비 문제 세트(EnglishQuestionSet)의 부모
model EnglishExam {
  branchId String? @map("branch_id") @db.Uuid
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  school    String    @db.VarChar(80)
  /// 중1~고3 — 계약 `ENGLISH_GRADES`. **SQL 에만 있는 것**: CHECK grade IN (...)
  grade     String    @db.VarChar(4)
  title     String    @db.VarChar(100)
  /// 시험 날짜(달력 날짜) — 없어도 된다
  examDate  DateTime? @map("exam_date") @db.Date
  /// 출제 설정 — 이번 시험에서 중점적으로 다룰 유형 이름 배열(계약 `englishGeneratedTypeSchema`).
  /// **SQL 에만 있는 것**: CHECK jsonb_typeof(types) = 'array'
  types     Json      @default("[]") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials EnglishMaterial[]
  sets      EnglishQuestionSet[]

  @@index([userId, createdAt])
  @@map("english_exam")
}

/// 시험 자료 — 파일 원본(`bytes` — 상한은 계약 `ENGLISH_MATERIAL_MAX_BYTES`, 4MB) 또는 지문 글(`content`). **SQL 에만 있는 것**: 둘 다 NULL 금지 CHECK · size >= 0
model EnglishMaterial {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  name      String   @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  size      Int
  /// 파일 원본 — 텍스트 자료는 NULL. 목록 조회는 이 칸을 읽지 않는다(`select`)
  bytes     Bytes?
  /// 문제 제작에 쓸 지문 글(≤30,000자) — 텍스트 자료, 또는 .txt 파일의 글. 그 밖 파일은 NULL
  content   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  exam EnglishExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, createdAt])
  @@map("english_material")
}

/// 대비 문제 세트 — 지문 하나 + 문항 배열(쓰기 때 계약 `englishQuestionSchema` 로 잠근다) + 검토 상태
model EnglishQuestionSet {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  title     String   @db.VarChar(160)
  /// 초안 · 검토 중 · 검토 완료 — 계약 `ENGLISH_SET_STATUSES`. **SQL 에만 있는 것**: CHECK status IN (...)
  status    String   @default("초안") @db.VarChar(8)
  /// chatgpt · cloze · deepseek · manual — 계약 `ENGLISH_SET_SOURCES`. **SQL 에만 있는 것**: CHECK source IN (...)
  source    String   @db.VarChar(16)
  passage   String   @db.Text
  /// 문항 배열 — **SQL 에만 있는 것**: CHECK jsonb_typeof(questions) = 'array'
  questions Json     @db.JsonB
  /// 만든 조건(제작 방식 · 난이도 · 문항 수 · 유형 · 모델 …) — 계약 `englishSetMetaSchema`. 없으면 NULL(옛 세트).
  /// **SQL 에만 있는 것**: CHECK meta IS NULL OR jsonb_typeof(meta) = 'object' (2026-10-01 원장님 «메타데이터 기억되게»)
  meta      Json?    @db.JsonB
  /// 낙관적 잠금 — 읽었을 때의 값을 PUT 이 들고 오고, 다르면 409 REVISION_MISMATCH. **SQL 에만 있는 것**: CHECK revision >= 1
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exam EnglishExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  passageUse EnglishPassageUse?

  @@index([examId, updatedAt])
  @@map("english_question_set")
}

/// Independent bank ownership root; archiving does not delete historical text or uses.
model EnglishPassage {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  title String @db.VarChar(160)
  grade String? @db.VarChar(4)
  source Json @db.JsonB
  text String @db.Text
  textLength Int @map("text_length")
  snapshotHash String @map("snapshot_hash") @db.VarChar(64)
  duplicateHash String @map("duplicate_hash") @db.VarChar(64)
  revision Int @default(1)
  textRevision Int @default(1) @map("text_revision")
  rights Json @db.JsonB
  importedFrom Json? @map("imported_from") @db.JsonB
  importFingerprint String? @map("import_fingerprint") @db.VarChar(64)
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  revisions EnglishPassageRevision[]
  receipts EnglishPassageReceipt[]
  @@unique([userId, importFingerprint])
  @@index([userId, archivedAt, createdAt, id])
  @@index([branchId, archivedAt, createdAt, id])
  @@index([userId, duplicateHash])
  @@map("english_passage")
}

/// Text-only immutable revision. Metadata edits increment the parent's CAS, not this number.
model EnglishPassageRevision {
  passageId String @map("passage_id") @db.Uuid
  textRevision Int @map("text_revision")
  text String @db.Text
  snapshotHash String @map("snapshot_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  passage EnglishPassage @relation(fields: [passageId], references: [id], onDelete: Restrict)
  uses EnglishPassageUse[]
  @@id([passageId, textRevision])
  @@map("english_passage_revision")
}

/// Server-read source and original text at creation; deleted only when its set is deleted.
model EnglishPassageUse {
  setId String @id @map("set_id") @db.Uuid
  passageId String @map("passage_id") @db.Uuid
  textRevision Int @map("text_revision")
  snapshotHash String @map("snapshot_hash") @db.VarChar(64)
  textSnapshot String @map("text_snapshot") @db.Text
  sourceSnapshot Json @map("source_snapshot") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  set EnglishQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  revision EnglishPassageRevision @relation(fields: [passageId, textRevision], references: [passageId, textRevision], onDelete: Restrict)
  @@index([passageId, createdAt])
  @@map("english_passage_use")
}

/// Multiple retry keys may resolve to the same explicitly imported original.
model EnglishPassageReceipt {
  userId String @map("user_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  passageId String @map("passage_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  passage EnglishPassage @relation(fields: [passageId], references: [id], onDelete: Restrict)
  @@id([userId, clientKey])
  @@index([passageId])
  @@map("english_passage_receipt")
}

// ─────────────────────────────────────────────
// 학원 전체 설정 — 키 하나에 값 하나(진도판 테마 등, 2026-09-30)
// ─────────────────────────────────────────────

/// 학원 전체에 한 벌인 설정. 지점 분리(D-136) 전이라 지점 칸이 없다 — 지점마다가 되면 branch_id 를 더한다.
model AppSetting {
  key         String   @id @db.VarChar(64)
  value       Json     @db.JsonB
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 마지막으로 바꾼 사람(관리자). 계정이 지워져도 설정은 남는다 — 외래 키를 걸지 않는다.
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("app_setting")
}

// ─────────────────────────────────────────────────────────────────────────────
// 교재 제작 — 전용 표 20개 (계획 60a508c0 · P1 계약 e94aedb8, docs/planning/textbook-studio-p1-contracts-20261003.md)
//
// 부류: **주인 계정의 개인 자료** — 책 · 판본 · 구획 · 배치 · 확정본 · 자산 · 영상은 전부 `userId` 의 것이다.
// 지점 관리자도 남의 초안을 넘겨다보지 않는다(`ownedRowsWhere` 를 쓰지 않는다). 지점 공유는 책 단위로 주인이 켜고,
// 동료는 **발행본만** 읽는다. 범위 조건은 `src/lib/textbook/access.ts` 한 곳에 있다.
// 🔴 `WorkspaceDocument/Asset` 에 얹지 않는다 · 문제은행 `Problem` 을 고치지 않는다(확정본은 사본이다).
// 계약: src/contracts/textbook*.contract.ts · 마이그레이션: prisma/migrations/20261003120000_textbook_studio
// (적용은 scripts/qa/apply-textbook-studio-migration.ts — `prisma migrate dev/deploy/db push` 금지).
//
// **SQL 에만 있는 것**(이 파일로는 안 보인다 — 마이그레이션이 정본이다):
//   · 발행 · 종료 판본과 그 자식(구획 · 배치 · 개념 · 자산 색인 · 산출물)을 못 고치게 하는 트리거
//   · 자식을 쓴 문장마다 `TextbookEdition.revision` 을 올리는 트리거 — **앱이 올리지 않는다**(두 번 오른다)
//   · 확정본 · 바이트 · QR 대상 · 보관본의 불변 트리거, 영상 연결 · 요청 · 조판 걸음의 상태 전이 트리거
//   · 같은 판본 · 같은 주인을 보장하는 **복합 FK** — 여기의 관계는 단일 칸으로만 적는다
//   · 부분 유일 색인: 책마다 초안 하나 · 판본마다 열린 발행 요청 하나 · 확정본마다 게시 영상 하나 · 배치/개념마다 QR 하나
//   · 값 목록 · JSON 모양 · 해시 글자 CHECK
// ─────────────────────────────────────────────────────────────────────────────

/// 책 — 1판과 2판이 공유하는 정체. 지면의 제목은 판본 `config` 에 고정되고, 여기의 `title` 은 목록용이다
model Textbook {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// elementary · middle · high
  schoolLevel    String    @map("school_level") @db.VarChar(12)
  grade          Int       @db.SmallInt
  semester       Int       @db.SmallInt
  volume         Int       @db.SmallInt
  volumeCount    Int       @map("volume_count") @db.SmallInt
  displayCode    String    @map("display_code") @db.VarChar(40)
  title          String    @db.VarChar(120)
  /// private · branch — `sharedBranchId` 와 짝이다(CHECK). 공유해도 동료가 읽는 것은 발행본뿐이다
  visibility     String    @default("private") @db.VarChar(20)
  sharedBranchId String?   @map("shared_branch_id") @db.Uuid
  /// 목록에서 감추기 — 책은 지우지 않는다(인쇄된 QR 이 남는다)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  editions TextbookEdition[]

  @@index([userId, updatedAt])
  @@index([sharedBranchId, visibility])
  @@map("textbook")
}

/// 판본 — 초안이거나 발행본이다. 발행 뒤에는 종료(`retired`) 말고 아무것도 못 바꾼다(트리거)
model TextbookEdition {
  id                   String    @id @default(uuid()) @db.Uuid
  textbookId           String    @map("textbook_id") @db.Uuid
  /// 책의 주인과 같다(복합 FK) — 자식이 «같은 주인»을 증명하는 데 쓴다
  userId               String    @map("user_id") @db.Uuid
  ordinal              Int
  label                String    @db.VarChar(40)
  /// draft · published · retired
  status               String    @default("draft") @db.VarChar(12)
  schemaVersion        String    @map("schema_version") @db.VarChar(40)
  c14nVersion          String    @map("c14n_version") @db.VarChar(40)
  /// 집계 revision — 판본 안의 모든 변경이 올린다(**DB 트리거가** 올린다). 발행 예약 · 확정이 견준다
  revision             Int       @default(1)
  /// 설정 · 목차 · 구획 목록의 CAS
  structureRevision    Int       @default(1) @map("structure_revision")
  /// TextbookConfig (계약 `textbookConfigSchema`)
  config               Json      @db.JsonB
  /// { units: [{ unitKey, title, sourceUnitIds, prerequisites, goals, conceptLectureRefs }] } — 단원의 차례와 머리말
  outline              Json      @db.JsonB
  rendererVersion      String    @map("renderer_version") @db.VarChar(80)
  templateVersion      String    @map("template_version") @db.VarChar(80)
  derivedFromEditionId String?   @map("derived_from_edition_id") @db.Uuid
  /// 발행 때 서버가 계산한다. 그 값을 낸 정본 교환 JSON 은 산출물 `exchange-json` 이다
  manifestHash         String?   @map("manifest_hash") @db.Char(64)
  publishedAt          DateTime? @map("published_at")
  retiredAt            DateTime? @map("retired_at")
  createdAt            DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  textbook    Textbook                @relation(fields: [textbookId], references: [id], onDelete: Restrict)
  sections    TextbookSection[]
  items       TextbookItem[]
  concepts    TextbookConcept[]
  assets      TextbookEditionAsset[]
  qrTargets   TextbookQrTarget[]
  artifacts   TextbookArtifact[]
  assignments TextbookAssignment[]
  requests    TextbookRequest[]

  @@unique([textbookId, ordinal])
  @@index([userId, status])
  @@map("textbook_edition")
}

/// 구획 — 원고 블록. 구획마다 CAS(`revision`). 열쇠는 (단원, 구획) 안에서만 유일해 API 는 `id` 로 부른다
model TextbookSection {
  id          String   @id @default(uuid()) @db.Uuid
  editionId   String   @map("edition_id") @db.Uuid
  unitKey     String   @map("unit_key") @db.VarChar(80)
  sectionKey  String   @map("section_key") @db.VarChar(80)
  /// 단원 안의 차례
  orderIndex  Int      @default(0) @map("order_index")
  title       String   @db.VarChar(120)
  templateKey String   @map("template_key") @db.VarChar(160)
  /// even-left · continue
  startPolicy String   @map("start_policy") @db.VarChar(12)
  /// { blocks: ManuscriptBlock[] } — 배치의 자리는 이 블록 순서 하나가 정한다
  content     Json     @db.JsonB
  revision    Int      @default(1)
  createdAt   DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  edition  TextbookEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  items    TextbookItem[]
  concepts TextbookConcept[]

  @@unique([editionId, unitKey, sectionKey])
  @@map("textbook_section")
}

/// 문항 확정본 — INSERT 뒤로 불변(트리거). 원문이 바뀌면 새 행을 만든다.
/// 🔴 내용을 읽을 때 살아 있는 `Problem` 을 섞지 않는다 — 본문 · 정답 · 해설 · 그림은 `payload` 에서만.
model TextbookProblemSnapshot {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// todays-math · legacy-studio · studio-authored
  sourceSystem    String    @map("source_system") @db.VarChar(16)
  /// 'tm:<problemId>' · 'legacy:<legacyId>' · 'studio:<localId>' — `sourceRef` 에서 나온다(CHECK)
  sourceKey       String    @map("source_key") @db.VarChar(200)
  /// 불변 정체(계약 `textbookSourceRefSchema`) — 문항 id · 저장 코드가 여기 고정된다
  sourceRef       Json      @map("source_ref") @db.JsonB
  /// 지금 은행 문항과 견줄 때만 쓴다. 원본이 지워지면 **이 칸만** 빈다 — FK(SET NULL)는 SQL 에 있다
  problemId       String?   @map("problem_id") @db.Uuid
  sourceUpdatedAt DateTime? @map("source_updated_at")
  capturedAt      DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("captured_at")
  unitId          String?   @map("unit_id") @db.Uuid
  familyKey       String?   @map("family_key") @db.Text
  difficulty      String?   @db.VarChar(40)
  problemType     String?   @map("problem_type") @db.VarChar(100)
  /// ProblemPayload — `contentHash` 의 대상
  payload         Json      @db.JsonB
  /// 원본 행의 그림 칸 넷을 글자 그대로 + 원본 SVG 자산 — 해시 밖의 증거. 길이가 안 맞는 배열도 고치지 않는다
  rawSource       Json      @map("raw_source") @db.JsonB
  /// 캡처 당시 unitId · 단원명 · 학년 · 난도 · 원본 배점
  sourceMetadata  Json      @map("source_metadata") @db.JsonB
  contentHash     String    @map("content_hash") @db.Char(64)
  /// sourceRef + sourceMetadata + rawSource + contentHash
  snapshotHash    String    @map("snapshot_hash") @db.Char(64)
  c14nVersion     String    @map("c14n_version") @db.VarChar(40)

  items         TextbookItem[]
  videoBindings TextbookVideoBinding[]
  testProblems  TestProblem[]

  @@unique([userId, sourceKey, snapshotHash])
  @@index([problemId])
  @@map("textbook_problem_snapshot")
}

/// 배치 — 판본 속 문항 한 자리. 같은 문항을 두 번 실으면 두 줄이다
model TextbookItem {
  id                  String   @id @default(uuid()) @db.Uuid
  editionId           String   @map("edition_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  snapshotId          String   @map("snapshot_id") @db.Uuid
  /// unlinked · candidate · linked · needs-review — `linked` 는 실제 은행 문항의 확정본만(트리거)
  linkStatus          String   @map("link_status") @db.VarChar(12)
  linkCandidates      Json     @default("[]") @map("link_candidates") @db.JsonB
  /// 출처 기록 — FK 를 걸지 않는다(시험지는 지워질 수 있다)
  sourceTestId        String?  @map("source_test_id") @db.Uuid
  sourceTestProblemId String?  @map("source_test_problem_id") @db.Uuid
  unitKey             String   @map("unit_key") @db.VarChar(80)
  /// NULL = 담아 두기만 했다
  sectionId           String?  @map("section_id") @db.Uuid
  learningStage       String   @map("learning_stage") @db.VarChar(20)
  orderIndex          Int      @default(0) @map("order_index")
  layout              Json     @db.JsonB
  /// 문항별 정책 덮어쓰기. NULL = 판본 정책을 따른다
  videoRequired       Boolean? @map("video_required")
  /// 검수된 개념 열쇠 — 이 판본의 `TextbookConcept.conceptKey`
  conceptKeys         Json     @default("[]") @map("concept_keys") @db.JsonB
  derivedFromItemId   String?  @map("derived_from_item_id") @db.Uuid
  /// 아래 넷은 발행 확정 때 **서버가** 채운다. 초안에서는 계산값이다
  displayNumber       String?  @map("display_number") @db.VarChar(40)
  physicalPageIndex   Int?     @map("physical_page_index")
  printedPageLabel    String?  @map("printed_page_label") @db.VarChar(40)
  pageColumn          Int?     @map("page_column") @db.SmallInt
  revision            Int      @default(1)
  createdAt           DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  edition   TextbookEdition         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  snapshot  TextbookProblemSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  section   TextbookSection?        @relation(fields: [sectionId], references: [id], onDelete: NoAction)
  qrTargets TextbookQrTarget[]

  @@index([editionId, sectionId, orderIndex])
  @@index([snapshotId])
  @@map("textbook_item")
}

/// 바이트 — 내용 해시가 열쇠. 넣을 때 DB 가 해시를 다시 계산하고(트리거), 넣은 뒤로는 못 고친다.
/// 🔴 `bytes` 를 목록 조회에서 읽지 않는다(`select`). 해시만으로 읽는 경로를 만들지 않는다 — 늘 주인 · 판본 범위를 지난다.
model TextbookBlob {
  sha256    String   @id @db.Char(64)
  size      Int
  bytes     Bytes
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  @@map("textbook_blob")
}

/// 올리는 파일 — 조각이 다 오면 DB 가 이어 붙여 `TextbookBlob` 에 넣고 조각을 지운다.
/// 끝난 줄(`completedAt`)은 남는다 — 가져오기 · 자산 등록이 `id` 로 그 바이트를 가리킨다
model TextbookUpload {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sha256      String    @db.Char(64)
  /// 끝맺을 때 정해진다
  size        Int?
  fileName    String?   @map("file_name") @db.VarChar(255)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  chunks TextbookUploadChunk[]

  @@unique([userId, sha256])
  @@map("textbook_upload")
}

/// 조각 하나(≤ 1MB) — 열쇠는 파일 안의 바이트 자리다. 끝맺을 때 빈틈 · 겹침 없이 이어지는지 본다
model TextbookUploadChunk {
  uploadId   String @map("upload_id") @db.Uuid
  byteOffset Int    @map("byte_offset")
  bytes      Bytes

  upload TextbookUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, byteOffset])
  @@map("textbook_upload_chunk")
}

/// 자산 — 주인이 가진 손잡이. `id` 는 내용 해시다(= `TextbookBlob.sha256`). 이름만 바꿀 수 있다(트리거)
model TextbookAsset {
  userId    String   @map("user_id") @db.Uuid
  id        String   @db.Char(64)
  /// figure · image · portrait · font
  kind      String   @db.VarChar(12)
  mimeType  String   @map("mime_type") @db.VarChar(40)
  name      String   @db.VarChar(255)
  /// 바이트에서 잰 값. 원본 행의 figureDims 는 확정본 `rawSource` 에 따로 있다
  widthPx   Int?     @map("width_px")
  heightPx  Int?     @map("height_px")
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  @@id([userId, id])
  @@map("textbook_asset")
}

/// 판본이 가리키는 자산 — 읽기 범위의 색인. 공유본을 여는 동료는 여기 있는 것만 읽는다
model TextbookEditionAsset {
  editionId String @map("edition_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  assetId   String @map("asset_id") @db.Char(64)

  edition TextbookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([editionId, assetId])
  @@index([userId, assetId])
  @@map("textbook_edition_asset")
}

/// 교재의 개념 — 판본 속 개념 하나. 발행본의 이 행이 곧 개념 확정본이다(`frozen`)
model TextbookConcept {
  editionId             String   @map("edition_id") @db.Uuid
  conceptKey            String   @map("concept_key") @db.VarChar(80)
  unitKey               String   @map("unit_key") @db.VarChar(80)
  /// 개념 블록이 놓인 구획. NULL = 아직 안 놓았다
  sectionId             String?  @map("section_id") @db.Uuid
  title                 String   @db.VarChar(120)
  /// CONCEPT_KINDS — **SQL 에만 있는 것**: CHECK kind IN (...). 가드 시험이 둘을 견준다
  kind                  String   @db.VarChar(8)
  /// 이 개념의 차시 — FK(RESTRICT)는 SQL 에 있다
  unitId                String?  @map("unit_id") @db.Uuid
  body                  Json     @db.JsonB
  /// 순서가 지면의 순서다
  blankItems            Json     @default("[]") @map("blank_items") @db.JsonB
  /// 백지로 낼 형식(recall · term · cloze · map · figure). NULL = 고르지 않았다 — 빈 배열로 채우지 않는다
  blankForms            Json?    @map("blank_forms") @db.JsonB
  links                 Json     @default("[]") @db.JsonB
  mappingVersion        String   @map("mapping_version") @db.VarChar(80)
  derivedFromConceptKey String?  @map("derived_from_concept_key") @db.VarChar(80)
  /// 발행 확정 때 서버가 채운다. 초안에서는 NULL
  frozen                Json?    @db.JsonB
  revision              Int      @default(1)
  createdAt             DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  edition  TextbookEdition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  section  TextbookSection?         @relation(fields: [sectionId], references: [id], onDelete: NoAction)
  attempts TextbookConceptAttempt[]

  @@id([editionId, conceptKey])
  @@index([unitId])
  @@map("textbook_concept")
}

/// QR 대상 — slug · 주소 · 대상은 영구다. 지우지 못한다(트리거). 서버만 짓는다
model TextbookQrTarget {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(100)
  url         String    @db.VarChar(300)
  /// item · concept
  kind        String    @db.VarChar(8)
  editionId   String    @map("edition_id") @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  conceptKey  String?   @map("concept_key") @db.VarChar(80)
  /// reserved → active | void. reserved 는 학생에게 안 보인다
  state       String    @default("reserved") @db.VarChar(10)
  /// 발행 뒤 바꿀 수 있는 유일한 칸
  suspendedAt DateTime? @map("suspended_at")
  createdAt   DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  activatedAt DateTime? @map("activated_at")

  edition TextbookEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  item    TextbookItem?   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("textbook_qr_target")
}

/// 문제 해설영상 — 공급자와 영상 id 는 안 바뀐다(트리거). 다른 영상은 새 행이다.
/// 주소를 통째로 받지 않는다 — 서버가 공급자와 id 로 짓는다
model TextbookVideo {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// youtube
  provider        String   @db.VarChar(12)
  providerVideoId String   @map("provider_video_id") @db.VarChar(20)
  title           String   @db.VarChar(120)
  createdAt       DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bindings TextbookVideoBinding[]

  @@unique([userId, provider, providerVideoId])
  @@map("textbook_video")
}

/// 확정본 ↔ 영상 연결 — draft → review → published → withdrawn.
/// 게시는 검수한 것만: `reviewedAgainstHash` 가 확정본의 `contentHash` 와 같아야 한다(트리거)
model TextbookVideoBinding {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  snapshotId          String    @map("snapshot_id") @db.Uuid
  videoId             String    @map("video_id") @db.Uuid
  status              String    @default("draft") @db.VarChar(10)
  startSeconds        Float     @default(0) @map("start_seconds")
  endSeconds          Float?    @map("end_seconds")
  reviewedAgainstHash String?   @map("reviewed_against_hash") @db.Char(64)
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at")
  publishedAt         DateTime? @map("published_at")
  withdrawnAt         DateTime? @map("withdrawn_at")
  createdAt           DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  snapshot TextbookProblemSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  video    TextbookVideo           @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@index([snapshotId])
  @@index([videoId])
  @@map("textbook_video_binding")
}

/// 배정 — 반 또는 학생 하나에, 판본 전체 · 구획들 · 배치들을. 발행본에만 건다(트리거). 회수는 `revokedAt`
model TextbookAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  editionId  String    @map("edition_id") @db.Uuid
  classId    String?   @map("class_id") @db.Uuid
  studentId  String?   @map("student_id") @db.Uuid
  /// edition · sections · items (계약 `textbookAssignmentScopeSchema`)
  scopeKind  String    @map("scope_kind") @db.VarChar(10)
  /// 구획 id 들 또는 배치 id 들. 판본 전체면 비어 있다 — 빈 범위가 «전체»로 읽히지 않게 CHECK 가 짝을 본다
  scopeIds   Json      @default("[]") @map("scope_ids") @db.JsonB
  opensAt    DateTime  @map("opens_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  assignedBy String?   @map("assigned_by") @db.Uuid
  createdAt  DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  edition TextbookEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  class   Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
  @@index([editionId])
  @@map("textbook_assignment")
}

/// 요청 기록 — 같은 `requestId` 는 한 번만 만든다. 같은 id 에 다른 본문(`bodyHash`)이면 409
model TextbookRequest {
  userId       String   @map("user_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  operation    String   @db.VarChar(32)
  editionId    String?  @map("edition_id") @db.Uuid
  /// open · done · abandoned
  state        String   @db.VarChar(10)
  baseRevision Int?     @map("base_revision")
  bodyHash     String   @map("body_hash") @db.Char(64)
  result       Json?    @db.JsonB
  createdAt    DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  edition TextbookEdition?      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  steps   TextbookPublishStep[]

  @@id([userId, requestId])
  @@index([editionId, operation])
  @@map("textbook_request")
}

/// 발행 조판 걸음 — 서버가 조판하고 결과를 적는다. 끝난 걸음은 안 바뀐다(트리거)
model TextbookPublishStep {
  userId         String    @map("user_id") @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  idx            Int
  /// render(구획 묶음 조판) · merge(조각을 합치고 QR 을 다시 읽는다) · spread(펼침면) · offline(단일 HTML)
  kind           String    @default("render") @db.VarChar(8)
  /// student · answers
  view           String    @db.VarChar(8)
  sectionIds     Json      @map("section_ids") @db.JsonB
  /// queued · running · done · failed
  state          String    @default("queued") @db.VarChar(8)
  attempts       Int       @default(0) @db.SmallInt
  leaseUntil     DateTime? @map("lease_until")
  leaseToken     String?   @map("lease_token") @db.Uuid
  firstPageIndex Int?      @map("first_page_index")
  pageCount      Int?      @map("page_count")
  /// 서버가 만든 PDF 조각의 해시(`TextbookBlob`)
  sha256         String?   @db.Char(64)
  /// 쪽 계획 · 배치 자리 · 진단(넘침 · 수식 오류 · 빠진 그림 · 읽힌 QR)
  result         Json?     @db.JsonB
  updatedAt      DateTime  @updatedAt @map("updated_at")

  request TextbookRequest @relation(fields: [userId, requestId], references: [userId, requestId], onDelete: Cascade)

  @@id([userId, requestId, idx])
  @@map("textbook_publish_step")
}

/// 발행 산출물 — 서버가 만든 PDF · 정본 교환 JSON · 검수 보고 · 매핑표. 판본마다 종류 하나
model TextbookArtifact {
  id        String   @id @default(uuid()) @db.Uuid
  editionId String   @map("edition_id") @db.Uuid
  /// 계약 `textbookArtifactSchema.kind` — **SQL 에만 있는 것**: CHECK kind IN (...). 가드 시험이 둘을 견준다
  kind      String   @db.VarChar(16)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sha256    String   @db.Char(64)
  byteSize  Int      @map("byte_size")
  pageCount Int?     @map("page_count")
  /// 조판 걸음의 조각 해시 · 쪽 범위 — 합친 파일이 어디서 왔는지의 기록
  parts     Json     @default("[]") @db.JsonB
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  edition TextbookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, kind])
  @@map("textbook_artifact")
}

/// 학생의 백지 활동 — 발행본의 굳은 개념 하나에 대한 한 번. 새 제출은 새 줄이고 낸 글은 덮어쓰지 못한다(트리거)
model TextbookConceptAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  editionId    String    @map("edition_id") @db.Uuid
  conceptKey   String    @map("concept_key") @db.VarChar(80)
  studentId    String    @map("student_id") @db.Uuid
  requestId    String    @map("request_id") @db.Uuid
  bodyHash     String    @map("body_hash") @db.Char(64)
  frozenHash   String    @map("frozen_hash") @db.Char(64)
  /// recall · term · cloze · map · figure
  form         String    @db.VarChar(8)
  /// student-text · teacher-observed
  channel      String    @db.VarChar(16)
  response     String    @db.Text
  /// 종이 활동을 본 교사 — `teacher-observed` 일 때만
  recordedBy   String?   @map("recorded_by") @db.Uuid
  submittedAt  DateTime  @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("submitted_at")
  /// pending · checked · needs-review
  reviewStatus String    @default("pending") @map("review_status") @db.VarChar(12)
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  note         String?   @db.VarChar(4000)
  revision     Int       @default(1)

  concept TextbookConcept @relation(fields: [editionId, conceptKey], references: [editionId, conceptKey], onDelete: Restrict)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, requestId])
  @@index([editionId, conceptKey, studentId, submittedAt], map: "textbook_concept_attempt_concept_student_idx")
  @@index([studentId, submittedAt])
  @@map("textbook_concept_attempt")
}

/// 보관본 — 가져온 패키지를 바이트 그대로 둔다. 원 ID 를 살아 있는 책 · 판본 · QR 표에 넣지 않는다
model TextbookArchive {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  sha256        String   @db.Char(64)
  byteSize      Int      @map("byte_size")
  fileName      String   @map("file_name") @db.VarChar(255)
  title         String   @db.VarChar(120)
  schemaVersion String   @map("schema_version") @db.VarChar(40)
  manifestHash  String?  @map("manifest_hash") @db.Char(64)
  /// 검증 보고와 패키지 요약(원 판본 정체 · 개수)
  report        Json     @db.JsonB
  createdAt     DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  @@unique([userId, sha256])
  @@index([userId, createdAt])
  @@map("textbook_archive")
}

/// Listening is an independent ownership root. Draft document revision differs from row CAS revision.
model EnglishListeningSet {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  revision Int @default(1)
  document Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  publications EnglishListeningPublication[]
  mediaAssets EnglishListeningMediaAsset[]
  @@index([ownerId, createdAt])
  @@map("english_listening_set")
}

/// Immutable signed content snapshot; withdrawal is separate from content.
model EnglishListeningPublication {
  id String @id @db.Uuid
  setId String @map("set_id") @db.Uuid
  sourceRevision Int @map("source_revision")
  snapshot Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  set EnglishListeningSet @relation(fields: [setId], references: [id], onDelete: Restrict)
  assignments EnglishListeningAssignment[]
  @@unique([setId, sourceRevision])
  @@map("english_listening_publication")
}

model EnglishListeningAssignment {
  id String @id @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  revision Int @default(1)
  snapshot Json @db.JsonB
  manualRelease Json? @map("manual_release") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")
  publication EnglishListeningPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  versions EnglishListeningAssignmentRevision[]
  targets EnglishListeningTarget[]
  attempts EnglishListeningAttempt[]
  releases EnglishListeningRelease[]
  broadcast EnglishListeningBroadcast?
  @@index([ownerId, createdAt])
  @@map("english_listening_assignment")
}

model EnglishListeningAssignmentRevision {
  assignmentId String @map("assignment_id") @db.Uuid
  revision Int
  snapshot Json @db.JsonB
  assignment EnglishListeningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@id([assignmentId, revision])
  @@map("english_listening_assignment_revision")
}

model EnglishListeningTarget {
  assignmentId String @map("assignment_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  assignment EnglishListeningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attempts EnglishListeningAttempt[]
  releases EnglishListeningRelease[]
  @@id([assignmentId, studentId])
  @@index([studentId])
  @@map("english_listening_target")
}

model EnglishListeningAttempt {
  id String @id @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  ordinal Int @default(1)
  revision Int
  snapshot Json @db.JsonB
  assignment EnglishListeningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  target EnglishListeningTarget @relation(fields: [assignmentId, studentId], references: [assignmentId, studentId], onDelete: Restrict)
  receipts EnglishListeningReceipt[]
  @@unique([assignmentId, studentId, ordinal])
  @@map("english_listening_attempt")
}

model EnglishListeningReceipt {
  attemptId String @map("attempt_id") @db.Uuid
  key String @db.VarChar(200)
  commandHash String @map("command_hash") @db.Char(64)
  acceptedRevision Int @map("accepted_revision")
  attempt EnglishListeningAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@id([attemptId, key])
  @@map("english_listening_receipt")
}

model EnglishListeningRelease {
  assignmentId String @map("assignment_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  releasedAt DateTime @map("released_at")
  reason String @db.VarChar(30)
  earlyExposure Boolean @map("early_exposure")
  assignment EnglishListeningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  target EnglishListeningTarget @relation(fields: [assignmentId, studentId], references: [assignmentId, studentId], onDelete: Restrict)
  @@id([assignmentId, studentId, groupId])
  @@map("english_listening_release")
}

model EnglishListeningBroadcast {
  id String @id @db.Uuid
  assignmentId String @unique @map("assignment_id") @db.Uuid
  snapshot Json @db.JsonB
  endedAt DateTime? @map("ended_at")
  interrupted Boolean @default(false)
  assignment EnglishListeningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@map("english_listening_broadcast")
}

model EnglishListeningAudit {
  id String @id @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  kind String @db.VarChar(50)
  payload Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  @@index([resourceId, createdAt])
  @@map("english_listening_audit")
}

model EnglishListeningMediaAsset {
  assetId String @id @db.Uuid
  ownerId String @db.Uuid
  branchId String? @db.Uuid
  setId String @db.Uuid
  revision Int
  state String @db.VarChar(30)
  uploadExpiresAt DateTime
  reservedBytes Int
  record Json @db.JsonB
  blobs EnglishListeningMediaBlob[]
  storageBlobs EnglishListeningMediaStorageBlob[]
  set EnglishListeningSet @relation(fields: [setId], references: [id], onDelete: Restrict)
  @@index([ownerId])
  @@index([state, uploadExpiresAt])
  @@map("english_listening_media_asset")
}

model EnglishListeningMediaBlob {
  key String @id @db.Uuid
  assetId String @db.Uuid
  bytes Bytes
  byteLength Int
  committed Boolean @default(false)
  createdAt DateTime @default(now())
  asset EnglishListeningMediaAsset @relation(fields: [assetId], references: [assetId], onDelete: Restrict)
  @@index([assetId])
  @@index([committed, createdAt])
  @@map("english_listening_media_blob")
}

model EnglishListeningMediaStorageBlob {
  key String @id @db.Uuid
  assetId String @db.Uuid
  byteLength Int
  sha256 String @db.Char(64)
  ref Json? @db.JsonB
  committed Boolean @default(false)
  deleting Boolean @default(false)
  createdAt DateTime @default(now())
  asset EnglishListeningMediaAsset @relation(fields: [assetId], references: [assetId], onDelete: Restrict)
  @@index([assetId])
  @@index([committed, createdAt], map: "english_listening_media_storage_blob_orphan_idx")
  @@map("english_listening_media_storage_blob")
}

model EywaBinding {
  id                         String               @id @db.Uuid
  tenantId                   String               @unique @map("tenant_id") @db.Uuid
  targetBranchId             String               @unique @map("target_branch_id") @db.Uuid
  autoProvisionedBranch      Boolean              @default(false) @map("auto_provisioned_branch")
  archiveOwnerUserId         String?              @map("archive_owner_user_id") @db.Uuid
  sourceEpoch                String?              @map("source_epoch") @db.Uuid
  mode                       String               @default("shadow") @db.VarChar(10)
  enabled                    Boolean              @default(false)
  healthy                    Boolean              @default(false)
  securityRevision           BigInt               @default(0) @map("security_revision")
  tenantRevocationGeneration BigInt               @default(0) @map("tenant_revocation_generation")
  contentGeneration          BigInt               @default(0) @map("content_generation")
  validatedAt                DateTime?            @map("validated_at")
  leaseExpiresAt             DateTime?            @map("lease_expires_at")
  nextEffectiveAt            DateTime?            @map("next_effective_at")
  control                    Json                 @default("{}")
  retiredAt                  DateTime?            @map("retired_at")
  leaseToken                 String?              @map("lease_token") @db.Uuid
  leaseUntil                 DateTime?            @map("lease_until")
  lastError                  String?              @map("last_error") @db.VarChar(100)
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  accounts                   EywaManagedAccount[]
  inbox                      EywaInbox[]

  @@map("eywa_binding")
}

// Ended and candidate rows retain history but do not occupy a current identity.
model EywaManagedAccount {
  id                          String      @id @default(uuid()) @db.Uuid
  bindingId                   String      @map("binding_id") @db.Uuid
  sourceUserId                String      @map("source_user_id") @db.Uuid
  userId                      String?     @map("user_id") @db.Uuid
  currentUserId               String?     @unique @map("current_user_id") @db.Uuid
  currentSourceUserId         String?     @unique @map("current_source_user_id") @db.Uuid
  status                      String      @default("candidate") @db.VarChar(20)
  sourceEmail                 String      @map("source_email") @db.VarChar(255)
  sourceName                  String      @map("source_name") @db.VarChar(200)
  candidateVersion            String?     @map("candidate_version") @db.VarChar(64)
  conflictReason              String?     @map("conflict_reason") @db.VarChar(100)
  blockReasons                String[]    @default([]) @map("block_reasons")
  // Explicit local account type, selected by a superadmin; source branch stays immutable.
  branchRoleOverride          BranchRole? @map("branch_role_override")
  sourceClasses               Json        @default("[]") @map("source_classes")
  sourceEpoch                 String?     @map("source_epoch") @db.Uuid
  securityRevision            BigInt      @default(0) @map("security_revision")
  accountRevocationGeneration BigInt      @default(0) @map("account_revocation_generation")
  tenantRevocationGeneration  BigInt      @default(0) @map("tenant_revocation_generation")
  classListRevision           BigInt      @default(0) @map("class_list_revision")
  leaseExpiresAt              DateTime?   @map("lease_expires_at")
  confirmedAt                 DateTime?   @map("confirmed_at")
  confirmedBy                 String?     @map("confirmed_by") @db.Uuid
  confirmationMethod          String?     @map("confirmation_method") @db.VarChar(30)
  confirmationEvidence        String?     @map("confirmation_evidence") @db.VarChar(1000)
  endedAt                     DateTime?   @map("ended_at")
  createdAt                   DateTime    @default(now()) @map("created_at")
  updatedAt                   DateTime    @updatedAt @map("updated_at")
  binding                     EywaBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  user                        User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bindingId, sourceUserId, status])
  @@map("eywa_managed_account")
}

model EywaInbox {
  eventId    String      @id @map("event_id") @db.Uuid
  bindingId  String      @map("binding_id") @db.Uuid
  bodyHash   String      @map("body_hash") @db.VarChar(64)
  payload    Json
  status     String      @default("received") @db.VarChar(20)
  attempts   Int         @default(0)
  retryAt    DateTime    @default(now()) @map("retry_at")
  leaseToken String?     @map("lease_token") @db.Uuid
  leaseUntil DateTime?   @map("lease_until")
  errorCode  String?     @map("error_code") @db.VarChar(100)
  receivedAt DateTime    @default(now()) @map("received_at")
  appliedAt  DateTime?   @map("applied_at")
  binding    EywaBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@index([bindingId, status, retryAt])
  @@map("eywa_inbox")
}

model EywaNonce {
  bindingId String   @map("binding_id") @db.Uuid
  nonce     String   @db.Uuid
  expiresAt DateTime @map("expires_at")

  @@id([bindingId, nonce])
  @@index([expiresAt])
  @@map("eywa_nonce")
}

model EywaSsoUse {
  jti          String   @id @db.Uuid
  bindingId    String   @map("binding_id") @db.Uuid
  sourceUserId String   @map("source_user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  consumedAt   DateTime @default(now()) @map("consumed_at")

  @@index([expiresAt])
  @@map("eywa_sso_use")
}

// Browser handshake stores only hashes. Assertion stays in a server-only handoff.
model EywaSsoHandoff {
  id           String    @id @db.VarChar(64)
  bindingId    String    @map("binding_id") @db.Uuid
  stateHash    String    @map("state_hash") @db.VarChar(64)
  verifierHash String    @map("verifier_hash") @db.VarChar(64)
  assertion    String?
  keyId        String?   @map("key_id") @db.VarChar(100)
  sourceUserId String?   @map("source_user_id") @db.Uuid
  sourceName   String?   @map("source_name") @db.VarChar(200)
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("eywa_sso_handoff")
}

model ClassMembership {
  id           String    @id @default(uuid()) @db.Uuid
  bindingId    String    @map("binding_id") @db.Uuid
  sourceId     String    @map("source_id") @db.VarChar(300)
  classId      String    @map("class_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sourceUserId String    @map("source_user_id") @db.Uuid
  role         String    @db.VarChar(20)
  startsOn     DateTime? @map("starts_on") @db.Date
  endsOn       DateTime? @map("ends_on") @db.Date
  revokedAt    DateTime? @map("revoked_at")
  capabilities String[]  @default([])
  class        Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bindingId, sourceId])
  @@index([userId, classId])
  @@map("class_membership")
}

model StudentEnrollment {
  id             String    @id @default(uuid()) @db.Uuid
  bindingId      String    @map("binding_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  classId        String    @map("class_id") @db.Uuid
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  onHold         Boolean   @default(false) @map("on_hold")
  isTransferred  Boolean   @default(false) @map("is_transferred")
  attendanceDays String[]  @default([]) @map("attendance_days")
  eywaLastReportDate DateTime? @db.Date @map("eywa_last_report_date")
  eywaLastReportText String? @db.Text @map("eywa_last_report_text")
  endedAt        DateTime? @map("ended_at")
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class          Class     @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([bindingId, sourceId])
  @@index([studentId, classId])
  @@map("student_enrollment")
}
